From a5bbe7ff0e99e8129b2c3f980138442611452ae2 Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Tue, 20 Oct 2026 21:48:25 +0800
Subject: [PATCH 21/51] Fix vertical subtitle position being anchored to the
 view, not the video area

The bottom anchor was computed as videoHeight - offset from the top of
the view, implicitly assuming the video area starts at y = 0. When the
view is taller than the video area (portrait playback with letterbox
bars) the video area is vertically centered, so the anchor sat far
above the real bottom of the video: the subtitles floated mid-high no
matter how the position slider was set. The editor preview looked fine
because its video area fills its whole view, which is why the setting
seemed to work only there.

- Anchor the bottom to the centered video area (videoTop offset)
- Clamp oversized stacked blocks to the video top edge instead of the
  view top, so they stay out of the letterbox bars
---
 .../newpipe/bisub/BisubSubtitleView.java      | 22 ++++++++++++-------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java b/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java
index 264735139..610796822 100644
--- a/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java
+++ b/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java
@@ -157,6 +157,12 @@ public final class BisubSubtitleView extends View {
         // playback — and to the style editor preview.
         final float videoHeight = videoAspectRatio > 0f
                 ? Math.min(height, width / videoAspectRatio) : height;
+        // The video area is centered inside the view when it is letterboxed
+        // (portrait playback of a landscape video), so its top edge sits
+        // below the view top. Anchoring the subtitles without this offset
+        // would pin them to the bottom of an imaginary top-aligned video
+        // area, which sits far above the real one in portrait.
+        final float videoTop = (height - videoHeight) / 2f;
 
         final float baseScale =
                 Math.max(0.4f, Math.min(3.0f, style.baseScale));
@@ -191,10 +197,10 @@ public final class BisubSubtitleView extends View {
 
         textPaint.setTypeface(Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD));
 
-        // The bottom anchor sits at the bottom of the video area too, so
-        // portrait playback keeps the subtitles inside the letterboxed
-        // video instead of touching the physical screen edge.
-        float bottom = videoHeight - videoHeight
+        // The bottom anchor sits at the bottom of the (centered) video area
+        // too, so portrait playback keeps the subtitles inside the
+        // letterboxed video instead of touching the physical screen edge.
+        float bottom = videoTop + videoHeight - videoHeight
                 * Math.max(0f, Math.min(0.3f, style.positionPercent));
         for (final Cue cue : cues) {
             final CharSequence cueText = cue == null ? null : cue.text;
@@ -243,11 +249,11 @@ public final class BisubSubtitleView extends View {
             final float blockWidth = contentWidth + 2 * padXPx;
             final float center = width / 2f;
             final float left = center - blockWidth / 2f;
-            // Keep oversized blocks (large scales) on screen instead of
-            // letting them start above the top of the view.
+            // Keep oversized blocks (large scales) below the top edge of
+            // the video area instead of letting them start above it.
             float top = bottom - blockHeight;
-            if (top < 0) {
-                top = 0;
+            if (top < videoTop) {
+                top = videoTop;
             }
             final float blockBottom = top + blockHeight;
 
