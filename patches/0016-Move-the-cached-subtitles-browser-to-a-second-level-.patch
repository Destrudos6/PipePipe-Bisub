+/**
+ * Second-level settings page listing the cached bilingual subtitles.
+ *
+ * <p>Each entry shows the video thumbnail (resolved from the recorded
+ * video id), the video title and the details of the translation. Tapping
+ * an entry opens the full text in a scrollable viewer with actions to
+ * export the file anywhere on the device (system save dialog) or to
+ * delete the cache entry.</p>
+ */
+public final class BisubCacheFragment extends Fragment {
+
+    private RecyclerView recyclerView;
+    private TextView emptyView;
+    private final BisubCacheAdapter adapter = new BisubCacheAdapter();
+
+    /** Entry whose content the next picked export target receives. */
+    @Nullable
+    private BisubManager.CachedSubtitle pendingExport;
+
+    private final ActivityResultLauncher<Intent> exportLauncher =
+            registerForActivityResult(
+                    new ActivityResultContracts.StartActivityForResult(),
+                    this::onExportTargetPicked);
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull final LayoutInflater inflater,
+                             @Nullable final ViewGroup container,
+                             @Nullable final Bundle savedInstanceState) {
+        final View root =
+                inflater.inflate(R.layout.fragment_bisub_cache, container, false);
+        recyclerView = root.findViewById(R.id.bisub_cache_list);
+        emptyView = root.findViewById(R.id.bisub_cache_empty);
+        recyclerView.setLayoutManager(new LinearLayoutManager(requireContext()));
+        recyclerView.setAdapter(adapter);
+        return root;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        ThemeHelper.setTitleToAppCompatActivity(getActivity(),
+                getString(R.string.bisub_cached_list_title));
+        reload();
+    }
+
+    /**
+     * Loads the cache entries on a background thread (older entries have
+     * their cue count scanned from the file itself) and swaps them into
+     * the list on the UI thread.
+     */
+    private void reload() {
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        new Thread(() -> {
+            final List<BisubManager.CachedSubtitle> entries =
+                    BisubManager.getInstance(context).listCachedSubtitles();
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                adapter.setEntries(entries);
+                final boolean empty = entries.isEmpty();
+                emptyView.setVisibility(empty ? View.VISIBLE : View.GONE);
+                recyclerView.setVisibility(empty ? View.GONE : View.VISIBLE);
+            });
+        }).start();
+    }
+
+    /**
+     * Reads one cached subtitle file on a background thread and opens the
+     * viewer with its full text.
+     *
+     * @param context a context to build the dialog with
+     * @param entry   the cache entry to open
+     */
+    private void openCachedSubtitle(@NonNull final Context context,
+                                    @NonNull final BisubManager.CachedSubtitle entry) {
+        new Thread(() -> {
+            final String content =
+                    BisubManager.getInstance(context).readCachedSubtitle(entry);
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                showCachedViewerDialog(context, entry, content);
+            });
+        }).start();
+    }
+
+    /**
+     * Shows the full text of a cached bilingual subtitle file in a
+     * scrollable, text-selectable viewer, with buttons to export the file
+     * anywhere on the device and to delete the cache entry.
+     *
+     * @param context a context to build the dialog with
+     * @param entry   the cache entry being viewed
+     * @param content the file content, or {@code null} when reading failed
+     */
+    private void showCachedViewerDialog(@NonNull final Context context,
+                                        @NonNull final BisubManager.CachedSubtitle entry,
+                                        @Nullable final String content) {
+        final TextView text = new TextView(context);
+        text.setText(content == null
+                ? getString(R.string.bisub_cached_read_failed) : content);
+        text.setTextIsSelectable(true);
+        text.setTypeface(Typeface.MONOSPACE);
+        text.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        final int padding = Math.round(16f
+                * context.getResources().getDisplayMetrics().density);
+        text.setPadding(padding, padding, padding, padding);
+        final ScrollView scroll = new ScrollView(context);
+        scroll.addView(text);
+        new AlertDialog.Builder(context)
+                .setTitle(entry.title == null
+                        ? getString(R.string.bisub_cached_list_title) : entry.title)
+                .setView(scroll)
+                .setPositiveButton(R.string.bisub_cached_download,
+                        (final DialogInterface dialog, final int which) ->
+                                exportCachedSubtitle(entry))
+                .setNeutralButton(R.string.bisub_cached_delete,
+                        (final DialogInterface dialog, final int which) ->
+                                confirmDeleteCached(context, entry))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /**
+     * Lets the user pick where the subtitle file is saved through the
+     * system save-as dialog, then copies the cached file there.
+     *
+     * @param entry the cache entry to export
+     */
+    private void exportCachedSubtitle(
+            @NonNull final BisubManager.CachedSubtitle entry) {
+        final Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("text/vtt");
+        intent.putExtra(Intent.EXTRA_TITLE, exportFileName(entry));
+        try {
+            pendingExport = entry;
+            exportLauncher.launch(intent);
+        } catch (final ActivityNotFoundException e) {
+            pendingExport = null;
+            Toast.makeText(getContext(), R.string.bisub_cached_download_failed,
+                    Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    /**
+     * Builds the proposed file name of an export: the video title stripped
+     * of characters no file system accepts, falling back to the video id
+     * and finally the cache file name.
+     *
+     * @param entry the entry being exported
+     * @return a file name ending in {@code .vtt}
+     */
+    @NonNull
+    private static String exportFileName(
+            @NonNull final BisubManager.CachedSubtitle entry) {
+        String base = null;
+        if (entry.title != null) {
+            base = entry.title
+                    .replaceAll("[\\\\/:*?\"<>|]", "_").trim();
+            if (base.length() > 60) {
+                base = base.substring(0, 60);
+            }
+        }
+        if (base == null || base.isEmpty()) {
+            base = entry.videoId;
+        }
+        if (base == null || base.isEmpty()) {
+            base = entry.file.getName().replaceAll("\\.vtt$", "");
+        }
+        return base + ".vtt";
+    }
+
+    /**
+     * Receives the save-as target picked for the pending export and copies
+     * the cached subtitle content into it on a background thread.
+     *
+     * @param result the picker result
+     */
+    private void onExportTargetPicked(@NonNull final ActivityResult result) {
+        final Uri target = result.getData() == null ? null : result.getData().getData();
+        final BisubManager.CachedSubtitle entry = pendingExport;
+        pendingExport = null;
+        if (result.getResultCode() != Activity.RESULT_OK || target == null
+                || entry == null) {
+            return;
+        }
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        new Thread(() -> {
+            final String content =
+                    BisubManager.getInstance(context).readCachedSubtitle(entry);
+            boolean written = false;
+            if (content != null) {
+                try (OutputStream out =
+                             context.getContentResolver().openOutputStream(target)) {
+                    if (out != null) {
+                        out.write(content.getBytes(StandardCharsets.UTF_8));
+                        written = true;
+                    }
+                } catch (final IOException e) {
+                    written = false;
+                }
+            }
+            final boolean ok = written;
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                Toast.makeText(getContext(), ok
+                        ? R.string.bisub_cached_downloaded
+                        : R.string.bisub_cached_download_failed,
+                        Toast.LENGTH_SHORT).show();
+            });
+        }).start();
+    }
+
+    /**
+     * Asks for confirmation before a cached subtitle file is deleted.
+     *
+     * @param context a context to build the dialog with
+     * @param entry   the cache entry to delete
+     */
+    private void confirmDeleteCached(@NonNull final Context context,
+                                     @NonNull final BisubManager.CachedSubtitle entry) {
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_cached_delete_title)
+                .setMessage(R.string.bisub_cached_delete_message)
+                .setPositiveButton(R.string.bisub_cached_delete,
+                        (final DialogInterface dialog, final int which) ->
+                                deleteCachedSubtitle(context, entry))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /**
+     * Deletes a cache entry on a background thread, reports the result in
+     * a toast and reloads the list.
+     *
+     * @param context a context for the manager and the toast
+     * @param entry   the cache entry to delete
+     */
+    private void deleteCachedSubtitle(@NonNull final Context context,
+                                      @NonNull final BisubManager.CachedSubtitle entry) {
+        new Thread(() -> {
+            final boolean deleted =
+                    BisubManager.getInstance(context).deleteCachedSubtitle(entry);
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                Toast.makeText(context, deleted ? R.string.bisub_cached_deleted
+                        : R.string.bisub_cached_delete_failed, Toast.LENGTH_SHORT).show();
+                reload();
+            });
+        }).start();
+    }
+
+    /**
+     * Maps a provider preset value onto its display name.
+     *
+     * @param provider the provider preset value
+     * @return the localized display name, or the raw value when unknown
+     */
+    @NonNull
+    private String providerDisplayName(@Nullable final String provider) {
+        if ("google".equals(provider)) {
+            return getString(R.string.bisub_provider_google);
+        }
+        if ("microsoft".equals(provider)) {
+            return getString(R.string.bisub_provider_microsoft);
+        }
+        if ("deepl".equals(provider)) {
+            return getString(R.string.bisub_provider_deepl);
+        }
+        if ("libre".equals(provider)) {
+            return getString(R.string.bisub_provider_libre);
+        }
+        return provider == null ? "" : provider;
+    }
+
+    private final class BisubCacheAdapter
+            extends RecyclerView.Adapter<BisubCacheHolder> {
+        private final List<BisubManager.CachedSubtitle> entries = new ArrayList<>();
+
+        void setEntries(@NonNull final List<BisubManager.CachedSubtitle> newEntries) {
+            entries.clear();
+            entries.addAll(newEntries);
+            notifyDataSetChanged();
+        }
+
+        @NonNull
+        @Override
+        public BisubCacheHolder onCreateViewHolder(@NonNull final ViewGroup parent,
+                                                   final int viewType) {
+            return new BisubCacheHolder(LayoutInflater.from(parent.getContext())
+                    .inflate(R.layout.item_bisub_cache, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull final BisubCacheHolder holder,
+                                     final int position) {
+            holder.bind(entries.get(position));
+        }
+
+        @Override
+        public int getItemCount() {
+            return entries.size();
+        }
+    }
+
+    private final class BisubCacheHolder extends RecyclerView.ViewHolder {
+        private final ImageView thumbnailView;
+        private final TextView titleView;
+        private final TextView detailsView;
+
+        BisubCacheHolder(@NonNull final View itemView) {
+            super(itemView);
+            thumbnailView = itemView.findViewById(R.id.bisub_cache_thumbnail);
+            titleView = itemView.findViewById(R.id.bisub_cache_title);
+            detailsView = itemView.findViewById(R.id.bisub_cache_details);
+        }
+
+        /**
+         * Fills one row: thumbnail, video title and the detail line with
+         * language, engine or model, line count and date. Tapping the row
+         * opens the full subtitle text.
+         *
+         * @param entry the cache entry to show
+         */
+        void bind(@NonNull final BisubManager.CachedSubtitle entry) {
+            titleView.setText(entry.title == null
+                    ? entry.file.getName() : entry.title);
+            final List<String> details = new ArrayList<>();
+            if (entry.targetLanguage != null && !entry.targetLanguage.isEmpty()) {
+                details.add(entry.targetLanguage);
+            }
+            if (entry.model != null && !entry.model.isEmpty()) {
+                details.add(entry.model);
+            } else if (entry.provider != null && !entry.provider.isEmpty()) {
+                details.add(providerDisplayName(entry.provider));
+            }
+            details.add(getString(R.string.bisub_cached_lines_count, entry.cueCount));
+            details.add(new SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.getDefault())
+                    .format(new Date(entry.timestamp)));
+            detailsView.setText(TextUtils.join(" · ", details));
+            loadThumbnail(entry.videoId);
+            itemView.setOnClickListener(view ->
+                    openCachedSubtitle(view.getContext(), entry));
+        }
+
+        /**
+         * Loads the YouTube still of the recorded video id into the
+         * thumbnail; ids of other services or unknown videos simply keep
+         * the placeholder image.
+         *
+         * @param videoId the recorded video id, or {@code null}
+         */
+        private void loadThumbnail(@Nullable final String videoId) {
+            if (videoId != null && videoId.matches("[A-Za-z0-9_-]{11}")) {
+                PicassoHelper.loadThumbnail(
+                        "https://i.ytimg.com/vi/" + videoId + "/mqdefault.jpg")
+                        .resize(192, 108)
+                        .centerCrop()
+                        .into(thumbnailView);
+            } else {
+                thumbnailView.setImageResource(R.drawable.dummy_thumbnail);
+            }
+        }
+    }
+}
