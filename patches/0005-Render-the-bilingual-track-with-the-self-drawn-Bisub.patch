From: Destrudos6 <3411622425@qq.com>
Date: Tue, 20 Oct 2026 09:37:50 +0800
Subject: [PATCH 05/12] Render the bilingual track with the self-drawn
 BisubSubtitleView in the player

- player.xml: add BisubSubtitleView layered above the exo SubtitleView
- PlayerLayoutController: feed cues to both views in onCues/reapplyCues
- PlayerTracksController: applyBisubStyleIfSelected swaps the rendering
  view based on the selected text track language (case-insensitive,
  using the callback's Tracks snapshot), hiding the exo view while the
  bilingual track is active; setupSubtitleView split into a plain
  style pass to avoid re-entering the selection logic
---
 .../newpipe/player/PlayerLayoutController.kt  |  8 +-
 .../newpipe/player/PlayerTracksController.kt  | 96 +++++++++++++++++++
 app/src/main/res/layout/player.xml            |  7 ++
 3 files changed, 110 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/org/schabi/newpipe/player/PlayerLayoutController.kt b/app/src/main/java/org/schabi/newpipe/player/PlayerLayoutController.kt
index 66b1276de..8a8b2115f 100644
--- a/app/src/main/java/org/schabi/newpipe/player/PlayerLayoutController.kt
+++ b/app/src/main/java/org/schabi/newpipe/player/PlayerLayoutController.kt
@@ -346,6 +346,9 @@ class PlayerLayoutController(private val player: Player) {
     fun onCues(cueGroup: CueGroup) {
         lastCueGroup = cueGroup
         player.binding.subtitleView.setCues(cueGroup.cues)
+        // BISUB-BEGIN: feed the self-drawn bilingual subtitle view as well
+        player.binding.bisubSubtitleView.setCues(cueGroup.cues)
+        // BISUB-END
     }
 
     /**
@@ -358,6 +361,9 @@ class PlayerLayoutController(private val player: Player) {
      * (#2944).
      */
     fun reapplyCues() {
-        lastCueGroup?.let { player.binding.subtitleView.setCues(it.cues) }
+        lastCueGroup?.let {
+            player.binding.subtitleView.setCues(it.cues)
+            player.binding.bisubSubtitleView.setCues(it.cues)
+        }
     }
 }
