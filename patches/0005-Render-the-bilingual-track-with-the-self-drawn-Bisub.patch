@@ -86,6 +108,76 @@ class PlayerTracksController(private val player: Player) {
             if (availableLanguages.isEmpty()) View.GONE else View.VISIBLE
     }
 
+    // BISUB-BEGIN
+    /**
+     * While the bilingual track is selected, it is rendered by the self-drawn
+     * [org.schabi.newpipe.bisub.BisubSubtitleView] instead of the regular subtitle view, so
+     * the appearance is fully controlled by the in-app bisub style (which also works on
+     * systems without Android caption settings, e.g. HarmonyOS). Any other text track keeps
+     * the regular Android system caption style.
+     *
+     * The decision is based on the [Tracks] snapshot handed to [onTextTracksChanged] (the
+     * very same source the upstream caption button uses), not on a second lookup through
+     * `getExoPlayer().getCurrentTracks()`, which may return a different snapshot at
+     * callback time.
+     *
+     * @param currentTracks the tracks snapshot from the callback, or `null` when no
+     * snapshot is available yet
+     */
+    private fun applyBisubStyleIfSelected(currentTracks: Tracks?) {
+        val binding = player.binding ?: return
+        val context = player.getContext()
+        val selected = getSelectedTextTrackLanguage(currentTracks)
+        // ExoPlayer normalizes track language tags to lower case, so the comparison must
+        // be case-insensitive (log evidence: selected="bilingual（双语）" vs
+        // expected="Bilingual（双语）").
+        val bilingualSelected =
+            BisubManager.bilingualTrackLanguage().equals(selected, ignoreCase = true)
+
+        val diag = StringBuilder("bisub style: bilingualSelected=")
+            .append(bilingualSelected)
+            .append(", selected=")
+            .append(selected)
+            .append(", expected=")
+            .append(BisubManager.bilingualTrackLanguage())
+        currentTracks?.groups?.forEach { group ->
+            if (group.type == C.TRACK_TYPE_TEXT && group.mediaTrackGroup.length > 0) {
+                diag.append(" [lang=")
+                    .append(group.mediaTrackGroup.getFormat(0).language)
+                    .append(",selected=")
+                    .append(group.isSelected)
+                    .append(']')
+            }
+        }
+        Log.i(TAG, diag.toString())
+
+        if (bilingualSelected) {
+            binding.subtitleView.visibility = View.GONE
+            binding.bisubSubtitleView.setBisubStyle(BisubPrefs.loadStyle(context))
+            binding.bisubSubtitleView.visibility = View.VISIBLE
+        } else {
+            binding.bisubSubtitleView.visibility = View.GONE
+            binding.subtitleView.visibility = View.VISIBLE
+            setupSubtitleViewStyle()
+        }
+    }
+
+    private fun getSelectedTextTrackLanguage(tracks: Tracks?): String? {
+        if (tracks == null) {
+            return null
+        }
+        for (group in tracks.groups) {
+            if (group.type == C.TRACK_TYPE_TEXT && group.isSelected
+                && group.mediaTrackGroup.length > 0
+            ) {
+                return group.mediaTrackGroup.getFormat(0).language
+            }
+        }
+        return null
+    }
+
+    // BISUB-END
+
     fun onAudioTracksChanged() {
         val binding = player.binding ?: return
 
@@ -165,4 +257,8 @@ class PlayerTracksController(private val player: Player) {
 
             return Player.RENDERER_UNAVAILABLE
         }
+
+    companion object {
+        private const val TAG = "PlayerTracksController"
+    }
 }
