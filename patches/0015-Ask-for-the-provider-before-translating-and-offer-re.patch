@@ -273,7 +273,21 @@ public final class BisubManager {
      */
     @Nullable
     private CacheTarget resolveCacheTarget(@NonNull final StreamInfo info) {
-        final BisubPrefs.Config cfg = BisubPrefs.load(appContext);
+        return resolveCacheTarget(info, BisubPrefs.load(appContext));
+    }
+
+    /**
+     * Same as {@link #resolveCacheTarget(StreamInfo)} but with an explicit
+     * configuration, so the cache of a video can be checked or started for
+     * a profile that is not the active one.
+     *
+     * @param info the stream info of the video
+     * @param cfg  the configuration to resolve with
+     * @return the target, or {@code null} when unusable or subtitle-less
+     */
+    @Nullable
+    private CacheTarget resolveCacheTarget(@NonNull final StreamInfo info,
+                                           @NonNull final BisubPrefs.Config cfg) {
         if (!cfg.isUsable()) {
             Log.i(TAG, "Bisub is disabled or the configuration is incomplete, skipping");
             BisubLog.i("Cache target: unusable configuration (enabled=" + cfg.enabled
@@ -401,6 +415,66 @@ public final class BisubManager {
         }));
     }
 
+    /**
+     * Checks whether a video already has a completed bilingual subtitle
+     * that the given profile would produce, without starting anything.
+     * Only touches in-memory data and file existence checks, so it is safe
+     * on the main thread.
+     *
+     * @param info    the stream info of the video
+     * @param profile the profile whose cache to check, or {@code null}
+     *                for the empty (never usable) configuration
+     * @return whether the completed file for that profile is on disk
+     */
+    public boolean isTranslationCached(@NonNull final StreamInfo info,
+                                       @Nullable final BisubPrefs.ProviderProfile profile) {
+        final CacheTarget target = resolveCacheTarget(info,
+                BisubPrefs.configOf(appContext, profile));
+        return target != null && isDone(target);
+    }
+
+    /**
+     * Deletes the completed bilingual subtitle that the given profile
+     * produced for a video (subtitle file, done marker and metadata
+     * sidecar), so the video can be translated again.
+     *
+     * @param info    the stream info of the video
+     * @param profile the profile whose cache to delete
+     * @return whether the subtitle file is gone
+     */
+    public boolean deleteTranslationCache(@NonNull final StreamInfo info,
+                                          @Nullable final BisubPrefs.ProviderProfile profile) {
+        final CacheTarget target = resolveCacheTarget(info,
+                BisubPrefs.configOf(appContext, profile));
+        if (target == null) {
+            return false;
+        }
+        BisubLog.i("Cache: deleting the bilingual subtitle of video "
+                + target.videoId + " for profile '" + profile.name
+                + "' to re-translate it");
+        sibling(target.cacheFile, ".done").delete();
+        sibling(target.cacheFile, ".meta").delete();
+        return target.cacheFile.delete() || !target.cacheFile.exists();
+    }
+
+    /**
+     * Makes the given profile the active one and starts (or joins) the
+     * background translation of a video with it. Activating the profile
+     * keeps everything consistent: the player resolves the bilingual track
+     * through the active configuration, so the freshly cached file is the
+     * one playback will find.
+     *
+     * @param info     the stream info of the video to translate
+     * @param listener the listener receiving progress and the final result
+     * @param profile  the profile to translate with and to activate
+     */
+    public void startTranslationWithProfile(@NonNull final StreamInfo info,
+                                            @NonNull final ButtonListener listener,
+                                            @NonNull final BisubPrefs.ProviderProfile profile) {
+        BisubPrefs.setActiveProfileId(appContext, profile.id);
+        startTranslation(info, listener);
+    }
+
     /**
      * Removes a listener from every translation it is attached to. Callers
      * must invoke this when their view hierarchy goes away, because the
diff --git a/app/src/main/java/org/schabi/newpipe/bisub/BisubPrefs.java b/app/src/main/java/org/schabi/newpipe/bisub/BisubPrefs.java
