+    // BISUB-BEGIN: provider picker for the "Bilingual" detail control.
+    // The single-choice list marks profiles that already cached this
+    // video; picking one activates it and starts the translation, while
+    // cached ones ask first whether to re-translate and replace.
+    private void showBisubProfileDialog() {
+        final Context context = getContext();
+        if (context == null || currentInfo == null) {
+            return;
+        }
+        final List<BisubPrefs.ProviderProfile> profiles =
+                BisubPrefs.loadProfiles(context);
+        if (profiles.isEmpty()) {
+            new AlertDialog.Builder(context)
+                    .setTitle(R.string.bisub_picker_title)
+                    .setMessage(R.string.bisub_picker_empty)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show();
+            return;
+        }
+        final BisubManager manager = BisubManager.getInstance(context);
+        final String activeId = BisubPrefs.getActiveProfileId(context);
+        final String[] labels = new String[profiles.size()];
+        final boolean[] cached = new boolean[profiles.size()];
+        int checked = 0;
+        for (int i = 0; i < profiles.size(); i++) {
+            final BisubPrefs.ProviderProfile profile = profiles.get(i);
+            if (profile.id.equals(activeId)) {
+                checked = i;
+            }
+            final boolean usable = BisubPrefs.configOf(context, profile).isUsable();
+            cached[i] = usable && manager.isTranslationCached(currentInfo, profile);
+            labels[i] = profile.name
+                    + (cached[i]
+                        ? getString(R.string.bisub_picker_cached_suffix) : "")
+                    + (!usable
+                        ? getString(R.string.bisub_picker_incomplete_suffix) : "");
+        }
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_picker_title)
+                .setSingleChoiceItems(labels, checked, (dialog, which) -> {
+                    dialog.dismiss();
+                    final BisubPrefs.ProviderProfile profile = profiles.get(which);
+                    if (!BisubPrefs.configOf(context, profile).isUsable()) {
+                        Toast.makeText(context, R.string.bisub_picker_incomplete_toast,
+                                Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    if (cached[which]) {
+                        confirmBisubRetranslate(profile);
+                    } else {
+                        manager.startTranslationWithProfile(
+                                currentInfo, bisubButtonListener, profile);
+                    }
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void confirmBisubRetranslate(final BisubPrefs.ProviderProfile profile) {
+        final Context context = getContext();
+        if (context == null || currentInfo == null) {
+            return;
+        }
+        final BisubManager manager = BisubManager.getInstance(context);
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_retranslate_title)
+                .setMessage(getString(R.string.bisub_retranslate_message, profile.name))
+                .setPositiveButton(R.string.bisub_retranslate_confirm, (dialog, which) -> {
+                    manager.deleteTranslationCache(currentInfo, profile);
+                    manager.startTranslationWithProfile(
+                            currentInfo, bisubButtonListener, profile);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+    // BISUB-END
     @NonNull
     private final CompositeDisposable disposables = new CompositeDisposable();
     @Nullable
