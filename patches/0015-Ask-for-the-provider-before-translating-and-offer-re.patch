@@ -329,22 +329,39 @@ public final class BisubPrefs {
      */
     @NonNull
     public static Config load(@NonNull final Context context) {
+        return configOf(context, getActiveProfile(context));
+    }
+
+    /**
+     * Builds the configuration of one specific provider profile, ignoring
+     * which profile is active: the enable switch and the languages are
+     * global, while the connection fields and the request tuning come from
+     * the given profile. Used to check what a translation with that
+     * profile would use, e.g. whether it already cached a video.
+     *
+     * @param context any context
+     * @param profile the profile to build the configuration from, or
+     *                {@code null} for the empty configuration
+     * @return the configuration snapshot
+     */
+    @NonNull
+    public static Config configOf(@NonNull final Context context,
+                                  @Nullable final ProviderProfile profile) {
         final SharedPreferences prefs =
                 PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
-        final ProviderProfile active = getActiveProfile(context);
         return new Config(
                 prefs.getBoolean(context.getString(R.string.bisub_enable_key), false),
-                active == null ? null : active.provider,
-                active == null ? null : active.baseUrl,
-                active == null ? null : active.apiKey,
-                active == null ? null : active.model,
+                profile == null ? null : profile.provider,
+                profile == null ? null : profile.baseUrl,
+                profile == null ? null : profile.apiKey,
+                profile == null ? null : profile.model,
                 prefs.getString(context.getString(R.string.bisub_target_lang_key), null),
                 prefs.getString(context.getString(R.string.bisub_source_lang_key), null),
-                active == null ? Config.CONCURRENCY_DEFAULT
-                        : clampInt(active.concurrency, Config.CONCURRENCY_MIN,
+                profile == null ? Config.CONCURRENCY_DEFAULT
+                        : clampInt(profile.concurrency, Config.CONCURRENCY_MIN,
                         Config.CONCURRENCY_MAX, Config.CONCURRENCY_DEFAULT),
-                active == null ? Config.BATCH_SIZE_DEFAULT
-                        : clampInt(active.batchSize, Config.BATCH_SIZE_MIN,
+                profile == null ? Config.BATCH_SIZE_DEFAULT
+                        : clampInt(profile.batchSize, Config.BATCH_SIZE_MIN,
                         Config.BATCH_SIZE_MAX, Config.BATCH_SIZE_DEFAULT));
     }
 
