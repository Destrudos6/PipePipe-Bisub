From 70d92f8a4880a527af95fb38a578b86213b5189d Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Sat, 24 Oct 2026 09:48:14 +0800
Subject: [PATCH] Drop the word book toasts, color the remove action red

Tapping the word book button popped a toast ("added" / "removed")
on every single tap, in the player's dictionary popup and in the
reader's alike. The button itself relabels and recolors immediately -
that is feedback enough; the toasts are gone.

The remove direction now colors the button red (Material red 300 on
the dark popup, red 600 on the light one) so "remove from word
book" visibly differs from the blue add action - the direction where
a mis-tap loses data catches the eye, the one that only adds does
not.
---
 .../bisub/wordlookup/WordDialogHelper.java    | 26 ++++++++++++++-----
 1 file changed, 19 insertions(+), 7 deletions(-)

diff --git a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
index adcc3e15e..d6722c7d1 100644
--- a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
+++ b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
@@ -66,6 +66,12 @@ public final class WordDialogHelper {
     private static final int DARK_CONTENT = 0xFFF5F5F5;
     private static final int DARK_MUTED = 0x99FFFFFF;
     private static final int DARK_BUTTON = 0xFF8AB4F8;
+    /** Red of the remove direction, so a mis-tap risk stays visible:
+     *  Material red 300 on the dark variant, red 600 on the light one. */
+    private static final int DARK_REMOVE = 0xFFF28B82;
+    private static final int LIGHT_REMOVE = 0xFFD93025;
+    /** Accent of the add direction on the light variant (theme blue). */
+    private static final int LIGHT_ADD = 0xFF1A73E8;
     /** How many senses / web translations the popup shows at most, so a
      *  popup for a word with many senses stays a quick lookup instead
      *  of an essay taller than the screen. */
@@ -150,19 +156,17 @@ public final class WordDialogHelper {
         // saved while the lookup was still running.
         final WordEntry[] currentEntry = new WordEntry[1];
 
-        refreshBookButton(bookButton, word);
+        refreshBookButton(bookButton, word, dark);
         bookButton.setOnClickListener(v -> {
             final Context buttonContext = v.getContext();
             if (WordBook.contains(buttonContext, word)) {
                 WordBook.remove(buttonContext, word);
-                Toast.makeText(buttonContext, R.string.bisub_word_book_removed,
-                        Toast.LENGTH_SHORT).show();
             } else {
                 WordBook.add(buttonContext, word, currentEntry[0]);
-                Toast.makeText(buttonContext, R.string.bisub_word_book_added,
-                        Toast.LENGTH_SHORT).show();
             }
-            refreshBookButton(bookButton, word);
+            // The button relabeling and recoloring is feedback enough -
+            // no toast on every tap.
+            refreshBookButton(bookButton, word, dark);
         });
 
         final Handler mainHandler = new Handler(Looper.getMainLooper());
@@ -365,15 +369,23 @@ public final class WordDialogHelper {
     }
 
     /**
+     * Labels and colors the word book button: adding stays in the
+     * (variant's) accent blue, while the remove direction turns red -
+     * removing is the action worth a second look before a mis-tap.
+     *
      * @param button the word book button
      * @param word   the looked-up word
+     * @param dark   whether the popup uses the dark variant
      */
     private static void refreshBookButton(@NonNull final Button button,
-                                          @NonNull final String word) {
+                                          @NonNull final String word,
+                                          final boolean dark) {
         if (WordBook.contains(button.getContext(), word)) {
             button.setText(R.string.bisub_word_book_remove);
+            button.setTextColor(dark ? DARK_REMOVE : LIGHT_REMOVE);
         } else {
             button.setText(R.string.bisub_word_book_add);
+            button.setTextColor(dark ? DARK_BUTTON : LIGHT_ADD);
         }
     }
 
