diff --git a/app/src/main/java/org/schabi/newpipe/bisub/SubtitleTranslator.java b/app/src/main/java/org/schabi/newpipe/bisub/SubtitleTranslator.java
index fc2ae58..128dc17 100644
--- a/app/src/main/java/org/schabi/newpipe/bisub/SubtitleTranslator.java
+++ b/app/src/main/java/org/schabi/newpipe/bisub/SubtitleTranslator.java
@@ -1684,6 +1684,15 @@ public final class SubtitleTranslator {
         if (url.endsWith("/v1")) {
             return url + "/chat/completions";
         }
+        // A base URL that already carries a path is the complete API root: the
+        // built-in Zhipu (GLM) preset is https://open.bigmodel.cn/api/paas/v4,
+        // and appending /v1 produced .../paas/v4/v1/chat/completions -> HTTP 404.
+        // Only a bare host still needs the /v1 suffix.
+        final int schemeEnd = url.indexOf("://");
+        final int pathStart = schemeEnd < 0 ? -1 : url.indexOf('/', schemeEnd + 3);
+        if (pathStart > 0 && pathStart < url.length() - 1) {
+            return url + "/chat/completions";
+        }
         return url + "/v1/chat/completions";
     }
 }
