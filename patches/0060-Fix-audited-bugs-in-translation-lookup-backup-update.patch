 .../newpipe/bisub/SubtitleTranslator.java     |   9 ++
 .../bisub/backup/CloudBackupManager.java      |  10 +-
 .../newpipe/bisub/wordlookup/WordBook.java    |  14 +-
 .../bisub/wordlookup/WordLookupService.java   |   6 +-
 .../bisub/wordlookup/YoudaoDictionary.java    |   8 +-
 .../org/schabi/newpipe/player/Player.java     |   6 +
 10 files changed, 231 insertions(+), 35 deletions(-)

