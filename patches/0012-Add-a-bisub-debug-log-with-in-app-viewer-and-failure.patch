+    /**
+     * Shows the debug log entries, newest at the bottom, and offers copy,
+     * clear and dismiss actions.
+     */
+    private void showDebugLogDialog() {
+        final Context context = requireContext();
+        final List<BisubLog.Entry> entries = BisubLog.snapshot();
+        final String text = BisubLog.formatSnapshot(entries);
+        final TextView view = new TextView(context);
+        view.setTypeface(Typeface.MONOSPACE);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
+        final int padding = Math.round(
+                16f * context.getResources().getDisplayMetrics().density);
+        view.setPadding(padding, padding / 2, padding, padding / 2);
+        view.setText(text.isEmpty() ? getString(R.string.bisub_debug_log_empty) : text);
+        final ScrollView scroller = new ScrollView(context);
+        scroller.addView(view);
+        scroller.post(() -> scroller.fullScroll(ScrollView.FOCUS_DOWN));
+        new AlertDialog.Builder(context)
+                .setTitle(getString(R.string.bisub_debug_log_title)
+                        + " (" + entries.size() + ")")
+                .setView(scroller)
+                .setPositiveButton(R.string.bisub_debug_log_copy,
+                        (final DialogInterface dialog, final int which) ->
+                                copyDebugLog(context))
+                .setNeutralButton(R.string.bisub_debug_log_clear,
+                        (final DialogInterface dialog, final int which) -> {
