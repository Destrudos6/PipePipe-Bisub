--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/BisubLog.java
@@ -0,0 +1,232 @@
+package org.schabi.newpipe.bisub;
+
+import android.content.Context;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.text.SimpleDateFormat;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * In-memory ring buffer of bisub pipeline events, mirrored to logcat under
+ * one tag ({@code Bisub}) so {@code adb logcat -s Bisub} shows everything.
+ * The buffer keeps the most recent entries across videos and survives
+ * fragment lifecycles, which makes it viewable in the settings screen after
+ * a failure happened; every failed translation additionally dumps the whole
+ * buffer to {@code bisub/logs/last-failure.txt}.
+ *
+ * <p>All methods are thread-safe; logging never throws and never slows the
+ * pipeline down measurably (an append is a few microseconds).</p>
+ */
+public final class BisubLog {
+
+    /** Everything is mirrored to logcat under this single tag. */
+    private static final String TAG = "Bisub";
+    /** Ring buffer capacity: enough for a full video of engine requests. */
+    private static final int MAX_ENTRIES = 2000;
+    /** Stack traces longer than this are cut off in the formatted output. */
+    private static final int MAX_THROWABLE_CHARS = 1200;
+    /** A single message longer than this is truncated (protects the buffer). */
+    private static final int MAX_MESSAGE_CHARS = 1000;
+
+    private static final ArrayDeque<Entry> BUFFER = new ArrayDeque<>();
+    private static final SimpleDateFormat TIME_FORMAT =
+            new SimpleDateFormat("MM-dd HH:mm:ss.SSS", Locale.US);
+
+    private BisubLog() { }
+
+    /** One log record: when it happened, how severe, and the message. */
+    public static final class Entry {
+        /** Wall-clock time of the event in epoch milliseconds. */
+        public final long time;
+        /** Severity: one of {@code 'I'}, {@code 'W'} or {@code 'E'}. */
+        public final char level;
+        /** The message, never {@code null}, already single-line. */
+        public final String message;
+
+        Entry(final long time, final char level, @NonNull final String message) {
+            this.time = time;
+            this.level = level;
+            this.message = message;
+        }
+    }
+
+    /**
+     * Records an informational event.
+     *
+     * @param message the event description
+     */
+    public static void i(@NonNull final String message) {
+        append('I', message);
+    }
+
+    /**
+     * Records a warning.
+     *
+     * @param message the warning description
+     */
+    public static void w(@NonNull final String message) {
+        append('W', message);
+    }
+
+    /**
+     * Records a warning together with the exception that caused it.
+     *
+     * @param message the warning description
+     * @param error   the exception, or {@code null} for none
+     */
+    public static void w(@NonNull final String message, @Nullable final Throwable error) {
+        append('W', error == null ? message : message + "\n" + describe(error));
+    }
+
+    /**
+     * Records an error.
+     *
+     * @param message the error description
+     */
+    public static void e(@NonNull final String message) {
+        append('E', message);
+    }
+
+    /**
+     * Records an error together with the exception that caused it.
+     *
+     * @param message the error description
+     * @param error   the exception, or {@code null} for none
+     */
+    public static void e(@NonNull final String message, @Nullable final Throwable error) {
+        append('E', error == null ? message : message + "\n" + describe(error));
+    }
+
+    private static void append(final char level, @NonNull final String message) {
+        final String trimmed = truncate(message, MAX_MESSAGE_CHARS);
+        final Entry entry = new Entry(System.currentTimeMillis(), level, trimmed);
+        synchronized (BUFFER) {
+            BUFFER.addLast(entry);
+            while (BUFFER.size() > MAX_ENTRIES) {
+                BUFFER.removeFirst();
+            }
+        }
+        Log.println(logcatPriority(level), TAG, trimmed);
+    }
+
+    private static int logcatPriority(final char level) {
+        if (level == 'E') {
+            return Log.ERROR;
+        }
+        if (level == 'W') {
+            return Log.WARN;
+        }
+        return Log.INFO;
+    }
+
+    /**
+     * @return an immutable copy of the buffered entries, oldest first
+     */
+    @NonNull
+    public static List<Entry> snapshot() {
+        synchronized (BUFFER) {
+            return new ArrayList<>(BUFFER);
+        }
+    }
+
+    /**
+     * Empties the buffer; logcat output is not affected.
+     */
+    public static void clear() {
+        synchronized (BUFFER) {
+            BUFFER.clear();
+        }
+    }
+
+    /**
+     * Formats buffered entries as shareable text: one line per event with
+     * timestamp and level, stack traces indented below their message.
+     *
+     * @param entries the entries to format, as returned by {@link #snapshot()}
+     * @return the formatted log, empty when there are no entries
+     */
+    @NonNull
+    public static String formatSnapshot(@NonNull final List<Entry> entries) {
+        if (entries.isEmpty()) {
+            return "";
+        }
+        final StringBuilder text = new StringBuilder();
+        for (final Entry entry : entries) {
+            synchronized (TIME_FORMAT) {
+                text.append(TIME_FORMAT.format(new Date(entry.time)))
+                        .append(' ').append(entry.level).append(' ');
+            }
+            final String body = entry.message.replace("\n", "\n    ");
+            text.append(body).append('\n');
+        }
+        return text.toString();
+    }
+
+    /**
+     * Writes the current buffer to {@code bisub/logs/last-failure.txt},
+     * overwriting any previous failure dump. Called whenever a translation
+     * fails, so the log of what went wrong survives later activity that
+     * would eventually evict it from the ring buffer.
+     *
+     * @param context any context; the application context is used
+     * @return the file the log was written to, or {@code null} on failure
+     */
+    @Nullable
+    public static File persistLastFailure(@NonNull final Context context) {
+        final List<Entry> entries = snapshot();
+        if (entries.isEmpty()) {
+            return null;
+        }
+        final File dir = new File(new File(
+                context.getApplicationContext().getFilesDir(), "bisub"), "logs");
+        try {
+            if (!dir.exists() && !dir.mkdirs()) {
+                Log.w(TAG, "Could not create the bisub log directory " + dir);
+                return null;
+            }
+            final File file = new File(dir, "last-failure.txt");
+            final String header = "bisub debug log - dump of the last failure\n"
+                    + "written " + new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US)
+                    .format(new Date()) + ", " + entries.size() + " entries\n\n";
+            Files.write(file.toPath(), (header + formatSnapshot(entries))
+                    .getBytes(StandardCharsets.UTF_8));
+            return file;
+        } catch (final IOException e) {
+            Log.w(TAG, "Could not write the bisub failure log", e);
+            return null;
+        }
+    }
+
+    /**
+     * @param error the throwable to describe
+     * @return class name, message and a bounded stack trace, single string
+     */
+    @NonNull
+    private static String describe(@NonNull final Throwable error) {
+        String text = error.getClass().getSimpleName() + ": " + error.getMessage();
+        for (final StackTraceElement frame : error.getStackTrace()) {
+            text += "\n    at " + frame;
+        }
+        return truncate(text, MAX_THROWABLE_CHARS);
+    }
+
+    @NonNull
+    private static String truncate(@NonNull final String text, final int limit) {
+        String flat = text.replace('\r', ' ');
+        if (flat.length() > limit) {
+            flat = flat.substring(0, limit) + "…(truncated)";
+        }
+        return flat;
+    }
+}
