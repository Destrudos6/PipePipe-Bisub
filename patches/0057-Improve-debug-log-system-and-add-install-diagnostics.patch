+    /**
+     * Uploads the current debug log to the configured cloud backup endpoint
+     * so it can be inspected from another device or shared for support.
+     */
+    private void uploadLogToCloud(@NonNull final Context context,
+                                  @NonNull final String logText) {
+        if (logText.isEmpty()) {
+            Toast.makeText(context, R.string.bisub_debug_log_empty,
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (!CloudBackupConfig.load(context).isConfigured()) {
+            Toast.makeText(context, R.string.bisub_debug_log_no_cloud,
+                    Toast.LENGTH_LONG).show();
+            return;
+        }
+        final android.app.ProgressDialog progress =
+                new android.app.ProgressDialog(context);
+        progress.setMessage(getString(R.string.bisub_debug_log_upload));
+        progress.setCancelable(false);
+        progress.show();
+        final Handler ui = new Handler(Looper.getMainLooper());
+        new Thread(() -> {
+            try {
+                CloudBackupManager.getInstance(context).uploadLog(logText);
+                ui.post(() -> {
+                    progress.dismiss();
+                    Toast.makeText(context, R.string.bisub_debug_log_uploaded,
+                            Toast.LENGTH_SHORT).show();
+                });
+            } catch (final Exception e) {
+                ui.post(() -> {
+                    progress.dismiss();
+                    Toast.makeText(context,
+                            getString(R.string.bisub_debug_log_upload_failed,
+                                    e.getMessage()),
+                            Toast.LENGTH_LONG).show();
+                });
+            }
+        }).start();
+    }
