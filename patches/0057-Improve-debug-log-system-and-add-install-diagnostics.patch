+    /**
+     * Uploads the bisub debug log as a plain-text file to the configured
+     * remote storage, so it can be inspected from another device or shared
+     * for troubleshooting. The file is named {@code bisub-debug-log.txt}
+     * and placed in the same remote directory as backups.
+     *
+     * @param logText the full formatted log text
+     * @return the remote file name
+     * @throws Exception when the upload fails; the message is user-facing
+     */
+    @NonNull
+    public String uploadLog(@NonNull final String logText) throws Exception {
+        synchronized (this) {
+            final CloudBackupConfig config = CloudBackupConfig.load(appContext);
+            if (!config.isConfigured()) {
+                throw new IOException("Cloud backup is not configured");
+            }
+            final RemoteBackend backend = config.toBackend();
+            final String name = "bisub-debug-log.txt";
+            final File temp = new File(appContext.getCacheDir(), name);
+            try {
+                Files.write(temp.toPath(),
+                        logText.getBytes(StandardCharsets.UTF_8));
+                backend.ensureRemoteDir(config.remoteDir);
+                backend.uploadBackup(config.remoteDir, name, temp);
+                Log.i(TAG, "Debug log uploaded: " + name
+                        + " (" + temp.length() + " bytes)");
+                return name;
+            } finally {
+                if (temp.exists() && !temp.delete()) {
+                    temp.deleteOnExit();
+                }
+            }
+        }
+    }
+
     /**
      * @return the remote backups, newest first
      * @throws IOException when the connection or the listing fails
