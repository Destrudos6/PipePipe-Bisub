+    /**
+     * Loads every saved provider profile, migrating the legacy
+     * single-provider settings the first time this runs.
+     *
+     * @param context any context
+     * @return the profiles, possibly empty, never {@code null}
+     */
+    @NonNull
+    public static List<ProviderProfile> loadProfiles(@NonNull final Context context) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        final List<ProviderProfile> profiles = new ArrayList<>();
+        final String raw = prefs.getString(context.getString(R.string.bisub_profiles_key), null);
+        if (raw != null) {
+            try {
+                final JSONArray array = new JSONArray(raw);
+                for (int i = 0; i < array.length(); i++) {
+                    final ProviderProfile profile =
+                            ProviderProfile.fromJson(array.optJSONObject(i));
+                    if (profile != null) {
+                        profiles.add(profile);
+                    }
+                }
+            } catch (final JSONException e) {
+                Log.w("BisubPrefs", "Could not parse the provider profiles", e);
+            }
+        } else {
+            migrateLegacyProfile(context, prefs, profiles);
+        }
+        return profiles;
+    }
+
+    /**
+     * Persists the provider profile list.
+     *
+     * @param context  any context
+     * @param profiles the profiles to store
+     */
+    public static void saveProfiles(@NonNull final Context context,
+                                    @NonNull final List<ProviderProfile> profiles) {
+        final JSONArray array = new JSONArray();
+        for (final ProviderProfile profile : profiles) {
+            try {
+                array.put(profile.toJson());
+            } catch (final JSONException e) {
+                Log.w("BisubPrefs", "Could not serialize a provider profile", e);
+            }
+        }
+        PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext())
+                .edit()
+                .putString(context.getString(R.string.bisub_profiles_key), array.toString())
+                .apply();
+    }
+
+    /**
+     * @param context any context
+     * @return the id of the active profile, or {@code null} when unset
+     */
+    @Nullable
+    public static String getActiveProfileId(@NonNull final Context context) {
+        return PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext())
+                .getString(context.getString(R.string.bisub_active_profile_key), null);
+    }
+
+    /**
+     * Selects the active provider profile.
+     *
+     * @param context any context
+     * @param id      the profile id to activate
+     */
+    public static void setActiveProfileId(@NonNull final Context context,
+                                          @Nullable final String id) {
+        PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext())
+                .edit()
+                .putString(context.getString(R.string.bisub_active_profile_key), id)
+                .apply();
+    }
+
+    /**
+     * @param context any context
+     * @return the active profile, the first one when none is selected
+     *         explicitly, or {@code null} when there are no profiles
+     */
+    @Nullable
+    public static ProviderProfile getActiveProfile(@NonNull final Context context) {
+        final List<ProviderProfile> profiles = loadProfiles(context);
+        final String activeId = getActiveProfileId(context);
+        if (activeId != null) {
+            for (final ProviderProfile profile : profiles) {
+                if (profile.id.equals(activeId)) {
+                    return profile;
+                }
+            }
+        }
+        return profiles.isEmpty() ? null : profiles.get(0);
+    }
+
+    /**
+     * Replaces one profile (or appends it when its id is unknown).
+     *
+     * @param context any context
+     * @param updated the profile with the same id as the one to replace
+     */
+    public static void replaceProfile(@NonNull final Context context,
+                                      @NonNull final ProviderProfile updated) {
+        final List<ProviderProfile> profiles = loadProfiles(context);
+        for (int i = 0; i < profiles.size(); i++) {
+            if (profiles.get(i).id.equals(updated.id)) {
+                profiles.set(i, updated);
+                saveProfiles(context, profiles);
+                return;
+            }
+        }
+        profiles.add(updated);
+        saveProfiles(context, profiles);
+        setActiveProfileId(context, updated.id);
+    }
+
+    /**
+     * Adds a profile and makes it the active one.
+     *
+     * @param context any context
+     * @param profile the profile to add
+     */
+    public static void addProfile(@NonNull final Context context,
+                                  @NonNull final ProviderProfile profile) {
+        final List<ProviderProfile> profiles = loadProfiles(context);
+        profiles.add(profile);
+        saveProfiles(context, profiles);
+        setActiveProfileId(context, profile.id);
+    }
+
+    /**
+     * Deletes a profile. When the active one is deleted, the first
+     * remaining profile takes over (or none, when the list becomes empty).
+     *
+     * @param context any context
+     * @param id      the id of the profile to delete
+     */
+    public static void deleteProfile(@NonNull final Context context,
+                                     @NonNull final String id) {
+        final List<ProviderProfile> profiles = loadProfiles(context);
+        for (int i = 0; i < profiles.size(); i++) {
+            if (profiles.get(i).id.equals(id)) {
+                profiles.remove(i);
+                break;
+            }
+        }
+        saveProfiles(context, profiles);
+        if (id.equals(getActiveProfileId(context))) {
+            setActiveProfileId(context, profiles.isEmpty() ? null : profiles.get(0).id);
+        }
+    }
+
+    /**
+     * Creates the first profile out of the legacy single-provider
+     * preference keys, so an update never loses an existing setup.
+     *
+     * @param context  any context
+     * @param prefs    the default shared preferences
+     * @param profiles the (empty) list to append the legacy profile to
+     */
+    private static void migrateLegacyProfile(@NonNull final Context context,
+                                             @NonNull final SharedPreferences prefs,
+                                             @NonNull final List<ProviderProfile> profiles) {
+        final String baseUrl = prefs.getString(
+                context.getString(R.string.bisub_base_url_key), null);
+        final String apiKey = prefs.getString(
+                context.getString(R.string.bisub_api_key_key), null);
+        final String model = prefs.getString(
+                context.getString(R.string.bisub_model_key), null);
+        if (isBlank(baseUrl) && isBlank(apiKey) && isBlank(model)) {
+            return;
+        }
+        final String provider = prefs.getString(
+                context.getString(R.string.bisub_provider_key), null);
+        profiles.add(new ProviderProfile("legacy", legacyName(provider), provider,
+                baseUrl, apiKey, model,
+                readIntInRange(prefs, context.getString(R.string.bisub_concurrency_key),
                         Config.CONCURRENCY_DEFAULT, Config.CONCURRENCY_MIN,
                         Config.CONCURRENCY_MAX),
-                readIntInRange(prefs,
-                        context.getString(R.string.bisub_batch_size_key),
+                readIntInRange(prefs, context.getString(R.string.bisub_batch_size_key),
                         Config.BATCH_SIZE_DEFAULT, Config.BATCH_SIZE_MIN,
-                        Config.BATCH_SIZE_MAX));
+                        Config.BATCH_SIZE_MAX)));
+        saveProfiles(context, profiles);
+        setActiveProfileId(context, "legacy");
+    }
+
+    @NonNull
+    private static String legacyName(@Nullable final String provider) {
+        if (isBlank(provider) || "custom".equals(provider)) {
+            return "Default";
+        }
+        return provider.substring(0, 1).toUpperCase(java.util.Locale.ROOT)
+                + provider.substring(1);
+    }
+
+    private static boolean isBlank(@Nullable final String s) {
+        return s == null || s.trim().isEmpty();
+    }
+
+    @Nullable
+    private static String nonBlankOrNull(@Nullable final String s) {
+        return isBlank(s) ? null : s;
+    }
+
+    private static int clampInt(final int value, final int min, final int max,
+                                final int fallback) {
+        return value < min || value > max ? fallback : value;
     }
 
