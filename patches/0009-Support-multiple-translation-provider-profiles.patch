+    public static final class ProviderProfile {
+        /** Stable unique id used to reference the active profile. */
+        @NonNull public final String id;
+        /** User-chosen display name shown in the profile picker. */
+        @NonNull public final String name;
+        /** Provider preset value (a value of bisub_provider_values). */
+        @Nullable public final String provider;
+        @Nullable public final String baseUrl;
+        @Nullable public final String apiKey;
+        @Nullable public final String model;
+        public final int concurrency;
+        public final int batchSize;
+
+        @SuppressWarnings("checkstyle:ParameterNumber")
+        public ProviderProfile(@NonNull final String id, @NonNull final String name,
+                               @Nullable final String provider,
+                               @Nullable final String baseUrl, @Nullable final String apiKey,
+                               @Nullable final String model, final int concurrency,
+                               final int batchSize) {
+            this.id = id;
+            this.name = name;
+            this.provider = provider;
+            this.baseUrl = baseUrl;
+            this.apiKey = apiKey;
+            this.model = model;
+            this.concurrency = concurrency;
+            this.batchSize = batchSize;
+        }
+
+        /**
+         * @param provider the new provider preset value
+         * @param baseUrl  the new API base URL
+         * @param model    the new model name
+         * @return a copy with the connection fields replaced
+         */
+        @NonNull
+        public ProviderProfile withConnection(@Nullable final String provider,
+                                              @Nullable final String baseUrl,
+                                              @Nullable final String model) {
+            return new ProviderProfile(id, name, provider, baseUrl, apiKey, model,
+                    concurrency, batchSize);
+        }
+
+        /**
+         * @param apiKey the new API key
+         * @return a copy with the API key replaced
+         */
+        @NonNull
+        public ProviderProfile withApiKey(@Nullable final String apiKey) {
+            return new ProviderProfile(id, name, provider, baseUrl, apiKey, model,
+                    concurrency, batchSize);
+        }
+
+        /**
+         * @param concurrency the new parallel request count
+         * @param batchSize   the new lines-per-request count
+         * @return a copy with the request tuning replaced
+         */
+        @NonNull
+        public ProviderProfile withTuning(final int concurrency, final int batchSize) {
+            return new ProviderProfile(id, name, provider, baseUrl, apiKey, model,
+                    concurrency, batchSize);
+        }
+
+        @NonNull
+        private JSONObject toJson() throws JSONException {
+            final JSONObject json = new JSONObject();
+            json.put("id", id);
+            json.put("name", name);
+            json.put("provider", provider == null ? "" : provider);
+            json.put("baseUrl", baseUrl == null ? "" : baseUrl);
+            json.put("apiKey", apiKey == null ? "" : apiKey);
+            json.put("model", model == null ? "" : model);
+            json.put("concurrency", concurrency);
+            json.put("batchSize", batchSize);
+            return json;
+        }
+
+        @Nullable
+        private static ProviderProfile fromJson(@NonNull final JSONObject json) {
+            final String id = json.optString("id", null);
+            final String name = json.optString("name", null);
+            if (isBlank(id) || isBlank(name)) {
+                return null;
+            }
+            return new ProviderProfile(id, name, nonBlankOrNull(json.optString("provider", null)),
+                    nonBlankOrNull(json.optString("baseUrl", null)),
+                    nonBlankOrNull(json.optString("apiKey", null)),
+                    nonBlankOrNull(json.optString("model", null)),
+                    json.optInt("concurrency", Config.CONCURRENCY_DEFAULT),
+                    json.optInt("batchSize", Config.BATCH_SIZE_DEFAULT));
+        }
+    }
