+package org.schabi.newpipe.bisub.backup;
+
+import androidx.annotation.NonNull;
+
+/**
+ * One backup file stored on the remote storage backend.
+ */
+public final class RemoteFile {
+    /** File name, without any directory prefix. */
+    @NonNull public final String name;
+    /** Size in bytes. */
+    public final long size;
+    /** Last modification time in epoch milliseconds. */
+    public final long lastModified;
+
+    RemoteFile(@NonNull final String name, final long size, final long lastModified) {
+        this.name = name;
+        this.size = size;
+        this.lastModified = lastModified;
+    }
+}
