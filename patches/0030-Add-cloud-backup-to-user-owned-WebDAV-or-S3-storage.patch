+                val entry: ZipEntry = inZip.nextEntry ?: break
+                if (entry.name == name) {
+                    val oldFile = File(target)
+                    if (oldFile.exists()) {
+                        oldFile.delete()
+                    }
+                    FileOutputStream(target).use { outFile ->
+                        var count = inZip.read(data)
+                        while (count != -1) {
