+package org.schabi.newpipe.bisub.backup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+
+import androidx.preference.PreferenceManager;
+import androidx.work.ExistingPeriodicWorkPolicy;
+import androidx.work.PeriodicWorkRequest;
+import androidx.work.WorkManager;
+
+import org.schabi.newpipe.NewPipeDatabase;
+import org.schabi.newpipe.settings.ContentSettingsManager;
+import org.schabi.newpipe.settings.NewPipeFileLocator;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Orchestrates cloud backups: assembles the same complete backup zip as
+ * the manual export (database, settings, bisub subtitle cache), uploads
+ * it to the user's own remote storage, prunes old remote backups, and
+ * restores everything back on demand.
+ */
+public final class CloudBackupManager {
+
+    private static final String TAG = CloudBackupManager.class.getSimpleName();
+    private static final String WORK_NAME = "bipipe-cloud-backup";
+    private static final String TEMP_FILE = "bipipe-cloud-backup.zip";
+
+    private static volatile CloudBackupManager instance;
+
+    private final Context appContext;
+
+    private CloudBackupManager(@NonNull final Context context) {
+        this.appContext = context.getApplicationContext();
+    }
+
+    /** @param context any context */
+    @NonNull
+    public static CloudBackupManager getInstance(@NonNull final Context context) {
+        if (instance == null) {
+            synchronized (CloudBackupManager.class) {
+                if (instance == null) {
+                    instance = new CloudBackupManager(context);
+                }
+            }
+        }
+        return instance;
+    }
+
+    private ContentSettingsManager settingsManager() {
+        return new ContentSettingsManager(
+                new NewPipeFileLocator(appContext.getDataDir()));
+    }
+
+    /**
+     * Generates a complete backup and uploads it to the configured remote
+     * storage, then prunes old backups beyond the retention limit.
+     *
+     * @return the name of the uploaded backup file
+     * @throws Exception when the export or the upload fails; the message
+     *                   is suitable for display
+     */
+    @NonNull
+    public String backupNow() throws Exception {
+        synchronized (this) {
+            NewPipeDatabase.checkpoint();
+            final CloudBackupConfig config = CloudBackupConfig.load(appContext);
+            final RemoteBackend backend = config.toBackend();
+            final String name = backupFileName();
+            final File temp = new File(appContext.getCacheDir(), TEMP_FILE);
+            try {
+                final SharedPreferences preferences =
+                        PreferenceManager.getDefaultSharedPreferences(appContext);
+                try (OutputStream out = new FileOutputStream(temp)) {
+                    settingsManager().exportDatabase(preferences, out);
+                }
+                backend.ensureRemoteDir(config.remoteDir);
+                backend.uploadBackup(config.remoteDir, name, temp);
+                pruneOldBackups(backend, config);
+                CloudBackupConfig.recordLastBackupTime(appContext,
+                        System.currentTimeMillis());
+                Log.i(TAG, "Cloud backup uploaded: " + name + " (" + temp.length()
+                        + " bytes)");
+                return name;
+            } finally {
+                if (temp.exists() && !temp.delete()) {
+                    temp.deleteOnExit();
+                }
+            }
+        }
+    }
+
+    private void pruneOldBackups(@NonNull final RemoteBackend backend,
+                                 @NonNull final CloudBackupConfig config) {
+        try {
+            final List<RemoteFile> files = backend.listBackups(config.remoteDir);
+            // listBackups is newest-first; delete everything past the limit.
+            for (int i = config.retention; i < files.size(); i++) {
+                backend.deleteBackup(config.remoteDir, files.get(i).name);
+                Log.i(TAG, "Pruned old cloud backup: " + files.get(i).name);
+            }
+        } catch (final IOException e) {
+            // Pruning is best-effort: the fresh backup is already stored.
+            Log.w(TAG, "Could not prune old cloud backups: " + e.getMessage());
+        }
+    }
+
+    @NonNull
+    private static String backupFileName() {
+        return "bipipe-backup-"
+                + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date())
+                + ".zip";
+    }
+
+    /**
+     * @return the remote backups, newest first
+     * @throws IOException when the connection or the listing fails
+     */
+    @NonNull
+    public List<RemoteFile> listBackups() throws IOException {
+        final CloudBackupConfig config = CloudBackupConfig.load(appContext);
+        return config.toBackend().listBackups(config.remoteDir);
+    }
+
+    /**
+     * Downloads a remote backup and applies it locally: database, bisub
+     * subtitle cache and settings are replaced. The caller is expected to
+     * restart the app afterwards so the new database is picked up.
+     *
+     * @param name the remote backup file name
+     * @throws Exception when the download or the import fails
+     */
+    public void restoreBackup(@NonNull final String name) throws Exception {
+        synchronized (this) {
+            final CloudBackupConfig config = CloudBackupConfig.load(appContext);
+            final RemoteBackend backend = config.toBackend();
+            final File temp = new File(appContext.getCacheDir(), TEMP_FILE);
+            try {
+                backend.downloadBackup(config.remoteDir, name, temp);
+                final ContentSettingsManager manager = settingsManager();
+                if (!manager.extractDbFromFile(temp)) {
+                    throw new IOException("The backup contains no database");
+                }
+                manager.extractBisubCacheFromFile(temp);
+                if (manager.extractSettingsFromFile(temp)) {
+                    manager.loadSharedPreferences(
+                            PreferenceManager.getDefaultSharedPreferences(appContext));
+                }
+                Log.i(TAG, "Cloud backup restored: " + name);
+            } finally {
+                if (temp.exists() && !temp.delete()) {
+                    temp.deleteOnExit();
+                }
+            }
+        }
+    }
+
+    /**
+     * (Re-)schedules or cancels the periodic automatic backup according to
+     * the current configuration. Called whenever the related settings
+     * change; the unique work survives app restarts and process death.
+     *
+     * @param context any context
+     */
+    public static void scheduleAutomaticBackups(@NonNull final Context context) {
+        final WorkManager workManager = WorkManager.getInstance(context);
+        final CloudBackupConfig config = CloudBackupConfig.load(context);
+        if (!config.autoEnabled || !config.isConfigured()) {
+            workManager.cancelUniqueWork(WORK_NAME);
+            return;
+        }
+        final PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(
+                CloudBackupWorker.class, config.autoIntervalDays, TimeUnit.DAYS)
+                .build();
+        workManager.enqueueUniquePeriodicWork(WORK_NAME,
+                ExistingPeriodicWorkPolicy.UPDATE, request);
+    }
+
+}
