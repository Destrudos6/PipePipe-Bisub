+package org.schabi.newpipe.bisub.backup;
+
+import androidx.annotation.NonNull;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.List;
+
+/**
+ * A user-owned remote storage where complete backups are uploaded to and
+ * restored from. Two implementations exist, mirroring the backends that
+ * self-hosted storage commonly speaks: WebDAV (Nextcloud, Synology,
+ * NutStore, AList, InfiniCLOUD, ...) and S3 (MinIO, Cloudflare R2,
+ * Backblaze B2, Storj, Amazon S3, ...).
+ *
+ * <p>All methods are blocking network calls and must run off the main
+ * thread. Failures are reported as {@link IOException}s whose message is
+ * shown to the user, so implementations are expected to phrase them
+ * meaningfully (HTTP code, response body, or reason).</p>
+ */
+public interface RemoteBackend {
+
+    /**
+     * Verifies that the endpoint is reachable, the credentials are
+     * accepted and the target exists, without writing anything.
+     *
+     * @throws IOException when the connection cannot be established
+     */
+    void checkConnection() throws IOException;
+
+    /**
+     * Makes sure the remote directory for backups exists. A no-op for
+     * backends without real directories (S3 prefixes).
+     *
+     * @param dir the directory path, segments separated by {@code /},
+     *            without leading or trailing slashes; empty means the root
+     * @throws IOException when the directory cannot be created
+     */
+    void ensureRemoteDir(@NonNull String dir) throws IOException;
+
+    /**
+     * Lists the backup files (anything ending in {@code .zip}) inside a
+     * directory, ordered from newest to oldest by name.
+     *
+     * @param dir the directory to list; empty means the root
+     * @return the backup files; empty when there are none
+     * @throws IOException when listing fails
+     */
+    @NonNull
+    List<RemoteFile> listBackups(@NonNull String dir) throws IOException;
+
+    /**
+     * Uploads a local file into the remote directory under a new name.
+     *
+     * @param dir  the target directory; empty means the root
+     * @param name the file name inside the directory
+     * @param file the local file to upload
+     * @throws IOException when the upload fails
+     */
+    void uploadBackup(@NonNull String dir, @NonNull String name, @NonNull File file)
+            throws IOException;
+
+    /**
+     * Downloads a remote backup into a local file.
+     *
+     * @param dir    the directory the backup lives in; empty means the root
+     * @param name   the file name inside the directory
+     * @param target the local file to overwrite
+     * @throws IOException when the download fails
+     */
+    void downloadBackup(@NonNull String dir, @NonNull String name, @NonNull File target)
+            throws IOException;
+
+    /**
+     * Deletes a remote backup.
+     *
+     * @param dir  the directory the backup lives in; empty means the root
+     * @param name the file name inside the directory
+     * @throws IOException when the deletion fails
+     */
+    void deleteBackup(@NonNull String dir, @NonNull String name) throws IOException;
+}
