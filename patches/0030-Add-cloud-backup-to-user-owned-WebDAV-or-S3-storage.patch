+package org.schabi.newpipe.bisub.backup;
+
+import android.content.Context;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.work.Worker;
+import androidx.work.WorkerParameters;
+
+/**
+ * Periodic background job that runs the cloud backup. Failures are
+ * silent by design (mirroring the auto-sync behaviour of similar
+ * projects): the next scheduled run retries, and the settings screen
+ * always shows when the last backup actually succeeded.
+ */
+public final class CloudBackupWorker extends Worker {
+
+    private static final String TAG = CloudBackupWorker.class.getSimpleName();
+
+    public CloudBackupWorker(@NonNull final Context context,
+                             @NonNull final WorkerParameters params) {
+        super(context, params);
+    }
+
+    @NonNull
+    @Override
+    public Result doWork() {
+        try {
+            final String name =
+                    CloudBackupManager.getInstance(getApplicationContext()).backupNow();
+            Log.i(TAG, "Automatic cloud backup finished: " + name);
+            return Result.success();
+        } catch (final Exception e) {
+            Log.e(TAG, "Automatic cloud backup failed", e);
+            return Result.failure();
+        }
+    }
+}
