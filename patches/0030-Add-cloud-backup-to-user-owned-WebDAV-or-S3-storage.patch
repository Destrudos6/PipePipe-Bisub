@@ -0,0 +1,195 @@
+package org.schabi.newpipe.bisub.backup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.PreferenceManager;
+
+import org.schabi.newpipe.R;
+
+import java.io.IOException;
+
+/**
+ * Configuration of the cloud backup feature, persisted in the default
+ * shared preferences (and therefore included in regular data exports,
+ * so a restored device remembers its cloud storage).
+ */
+public final class CloudBackupConfig {
+
+    /** Backend identifier of the WebDAV implementation. */
+    public static final String PROVIDER_WEBDAV = "webdav";
+    /** Backend identifier of the S3 implementation. */
+    public static final String PROVIDER_S3 = "s3";
+    /** Default remote directory for backups. */
+    public static final String DEFAULT_DIR = "BiPipe";
+    /** Default number of remote backups kept before pruning. */
+    public static final int DEFAULT_RETENTION = 5;
+
+    @Nullable public final String provider;
+    @Nullable public final String webdavUrl;
+    @Nullable public final String webdavUsername;
+    @Nullable public final String webdavPassword;
+    @Nullable public final String s3Endpoint;
+    @Nullable public final String s3Region;
+    @Nullable public final String s3Bucket;
+    @Nullable public final String s3AccessKey;
+    @Nullable public final String s3SecretKey;
+    @NonNull public final String remoteDir;
+    public final boolean autoEnabled;
+    public final int autoIntervalDays;
+    public final int retention;
+
+    private CloudBackupConfig(@Nullable final String provider,
+                              @Nullable final String webdavUrl,
+                              @Nullable final String webdavUsername,
+                              @Nullable final String webdavPassword,
+                              @Nullable final String s3Endpoint,
+                              @Nullable final String s3Region,
+                              @Nullable final String s3Bucket,
+                              @Nullable final String s3AccessKey,
+                              @Nullable final String s3SecretKey,
+                              @Nullable final String remoteDir,
+                              final boolean autoEnabled,
+                              final int autoIntervalDays,
+                              final int retention) {
+        this.provider = provider;
+        this.webdavUrl = webdavUrl;
+        this.webdavUsername = webdavUsername;
+        this.webdavPassword = webdavPassword;
+        this.s3Endpoint = s3Endpoint;
+        this.s3Region = s3Region;
+        this.s3Bucket = s3Bucket;
+        this.s3AccessKey = s3AccessKey;
+        this.s3SecretKey = s3SecretKey;
+        this.remoteDir = remoteDir == null || remoteDir.trim().isEmpty()
+                ? DEFAULT_DIR : remoteDir.trim();
+        this.autoEnabled = autoEnabled;
+        this.autoIntervalDays = autoIntervalDays;
+        this.retention = retention;
+    }
+
+    /**
+     * @return whether enough settings of the selected backend are present
+     *         to attempt a connection
+     */
+    public boolean isConfigured() {
+        if (PROVIDER_WEBDAV.equals(provider)) {
+            return notBlank(webdavUrl) && notBlank(webdavUsername) && notBlank(webdavPassword);
+        }
+        if (PROVIDER_S3.equals(provider)) {
+            return notBlank(s3Endpoint) && notBlank(s3Bucket) && notBlank(s3AccessKey)
+                    && notBlank(s3SecretKey);
+        }
+        return false;
+    }
+
+    /**
+     * @return the backend for this configuration
+     * @throws IOException when the configuration is missing or invalid
+     */
+    @NonNull
+    public RemoteBackend toBackend() throws IOException {
+        if (!isConfigured()) {
+            throw new IOException("The cloud backup settings are incomplete");
+        }
+        if (PROVIDER_WEBDAV.equals(provider)) {
+            return new WebDavBackend(webdavUrl.trim(), webdavUsername.trim(),
+                    webdavPassword);
+        }
+        return new S3Backend(s3Endpoint.trim(), s3Region == null ? "" : s3Region,
+                s3Bucket, s3AccessKey.trim(), s3SecretKey);
+    }
+
+    /**
+     * @param context any context
+     * @return the current cloud backup configuration
+     */
+    @NonNull
+    public static CloudBackupConfig load(@NonNull final Context context) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        return new CloudBackupConfig(
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_provider_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_webdav_url_key),
+                        null),
+                prefs.getString(
+                        context.getString(R.string.bisub_cloud_backup_webdav_username_key),
+                        null),
+                prefs.getString(
+                        context.getString(R.string.bisub_cloud_backup_webdav_password_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_s3_endpoint_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_s3_region_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_s3_bucket_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_s3_access_key_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_s3_secret_key_key),
+                        null),
+                prefs.getString(context.getString(R.string.bisub_cloud_backup_dir_key),
+                        null),
+                prefs.getBoolean(
+                        context.getString(R.string.bisub_cloud_backup_auto_enabled_key), false),
+                readIntervalDays(prefs.getString(
+                        context.getString(R.string.bisub_cloud_backup_auto_interval_key),
+                        null)),
+                readRetention(prefs.getString(
+                        context.getString(R.string.bisub_cloud_backup_retention_key), null)));
+    }
+
+    private static int readIntervalDays(@Nullable final String value) {
+        if ("weekly".equals(value)) {
+            return 7;
+        }
+        return 1;
+    }
+
+    private static int readRetention(@Nullable final String value) {
+        if (value != null) {
+            try {
+                final int parsed = Integer.parseInt(value);
+                if (parsed > 0 && parsed <= 100) {
+                    return parsed;
+                }
+            } catch (final NumberFormatException ignored) {
+                // fall back to the default
+            }
+        }
+        return DEFAULT_RETENTION;
+    }
+
+    private static boolean notBlank(@Nullable final String value) {
+        return value != null && !value.trim().isEmpty();
+    }
+
+    /**
+     * Records when the last backup finished, for the settings summary.
+     *
+     * @param context     any context
+     * @param timestampMs epoch milliseconds of the finished backup
+     */
+    public static void recordLastBackupTime(@NonNull final Context context,
+                                            final long timestampMs) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        prefs.edit().putLong(
+                context.getString(R.string.bisub_cloud_backup_last_run_key), timestampMs)
+                .apply();
+    }
+
+    /**
+     * @param context any context
+     * @return epoch milliseconds of the last successful backup, or 0
+     */
+    public static long lastBackupTime(@NonNull final Context context) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        return prefs.getLong(
+                context.getString(R.string.bisub_cloud_backup_last_run_key), 0L);
+    }
+}
