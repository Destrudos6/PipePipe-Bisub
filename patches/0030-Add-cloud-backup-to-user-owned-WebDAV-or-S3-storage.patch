+package org.schabi.newpipe.settings;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.os.Bundle;
+import android.text.format.DateUtils;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.backup.CloudBackupConfig;
+import org.schabi.newpipe.bisub.backup.CloudBackupManager;
+import org.schabi.newpipe.bisub.backup.RemoteFile;
+import org.schabi.newpipe.util.NavigationHelper;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+import io.reactivex.rxjava3.android.schedulers.AndroidSchedulers;
+import io.reactivex.rxjava3.core.Completable;
+import io.reactivex.rxjava3.disposables.CompositeDisposable;
+import io.reactivex.rxjava3.schedulers.Schedulers;
+
+/**
+ * Second-level settings page for backups to the user's own cloud storage
+ * (WebDAV or S3), with manual backup / restore actions and an optional
+ * automatic backup schedule.
+ */
+public final class CloudBackupFragment extends BasePreferenceFragment {
+
+    private final CompositeDisposable disposables = new CompositeDisposable();
+    private AlertDialog busyDialog;
+    /** The last remote listing, kept for the restore chooser dialog. */
+    private List<RemoteFile> remoteFiles = new ArrayList<>();
+
+    @Override
+    public void onCreatePreferences(@Nullable final Bundle savedInstanceState,
+                                    @Nullable final String rootKey) {
+        addPreferencesFromResourceRegistry();
+
+        bindProviderPreference();
+        bindServerFields();
+        bindActions();
+        bindAutomaticBackups();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshSummaries();
+        applyProviderVisibility();
+        // Keep the periodic work aligned even if the process died with
+        // changed-but-unsaved settings or the app was restored from a backup.
+        CloudBackupManager.scheduleAutomaticBackups(requireContext());
+    }
+
+    @Override
+    public void onDestroy() {
+        dismissBusyDialog();
+        disposables.clear();
+        super.onDestroy();
+    }
+
+    private CloudBackupConfig config() {
+        return CloudBackupConfig.load(requireContext());
+    }
+
+    private void bindProviderPreference() {
+        final ListPreference provider =
+                (ListPreference) requirePreference(R.string.bisub_cloud_backup_provider_key);
+        provider.setOnPreferenceChangeListener((p, value) -> {
+
+            applyProviderVisibility();
+            CloudBackupManager.scheduleAutomaticBackups(requireContext());
+            refreshSummaries();
+            return true;
+        });
+    }
+
+    private void bindServerFields() {
+        // Editing any server field may complete or invalidate the
+        // configuration, so the automatic schedule must be re-evaluated.
+        final int[] editKeys = {
+                R.string.bisub_cloud_backup_webdav_url_key,
+                R.string.bisub_cloud_backup_webdav_username_key,
+                R.string.bisub_cloud_backup_webdav_password_key,
+                R.string.bisub_cloud_backup_s3_endpoint_key,
+                R.string.bisub_cloud_backup_s3_region_key,
+                R.string.bisub_cloud_backup_s3_bucket_key,
+                R.string.bisub_cloud_backup_s3_access_key_key,
+                R.string.bisub_cloud_backup_s3_secret_key_key,
+                R.string.bisub_cloud_backup_dir_key,};
+        for (final int key : editKeys) {
+            requirePreference(key).setOnPreferenceChangeListener((p, value) -> {
+                CloudBackupManager.scheduleAutomaticBackups(requireContext());
+                return true;
+            });
+        }
+    }
+
+    private void bindActions() {
+        requirePreference(R.string.bisub_cloud_backup_test_key)
+                .setOnPreferenceClickListener(p -> {
+                    runTestConnection();
+                    return true;
+                });
+        requirePreference(R.string.bisub_cloud_backup_now_key)
+                .setOnPreferenceClickListener(p -> {
+                    runBackupNow();
+                    return true;
+                });
+        requirePreference(R.string.bisub_cloud_backup_restore_key)
+                .setOnPreferenceClickListener(p -> {
+                    pickRemoteBackup();
+                    return true;
+                });
+    }
+
+    private void bindAutomaticBackups() {
+        final SwitchPreferenceCompat enabled =
+                (SwitchPreferenceCompat) requirePreference(
+                        R.string.bisub_cloud_backup_auto_enabled_key);
+        enabled.setOnPreferenceChangeListener((p, value) -> {
+            CloudBackupManager.scheduleAutomaticBackups(requireContext());
+            return true;
+        });
+        final ListPreference interval =
+                (ListPreference) requirePreference(
+                        R.string.bisub_cloud_backup_auto_interval_key);
+        interval.setOnPreferenceChangeListener((p, value) -> {
+            CloudBackupManager.scheduleAutomaticBackups(requireContext());
+            return true;
+        });
+    }
+
+    private void applyProviderVisibility() {
+        final boolean webdav =
+                CloudBackupConfig.PROVIDER_WEBDAV.equals(config().provider);
+        final int[] webdavKeys = {
+                R.string.bisub_cloud_backup_webdav_url_key,
+                R.string.bisub_cloud_backup_webdav_username_key,
+                R.string.bisub_cloud_backup_webdav_password_key,};
+        final int[] s3Keys = {
+                R.string.bisub_cloud_backup_s3_endpoint_key,
+                R.string.bisub_cloud_backup_s3_region_key,
+                R.string.bisub_cloud_backup_s3_bucket_key,
+                R.string.bisub_cloud_backup_s3_access_key_key,
+                R.string.bisub_cloud_backup_s3_secret_key_key,};
+        for (final int key : webdavKeys) {
+            requirePreference(key).setVisible(webdav);
+        }
+        for (final int key : s3Keys) {
+            requirePreference(key).setVisible(!webdav);
+        }
+    }
+
+    private void refreshSummaries() {
+        final long last = CloudBackupConfig.lastBackupTime(requireContext());
+        final Preference now = requirePreference(R.string.bisub_cloud_backup_now_key);
+        if (last == 0L) {
+            now.setSummary(R.string.bisub_cloud_backup_never);
+        } else {
+            now.setSummary(getString(R.string.bisub_cloud_backup_last_backup,
+                    DateUtils.formatDateTime(requireContext(), last,
+                            DateUtils.FORMAT_SHOW_DATE | DateUtils.FORMAT_SHOW_TIME)));
+        }
+    }
+
+    private void runTestConnection() {
+        final CloudBackupConfig config = config();
+        if (!config.isConfigured()) {
+            Toast.makeText(requireContext(),
+                    R.string.bisub_cloud_backup_not_configured, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        disposables.add(Completable.fromAction(() -> config.toBackend().checkConnection())
+                .subscribeOn(Schedulers.io())
+                .observeOn(AndroidSchedulers.mainThread())
+                .subscribe(
+                        () -> Toast.makeText(requireContext(),
+                                R.string.bisub_cloud_backup_test_ok,
+                                Toast.LENGTH_SHORT).show(),
+                        e -> Toast.makeText(requireContext(),
+                                getString(R.string.bisub_cloud_backup_test_failed,
+                                        e.getMessage()), Toast.LENGTH_LONG).show()));
+    }
+
+    private void runBackupNow() {
+        final CloudBackupConfig config = config();
+        if (!config.isConfigured()) {
+            Toast.makeText(requireContext(),
+                    R.string.bisub_cloud_backup_not_configured, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        showBusyDialog(getString(R.string.bisub_cloud_backup_running));
+        final Context context = requireContext();
+        disposables.add(Completable.fromAction(() ->
+                        CloudBackupManager.getInstance(context).backupNow())
+                .subscribeOn(Schedulers.io())
+                .observeOn(AndroidSchedulers.mainThread())
+                .subscribe(
+                        () -> {
+                            dismissBusyDialog();
+                            refreshSummaries();
+                            Toast.makeText(context, R.string.bisub_cloud_backup_done,
+                                    Toast.LENGTH_SHORT).show();
+                        },
+                        e -> {
+                            dismissBusyDialog();
+                            Toast.makeText(context,
+                                    getString(R.string.bisub_cloud_backup_failed,
+                                            e.getMessage()), Toast.LENGTH_LONG).show();
+                        }));
+    }
+
+    private void pickRemoteBackup() {
+        final CloudBackupConfig config = config();
+        if (!config.isConfigured()) {
+            Toast.makeText(requireContext(),
+                    R.string.bisub_cloud_backup_not_configured, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        final Context context = requireContext();
+        showBusyDialog(getString(R.string.bisub_cloud_backup_listing));
+        final CloudBackupManager manager =
+                CloudBackupManager.getInstance(context.getApplicationContext());
+        disposables.add(Completable.fromAction(() -> remoteFiles = manager.listBackups())
+                .subscribeOn(Schedulers.io())
+                .observeOn(AndroidSchedulers.mainThread())
+                .subscribe(
+                        () -> {
+                            dismissBusyDialog();
+                            if (remoteFiles.isEmpty()) {
+                                Toast.makeText(context,
+                                        R.string.bisub_cloud_backup_restore_empty,
+                                        Toast.LENGTH_SHORT).show();
+                                return;
+                            }
+                            showRestoreChooser();
+                        },
+                        e -> {
+                            dismissBusyDialog();
+                            Toast.makeText(context,
+                                    getString(R.string.bisub_cloud_backup_failed,
+                                            e.getMessage()), Toast.LENGTH_LONG).show();
+                        }));
+    }
+
+    private void showRestoreChooser() {
+        final List<RemoteFile> files = remoteFiles;
+        final SimpleDateFormat format =
+                new SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.getDefault());
+        final CharSequence[] labels = new CharSequence[files.size()];
+        for (int i = 0; i < files.size(); i++) {
+            final RemoteFile file = files.get(i);
+            labels[i] = file.name + "\n"
+                    + String.format(Locale.getDefault(), "%.1f MB", file.size / 1048576.0)
+                    + "  ·  " + format.format(new Date(file.lastModified));
+        }
+        final Context context = requireContext();
+        final int[] selected = {0};
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_cloud_backup_restore_title)
+                .setSingleChoiceItems(labels, 0, (dialog, which) -> selected[0] = which)
+                .setNegativeButton(R.string.cancel, null)
+                .setPositiveButton(R.string.bisub_cloud_backup_restore_action,
+                        (dialog, which) -> confirmRestore(files.get(selected[0])))
+                .show();
+    }
+
+    private void confirmRestore(@NonNull final RemoteFile file) {
+        final Context context = requireContext();
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_cloud_backup_restore_title)
+                .setMessage(getString(R.string.bisub_cloud_backup_restore_confirm,
+                        file.name))
+                .setNegativeButton(R.string.cancel, null)
+                .setPositiveButton(R.string.ok, (dialog, which) ->
+                        restoreFromCloud(file.name))
+                .show();
+    }
+
+    private void restoreFromCloud(@NonNull final String name) {
+        final Context context = requireContext();
+        showBusyDialog(getString(R.string.bisub_cloud_backup_restoring));
+        disposables.add(Completable.fromAction(() ->
+                        CloudBackupManager.getInstance(context).restoreBackup(name))
+                .subscribeOn(Schedulers.io())
+                .observeOn(AndroidSchedulers.mainThread())
+                .subscribe(
+                        () -> {
+                            dismissBusyDialog();
+                            Toast.makeText(context,
+                                    R.string.bisub_cloud_backup_restore_done,
+                                    Toast.LENGTH_SHORT).show();
+                            // The database on disk changed: restart like the
+                            // manual import does, so the running process
+                            // reopens everything cleanly.
+                            NavigationHelper.restartApp(requireActivity());
+                        },
+                        e -> {
+                            dismissBusyDialog();
+                            Toast.makeText(context,
+                                    getString(R.string.bisub_cloud_backup_failed,
+                                            e.getMessage()), Toast.LENGTH_LONG).show();
+                        }));
+    }
+
+    private void showBusyDialog(@NonNull final CharSequence message) {
+        dismissBusyDialog();
+        busyDialog = new AlertDialog.Builder(requireContext())
+                .setMessage(message)
+                .setCancelable(false)
+                .show();
+    }
+
+    private void dismissBusyDialog() {
+        if (busyDialog != null && busyDialog.isShowing()) {
+            busyDialog.dismiss();
+        }
+        busyDialog = null;
+    }
+}
