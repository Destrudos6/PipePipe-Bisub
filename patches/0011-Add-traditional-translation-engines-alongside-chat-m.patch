+     * engine joins lines with {@code \n} itself).
+     *
+     * @param line the raw subtitle line
+     * @return the single-line text, trimmed
+     */
+    @NonNull
+    private static String sanitizeLine(@Nullable final String line) {
+        if (line == null) {
+            return "";
+        }
+        return line.replace('\n', ' ').replace('\r', ' ').trim();
+    }
+
+    /**
+     * Translates the lines with the free Google endpoint
+     * ({@code translate.googleapis.com}, client {@code gtx}). Multiple
+     * lines are joined with newlines into one request; when the reply
+     * does not split back into the same number of lines, each line of
+     * that chunk is retried on its own, so a malformed batch reply can
+     * never shift translations by one line.
+     *
+     * @param lines the sanitized subtitle lines
+     * @param cfg   the user configuration
+     * @return translations keyed by the position in {@code lines}
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when the response cannot be parsed
+     */
+    @NonNull
+    private static Map<Integer, String> translateGoogle(@NonNull final List<String> lines,
+                                                        @NonNull final Config cfg)
+            throws IOException, JSONException {
+        final String target = engineTargetCode(cfg.provider, cfg.targetLanguage);
+        final Map<Integer, String> result = new HashMap<>();
+        final List<int[]> bounds = chunkBounds(lines, 20, 4000, true);
+        for (int c = 0; c < bounds.size(); c++) {
+            if (c > 0) {
+                sleepQuietly(100);
+            }
+            final int[] bound = bounds.get(c);
+            final List<String> chunk = lines.subList(bound[0], bound[1]);
+            final List<String> parsed = parseGoogleTranslatedLines(executeRequest(
+                    googleRequest(String.join("\n", chunk), target)));
+            if (parsed.size() == chunk.size()) {
+                for (int i = 0; i < chunk.size(); i++) {
+                    putIfMeaningful(result, bound[0] + i, parsed.get(i));
+                }
+                continue;
+            }
+            Log.w(TAG, "Google reply had " + parsed.size() + " lines for "
+                    + chunk.size() + " inputs, retrying the chunk line by line");
+            for (int i = 0; i < chunk.size(); i++) {
+                final List<String> single = parseGoogleTranslatedLines(executeRequest(
+                        googleRequest(chunk.get(i), target)));
+                if (!single.isEmpty()) {
+                    putIfMeaningful(result, bound[0] + i, single.get(0));
+                }
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Builds the GET request against the free Google translate endpoint.
+     * The query text is percent-encoded by {@link HttpUrl}, which also
+     * keeps the URL within the length the endpoint accepts.
+     *
+     * @param text   the text to translate, possibly newline-joined
+     * @param target the engine target language code
+     * @return the request to send
+     */
+    @NonNull
+    private static Request googleRequest(@NonNull final String text,
+                                         @NonNull final String target) {
+        final HttpUrl url = HttpUrl.parse("https://translate.googleapis.com/translate_a/single")
+                .newBuilder()
+                .addQueryParameter("client", "gtx")
+                .addQueryParameter("sl", "auto")
+                .addQueryParameter("tl", target)
+                .addQueryParameter("hl", target)
+                .addQueryParameter("dt", "t")
+                .addQueryParameter("ie", "UTF-8")
+                .addQueryParameter("oe", "UTF-8")
+                .addQueryParameter("q", text)
+                .build();
+        return new Request.Builder()
+                .url(url)
+                .header("User-Agent", BROWSER_USER_AGENT)
+                .get()
+                .build();
+    }
+
+    /**
+     * Parses the reply of the free Google endpoint into its translated
+     * lines: the first array holds one entry per translated segment whose
+     * first element is the translated text; joining the segments yields
+     * the full reply with the input newlines preserved.
+     *
+     * @param body the raw response body
+     * @return the translated lines, possibly fewer or more than requested
+     * @throws IOException   when the body is not the expected structure
+     * @throws JSONException when the body is not valid JSON
+     */
+    @NonNull
+    private static List<String> parseGoogleTranslatedLines(@NonNull final String body)
+            throws IOException, JSONException {
+        final JSONArray segments = new JSONArray(body).optJSONArray(0);
+        if (segments == null) {
+            throw new IOException("Unexpected Google translation response");
+        }
+        final StringBuilder joined = new StringBuilder();
+        for (int i = 0; i < segments.length(); i++) {
+            final JSONArray segment = segments.optJSONArray(i);
+            if (segment == null || segment.isNull(0)) {
+                continue;
+            }
+            joined.append(segment.optString(0));
+        }
+        return Arrays.asList(joined.toString().split("\n", -1));
+    }
