+    /**
+     * Translates one batch of texts with the traditional machine
+     * translation engine of the configuration. Each engine splits the
+     * batch into requests that respect its own size limits, sends them
+     * sequentially and aligns the replies back to the input positions.
+     * Lines that come back empty are simply absent from the result, so
+     * the caller's retry logic re-sends only those.
+     *
+     * @param batch the unique subtitle texts of one batch
+     * @param cfg   the user configuration (must be usable)
+     * @return a map from original text to translated text, possibly partial
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static Map<String, String> translateBatchTraditional(
+            @NonNull final List<String> batch, @NonNull final Config cfg)
+            throws IOException, JSONException {
+        final Map<String, String> result = new HashMap<>();
+        final List<String> lines = new ArrayList<>(batch.size());
+        final List<Integer> positions = new ArrayList<>(batch.size());
+        for (int i = 0; i < batch.size(); i++) {
+            final String line = batch.get(i);
+            final String cleaned = sanitizeLine(line);
+            if (cleaned.isEmpty()) {
+                result.put(line, line);
+                continue;
+            }
+            lines.add(cleaned);
+            positions.add(i);
+        }
+        if (lines.isEmpty()) {
+            return result;
+        }
+
+        final Map<Integer, String> translated;
+        switch (String.valueOf(cfg.provider)) {
+            case "google":
+                translated = translateGoogle(lines, cfg);
+                break;
+            case "microsoft":
+                translated = translateMicrosoft(lines, cfg);
+                break;
+            case "deepl":
+                translated = translateDeepL(lines, cfg);
+                break;
+            case "libre":
+                translated = translateLibre(lines, cfg);
+                break;
+            default:
+                throw new TranslationConfigException(
+                        "Unknown translation engine: " + cfg.provider);
+        }
+        for (final Map.Entry<Integer, String> entry : translated.entrySet()) {
+            result.put(batch.get(positions.get(entry.getKey())), entry.getValue());
+        }
+        return result;
+    }
