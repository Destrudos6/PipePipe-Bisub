From 5d919da5d30c69e42b4359c8b4d5e8462279f155 Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Tue, 20 Oct 2026 09:37:50 +0800
Subject: [PATCH 04/10] Add manual bilingual subtitle generation button on the
 detail page

First detail-controls row 'Bilingual' button driving
BisubManager.startTranslation with four visual states (idle, starting,
progress percent, done/failed) plus a completion toast. Wired in both
the default and the layout-large-land detail layout variants.
---
 .../fragments/detail/VideoDetailFragment.java | 78 +++++++++++++++++++
 .../fragment_video_detail.xml                 | 19 +++++
 .../main/res/layout/fragment_video_detail.xml | 19 +++++
 3 files changed, 116 insertions(+)

diff --git a/app/src/main/java/org/schabi/newpipe/fragments/detail/VideoDetailFragment.java b/app/src/main/java/org/schabi/newpipe/fragments/detail/VideoDetailFragment.java
index f1d135dab..83a9e1211 100644
--- a/app/src/main/java/org/schabi/newpipe/fragments/detail/VideoDetailFragment.java
+++ b/app/src/main/java/org/schabi/newpipe/fragments/detail/VideoDetailFragment.java
@@ -55,6 +55,7 @@ import com.squareup.picasso.Callback;
 import io.reactivex.rxjava3.core.Single;
 import org.schabi.newpipe.App;
 import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.BisubManager;
 import org.schabi.newpipe.database.stream.model.StreamEntity;
 import org.schabi.newpipe.databinding.FragmentVideoDetailBinding;
 import org.schabi.newpipe.download.DownloadDialog;
@@ -230,6 +231,64 @@ public final class VideoDetailFragment
     @Nullable
     private String tabsBuiltForUrl = null;
     private Disposable currentWorker;
+
+    // BISUB-BEGIN: drives the "Bilingual" detail control. Callbacks arrive on
+    // the main thread and may fire after the view hierarchy is gone, hence
+    // the binding guards.
+    private final BisubManager.ButtonListener bisubButtonListener =
+            new BisubManager.ButtonListener() {
+                @Override
+                public void onUnavailable() {
+                    if (binding != null) {
+                        binding.detailControlsBisub.setVisibility(View.GONE);
+                    }
+                }
+
+                @Override
+                public void onIdle() {
+                    if (binding != null) {
+                        binding.detailControlsBisub.setVisibility(View.VISIBLE);
+                        binding.detailControlsBisub.setEnabled(true);
+                        binding.detailControlsBisub.setText(R.string.bisub_button_idle);
+                    }
+                }
+
+                @Override
+                public void onStarting() {
+                    if (binding != null) {
+                        binding.detailControlsBisub.setVisibility(View.VISIBLE);
+                        binding.detailControlsBisub.setEnabled(false);
+                        binding.detailControlsBisub.setText(R.string.bisub_button_starting);
+                    }
+                }
+
+                @Override
+                public void onProgress(final int translated, final int total) {
+                    if (binding != null) {
+                        binding.detailControlsBisub.setVisibility(View.VISIBLE);
+                        binding.detailControlsBisub.setEnabled(false);
+                        binding.detailControlsBisub.setText(getString(
+                                R.string.bisub_button_progress,
+                                total > 0 ? translated * 100 / total : 0));
+                    }
+                }
+
+                @Override
+                public void onFinished(final boolean success) {
+                    if (binding == null) {
+                        return;
+                    }
+                    binding.detailControlsBisub.setVisibility(View.VISIBLE);
+                    binding.detailControlsBisub.setEnabled(true);
+                    binding.detailControlsBisub.setText(success
+                            ? R.string.bisub_button_done : R.string.bisub_button_failed);
+                    if (!success) {
+                        Toast.makeText(getContext(), R.string.bisub_toast_failed,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                }
+            };
+    // BISUB-END
     @NonNull
     private final CompositeDisposable disposables = new CompositeDisposable();
     @Nullable
@@ -454,6 +513,10 @@ public final class VideoDetailFragment
         activity.unregisterReceiver(broadcastReceiver);
         activity.getContentResolver().unregisterContentObserver(settingsContentObserver);
 
+        // BISUB-BEGIN: stop receiving translation callbacks with this fragment
+        BisubManager.getInstance(activity).detachButton(bisubButtonListener);
+        // BISUB-END
+
         if (positionSubscriber != null) {
             positionSubscriber.dispose();
         }
@@ -556,6 +619,13 @@ public final class VideoDetailFragment
                     PermissionHelper.DOWNLOAD_DIALOG_REQUEST_CODE)) {
                 this.openDownloadDialog();
             }
+        } else if (id == R.id.detail_controls_bisub) {
+            // BISUB-BEGIN: start (or join) the background translation
+            if (currentInfo != null) {
+                BisubManager.getInstance(requireContext())
+                        .startTranslation(currentInfo, bisubButtonListener);
+            }
+            // BISUB-END
         } else if (id == R.id.detail_controls_share) {
             if (currentInfo != null) {
                 ShareUtils.shareText(requireContext(), currentInfo.getName(),
@@ -804,6 +874,9 @@ public final class VideoDetailFragment
         binding.detailControlsPlaylistAppend.setOnLongClickListener(this);
         binding.detailControlsDownload.setOnClickListener(this);
         binding.detailControlsDownload.setOnLongClickListener(this);
+        // BISUB-BEGIN: manually trigger the bilingual subtitle translation
+        binding.detailControlsBisub.setOnClickListener(this);
+        // BISUB-END
         binding.detailControlsShare.setOnClickListener(this);
         binding.detailControlsOpenInBrowser.setOnClickListener(this);
         binding.detailControlsStartSleepTimer.setOnClickListener(this);
@@ -1937,6 +2010,11 @@ public final class VideoDetailFragment
         currentInfo = info;
         setInitialData(info.getServiceId(), info.getOriginalUrl(), info.getName(), playQueue);
 
+        // BISUB-BEGIN: reflect the bilingual subtitle state in the button
+        BisubManager.getInstance(requireContext())
+                .attachButton(currentInfo, bisubButtonListener);
+        // BISUB-END
+
         updateTabs(info);
 
         animate(binding.detailThumbnailPlayButton, true, 200);
