+
+    /**
+     * Reads a numeric setting that the user may have typed as any text and
+     * clamps it into {@code [min, max]}, falling back to {@code fallback}
+     * when it is missing or not a number.
+     *
+     * @param prefs    the shared preferences to read from
+     * @param key      the preference key
+     * @param fallback value used when the setting is missing or unparsable
+     * @param min      lower bound, inclusive
+     * @param max      upper bound, inclusive
+     * @return the clamped value
+     */
+    private static int readIntInRange(@NonNull final SharedPreferences prefs,
+                                      @NonNull final String key, final int fallback,
+                                      final int min, final int max) {
+        final String raw = prefs.getString(key, null);
+        if (raw == null || raw.trim().isEmpty()) {
+            return fallback;
+        }
+        try {
+            final int value = Integer.parseInt(raw.trim());
+            return Math.max(min, Math.min(max, value));
+        } catch (final NumberFormatException e) {
+            return fallback;
+        }
     }
 }
