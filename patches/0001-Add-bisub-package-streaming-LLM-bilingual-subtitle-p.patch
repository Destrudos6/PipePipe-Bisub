+/**
+ * Orchestrates bilingual subtitle generation: pick a source subtitle track,
+ * download it, translate it with an LLM, compose a bilingual WebVTT file and
+ * cache the result on disk.
+ *
+ * <p>Generation is <b>manual and streaming</b>: the user triggers it from the
+ * video detail page, subtitle lines are translated in batches by a small pool
+ * of workers, and the cache file is rewritten after every batch that comes
+ * back. Attached {@link ButtonListener}s receive progress updates on the main
+ * thread, and a toast announces completion, so the user knows when to reopen
+ * the video. Once fully translated, the playback resolver appends the cached
+ * file to the player's subtitle selection as an extra track; nothing is
+ * replaced and playback never waits for a translation.</p>
+ *
+ * <p>All of this runs on dedicated daemon threads, because the playback
+ * loader that calls {@link #getCompletedBilingualSubtitle(StreamInfo)} must
+ * never be blocked or aborted by a translation. Interrupting the caller does
+ * not abort an in-flight translation either: the workers finish it and keep
+ * writing the cache file.</p>
+ */
+public final class BisubManager {
+
+    private static final String TAG = BisubManager.class.getSimpleName();
+    private static final String CACHE_DIR = "bisub";
+    /**
+     * Bump this whenever parsing or composition changes so that stale cache
+     * files from older builds are ignored (and deleted by the legacy cleaner).
+     */
+    private static final int CACHE_VERSION = 6;
+    /**
+     * Soft cap on unique subtitle lines per video. Lines beyond the cap keep
+     * their original text only. 2000 unique lines covers multi-hour videos.
+     */
+    private static final int MAX_UNIQUE_LINES = 2000;
+    /**
+     * How long the background generation may keep translating in total. The
+     * budget only stops batches that have not started yet. It is generous on
+     * purpose: generation is a manual action now, so the user expects even a
+     * multi-hour video to be translated completely (roughly 12 concurrent
+     * batches of 40 lines translate about 20k lines within this budget).
+     */
+    private static final long TOTAL_BUDGET_MS = 20 * 60_000;
+    /**
+     * Subtitle lines per translation batch (one LLM request).
+     */
+    private static final int BATCH_SIZE = 40;
+    /**
+     * Parallel LLM requests. Twelve concurrent batches translate a two-hour
+     * video in a few minutes; the missing-line retries in {@link BatchJob}
+     * absorb the occasional rate limit of stricter providers.
+     */
+    private static final int BATCH_POOL_SIZE = 12;
+    /**
+     * Delay before retrying a partially or fully failed batch.
+     */
+    private static final long BATCH_RETRY_DELAY_MS = 2_000;
+    /**
+     * How many times one batch is attempted in total. Each retry only
+     * re-sends the lines that are still missing, so a model reply with a
+     * truncated array no longer silently leaves whole minutes untranslated.
+     */
+    private static final int BATCH_MAX_ATTEMPTS = 3;
+    /**
+     * Display name (and player track language) of the bilingual track that
+     * the playback resolver appends to the subtitle selection menu once a
+     * translation is complete. The player menu shows this string verbatim
+     * and matches it exactly when the track is selected.
+     */
+    @NonNull
+    private static final String BILINGUAL_TRACK_LANGUAGE = "Bilingual（双语）";
+
+    /**
+     * Coordinates generation jobs (download, parse, dispatch, merge, write).
+     * Two slots are enough for the current video plus one preloaded
+     * neighbour; further videos simply queue.
+     */
+    private static final ExecutorService WORKER = Executors.newFixedThreadPool(2, runnable -> {
+        final Thread thread = new Thread(runnable, "bisub-coordinator");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    /**
+     * Runs the individual translation batches in parallel. Daemon threads,
+     * never interrupted by the player's RxJava disposal.
+     */
+    private static final ExecutorService SUBPOOL = Executors.newFixedThreadPool(
+            BATCH_POOL_SIZE, runnable -> {
+                final Thread thread = new Thread(runnable, "bisub-batch");
+                thread.setDaemon(true);
+                return thread;
+            });
+
+    /**
+     * Maps a cache key to the generation task currently producing it, so
+     * that repeated button taps and preloading never translate the same
+     * video twice.
+     */
+    private static final ConcurrentHashMap<String, Future<?>> IN_FLIGHT =
+            new ConcurrentHashMap<>();
+
+    /**
+     * Button listeners registered per cache key; invoked on the main thread.
+     */
+    private static final ConcurrentHashMap<String, CopyOnWriteArrayList<ButtonListener>>
+            LISTENERS = new ConcurrentHashMap<>();
+
+    /**
+     * Last known progress per cache key, so a listener attaching to an
+     * in-flight translation immediately sees the current counters.
+     */
+    private static final ConcurrentHashMap<String, int[]> LAST_PROGRESS =
+            new ConcurrentHashMap<>();
+
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+
+    private static volatile BisubManager sInstance;
+    private static volatile boolean sLegacyCacheCleaned = false;
+
+    @NonNull
+    private final Context appContext;
+
+    private BisubManager(@NonNull final Context context) {
+        this.appContext = context.getApplicationContext();
+    }
+
+    /**
+     * @param context any context
+     * @return the singleton instance
+     */
+    @NonNull
+    public static BisubManager getInstance(@NonNull final Context context) {
+        if (sInstance == null) {
+            synchronized (BisubManager.class) {
+                if (sInstance == null) {
+                    sInstance = new BisubManager(context);
+                }
+            }
+        }
+        return sInstance;
+    }
+
+    /**
+     * Callbacks driving the state of the detail page bilingual button. All
+     * methods are invoked on the main thread. The sequence is
+     * {@link #onUnavailable()} or {@link #onIdle()} first, then any number of
+     * {@link #onProgress(int, int)} while a translation runs, finally
+     * {@link #onFinished(boolean)} when it ends.
+     */
+    public interface ButtonListener {
+        /**
+         * The feature cannot be used at all (disabled, incomplete
+         * configuration, or no usable subtitle track): hide the button.
+         */
+        void onUnavailable();
+
+        /**
+         * Nothing is running for this video: show the button in its idle
+         * "generate" state, ready for a tap.
+         */
+        void onIdle();
+
+        /**
+         * A translation was just requested and is being prepared (subtitle
+         * download, parsing, dispatching the first batches). Sent
+         * immediately on the main thread so the user gets instant feedback
+         * for their tap; the first {@link #onProgress(int, int)} may still
+         * take a few seconds.
+         */
+        default void onStarting() { }
+
+        /**
+         * A translation is in progress.
+         *
+         * @param translated unique lines translated so far
+         * @param total      unique lines submitted overall
+         */
+        void onProgress(int translated, int total);
+
+        /**
+         * The translation ended. On success the bilingual track is cached
+         * and appears in the player's subtitle menu after reopening the
+         * video; on failure the button may offer a retry.
+         *
+         * @param success whether the complete bilingual file was written
+         */
+        void onFinished(boolean success);
+    }
+
+    /**
+     * Everything the generation pipeline needs for one video, derived once
+     * from the stream info and the current configuration.
+     */
+    private static final class CacheTarget {
+        @NonNull final String cacheKey;
+        @NonNull final File cacheFile;
+        @NonNull final File doneFile;
+        @NonNull final SubtitlesStream source;
+        @NonNull final BisubPrefs.Config cfg;
+
+        CacheTarget(@NonNull final String cacheKey, @NonNull final File cacheFile,
+                    @NonNull final File doneFile, @NonNull final SubtitlesStream source,
+                    @NonNull final BisubPrefs.Config cfg) {
+            this.cacheKey = cacheKey;
+            this.cacheFile = cacheFile;
+            this.doneFile = doneFile;
+            this.source = source;
+            this.cfg = cfg;
+        }
+    }
+
+    /**
+     * Resolves the cache files and the source track for a video based on the
+     * current configuration. The subtitle URL is deliberately not part of the
+     * key: YouTube signs its timedtext URLs with parameters that change
+     * between extractions, which would make the cache miss on every replay.
+     *
+     * @param info the stream info of the video
+     * @return the target, or {@code null} when bisub is disabled,
+     *         misconfigured, or the video has no usable subtitle track
+     */
+    @Nullable
+    private CacheTarget resolveCacheTarget(@NonNull final StreamInfo info) {
+        final BisubPrefs.Config cfg = BisubPrefs.load(appContext);
+        if (!cfg.isUsable()) {
+            Log.i(TAG, "Bisub is disabled or the configuration is incomplete, skipping");
+            return null;
+        }
+        // Only URL streams that are not delivered as torrents can be
+        // downloaded by the translator; embedded subtitle payloads are
+        // left to the regular player pipeline.
+        final List<SubtitlesStream> candidates = new ArrayList<>();
+        final List<SubtitlesStream> allSubtitles = info.getSubtitles();
+        if (allSubtitles != null) {
+            for (final SubtitlesStream stream : allSubtitles) {
+                if (stream.isUrl()
+                        && stream.getDeliveryMethod() != DeliveryMethod.TORRENT) {
+                    candidates.add(stream);
+                }
+            }
+        }
+        if (candidates.isEmpty()) {
+            Log.i(TAG, "This video has no usable URL subtitle tracks, skipping");
+            return null;
+        }
+        final SubtitlesStream source = pickStream(candidates, cfg.sourceLanguage);
+        final String cacheKey = sha256Hex(CACHE_VERSION + "|" + info.getId() + "|"
+                + source.getLanguageTag() + "|" + source.isAutoGenerated()
+                + "|" + cfg.model + "|" + cfg.targetLanguage);
+        final String fileName = "v" + CACHE_VERSION + "-" + cacheKey;
+        final File cacheFile = new File(new File(appContext.getFilesDir(), CACHE_DIR),
+                fileName + ".vtt");
+        final File doneFile = new File(cacheFile.getParentFile(), fileName + ".done");
+        return new CacheTarget(cacheKey, cacheFile, doneFile, source, cfg);
+    }
+
+    /**
+     * @param target the cache target to check
+     * @return whether the complete bilingual file is on disk
+     */
+    private static boolean isDone(@NonNull final CacheTarget target) {
+        return target.doneFile.exists()
+                && target.cacheFile.exists() && target.cacheFile.length() > 0;
+    }
+
+    /**
+     * Reports the current state of a video to a button listener without
+     * starting anything: unavailable, already done (immediate
+     * {@link ButtonListener#onFinished(boolean)}), running (the listener is
+     * attached and receives progress), or idle.
+     *
+     * @param info     the stream info of the video being viewed
+     * @param listener the listener to report to
+     */
+    public void attachButton(@NonNull final StreamInfo info,
+                             @NonNull final ButtonListener listener) {
+        cleanLegacyCacheOnce();
+        final CacheTarget target = resolveCacheTarget(info);
+        if (target == null) {
+            listener.onUnavailable();
+            return;
+        }
+        if (isDone(target)) {
+            listener.onFinished(true);
+            return;
+        }
+        if (!IN_FLIGHT.containsKey(target.cacheKey)) {
+            listener.onIdle();
+            return;
+        }
+        registerListener(target, listener);
+    }
+
+    /**
+     * Starts (or joins) the background translation of a video's subtitles
+     * and attaches a button listener to it. Idempotent: joining an
+     * in-flight or already finished translation never starts a second one.
+     *
+     * @param info     the stream info of the video to translate
+     * @param listener the listener receiving progress and the final result
+     */
+    public void startTranslation(@NonNull final StreamInfo info,
+                                 @NonNull final ButtonListener listener) {
+        cleanLegacyCacheOnce();
+        final CacheTarget target = resolveCacheTarget(info);
+        if (target == null) {
+            listener.onUnavailable();
+            return;
+        }
+        if (isDone(target)) {
+            listener.onFinished(true);
+            return;
+        }
+        final boolean alreadyRunning = IN_FLIGHT.containsKey(target.cacheKey);
+        registerListener(target, listener);
+        if (!alreadyRunning) {
+            MAIN.post(listener::onStarting);
+        }
+        IN_FLIGHT.computeIfAbsent(target.cacheKey, key -> WORKER.submit(() -> {
+            try {
+                generateAndCache(target);
+            } catch (final Exception e) {
+                Log.w(TAG, "Bilingual subtitle generation failed", e);
+                notifyFinished(key, false);
+            } finally {
+                IN_FLIGHT.remove(key);
+            }
+        }));
+    }
+
+    /**
+     * Removes a listener from every translation it is attached to. Callers
+     * must invoke this when their view hierarchy goes away, because the
+     * listener registry outlives individual fragments.
+     *
+     * @param listener the listener to detach
+     */
+    public void detachButton(@NonNull final ButtonListener listener) {
+        for (final CopyOnWriteArrayList<ButtonListener> list : LISTENERS.values()) {
+            list.remove(listener);
+        }
+    }
+
+    /**
+     * Returns the completed bilingual subtitle file of a video, if one is
+     * cached. This only reads disk and never starts or waits for a
+     * translation, so the playback resolver can call it freely.
+     *
+     * @param info the stream info of the video being resolved
+     * @return the local bilingual WebVTT file, or {@code null}
+     */
+    @Nullable
+    public Uri getCompletedBilingualSubtitle(@NonNull final StreamInfo info) {
+        final CacheTarget target = resolveCacheTarget(info);
+        if (target == null || !isDone(target)) {
+            return null;
+        }
+        Log.i(TAG, "Bilingual subtitle cache hit: " + target.cacheFile.getName()
+                + " (" + info.getId() + ")");
+        return Uri.fromFile(target.cacheFile);
+    }
+
+    /**
+     * Registers a listener for a cache key and immediately replays the last
+     * known progress of an in-flight translation to it.
+     *
+     * @param target   the cache target to listen to
+     * @param listener the listener to register
+     */
+    private static void registerListener(@NonNull final CacheTarget target,
+                                         @NonNull final ButtonListener listener) {
+        final CopyOnWriteArrayList<ButtonListener> list = LISTENERS.computeIfAbsent(
+                target.cacheKey, key -> new CopyOnWriteArrayList<>());
+        // A listener re-tapping the button must not be registered twice,
+        // otherwise it would receive every callback twice.
+        list.remove(listener);
+        list.add(listener);
+        final int[] progress = LAST_PROGRESS.get(target.cacheKey);
+        if (progress != null) {
+            MAIN.post(() -> listener.onProgress(progress[0], progress[1]));
+        }
+    }
+
+    /**
+     * Downloads, parses, translates and caches one bilingual subtitle file.
+     * Runs on a dedicated coordinator thread, never on the player's threads.
+     * The cache file is rewritten after every finished batch, but it only
+     * becomes visible to playback once the done marker exists.
+     *
+     * @param target the cache target to produce
+     * @throws IOException when downloading or writing fails
+     */
+    private void generateAndCache(@NonNull final CacheTarget target) throws IOException {
+        final long deadline = System.currentTimeMillis() + TOTAL_BUDGET_MS;
+        final String original = downloadSubtitle(target.source.getContent());
+        List<VttParser.Cue> cues = VttParser.parse(original);
+        if (cues.isEmpty()) {
+            Log.i(TAG, "Subtitle track could not be parsed into any cues (format="
+                    + target.source.getFormat() + ", auto=" + target.source.isAutoGenerated()
+                    + "), skipping");
+            notifyFinished(target.cacheKey, false);
+            return;
+        }
+        // Auto-generated tracks use rolling windows: adjacent cues overlap in
+        // time and often repeat the same text, which a subtitle renderer draws
+        // stacked on top of each other. Merging keeps one steady cue, and the
+        // de-overlap pass then makes sure that never more than one cue is on
+        // screen at any moment, so bilingual lines stay readable.
+        cues = mergeIdenticalOverlappingCues(cues);
+        cues = deOverlapCues(cues);
+        logCueStructure(cues, target.source);
+
+        // Deduplicate cue texts (auto-generated subtitles repeat lines a lot)
+        final Map<String, String> translationMap = new LinkedHashMap<>();
+        final List<String> uniqueTexts = new ArrayList<>();
+        for (final VttParser.Cue cue : cues) {
+            if (!translationMap.containsKey(cue.joinedText())) {
+                translationMap.put(cue.joinedText(), cue.joinedText());
+                uniqueTexts.add(cue.joinedText());
+            }
+        }
+        final List<String> toTranslate =
+                uniqueTexts.subList(0, Math.min(uniqueTexts.size(), MAX_UNIQUE_LINES));
+
+        // Submit every batch at once: the pool size caps the real
+        // parallelism and the queue order keeps the beginning of the video
+        // first in line, so progress reported to the user grows linearly.
+        final List<Future<Map<String, String>>> futures = new ArrayList<>();
+        for (int start = 0; start < toTranslate.size(); start += BATCH_SIZE) {
+            final List<String> batch =
+                    toTranslate.subList(start, Math.min(start + BATCH_SIZE, toTranslate.size()));
+            futures.add(SUBPOOL.submit(new BatchJob(batch, target.cfg, deadline)));
+        }
+
+        // Results are merged strictly in submission order, even though the
+        // batches finish in a random order: the cache file is always a
+        // "prefix" of the video. A slow batch briefly delays later writes,
+        // but the user already sees progress in the detail page.
+        int translatedCount = 0;
+        for (final Future<Map<String, String>> future : futures) {
+            final Map<String, String> part;
+            try {
+                part = future.get();
+            } catch (final InterruptedException e) {
+                Thread.currentThread().interrupt();
+                Log.w(TAG, "Bilingual generation interrupted, keeping what was "
+                        + "written so far");
+                return;
+            } catch (final ExecutionException e) {
+                // BatchJob never lets exceptions escape, but get() declares
+                // this checked exception anyway; treat it as an empty batch.
+                Log.w(TAG, "Unexpected batch execution failure", e.getCause());
+                continue;
+            }
+            if (part.isEmpty()) {
+                continue;
+            }
+            translationMap.putAll(part);
+            translatedCount += part.size();
+            atomicWriteCache(target.cacheFile, VttParser.composeBilingual(cues, translationMap));
+            notifyProgress(target.cacheKey, translatedCount, toTranslate.size());
+            Log.i(TAG, "Bilingual subtitle progress: " + translatedCount + "/"
+                    + toTranslate.size() + " unique lines translated");
+        }
+
+        atomicWriteCache(target.doneFile, "");
+        notifyFinished(target.cacheKey, true);
+        Log.i(TAG, "Bilingual subtitles generated: " + translatedCount + "/"
+                + toTranslate.size() + " lines translated (" + target.cacheFile.getName() + ")");
+        notifyReady(appContext, translatedCount, toTranslate.size());
+    }
+
+    /**
+     * Forwards a progress update to every attached listener of a cache key,
+     * on the main thread, and remembers it for listeners attaching later.
+     *
+     * @param cacheKey   the cache key the progress belongs to
+     * @param translated unique lines translated so far
+     * @param total      unique lines submitted overall
+     */
+    private static void notifyProgress(@NonNull final String cacheKey, final int translated,
+                                       final int total) {
+        LAST_PROGRESS.put(cacheKey, new int[]{translated, total});
+        final List<ButtonListener> list = LISTENERS.get(cacheKey);
+        if (list != null) {
+            MAIN.post(() -> {
+                for (final ButtonListener listener : list) {
+                    listener.onProgress(translated, total);
+                }
+            });
+        }
+    }
+
+    /**
+     * Ends the translation session of a cache key: forgets its progress and
+     * delivers the final result to every attached listener, on the main
+     * thread.
+     *
+     * @param cacheKey the cache key that finished
+     * @param success  whether the complete bilingual file was written
+     */
+    private static void notifyFinished(@NonNull final String cacheKey, final boolean success) {
+        LAST_PROGRESS.remove(cacheKey);
+        final List<ButtonListener> list = LISTENERS.remove(cacheKey);
+        if (list != null) {
+            MAIN.post(() -> {
+                for (final ButtonListener listener : list) {
+                    listener.onFinished(success);
+                }
+            });
+        }
+    }
+
+    /**
+     * Merges adjacent cues that carry the same text and overlap (or touch)
+     * in time into a single cue that spans both. Auto-generated tracks use
+     * rolling windows in which the same text reappears in cue after cue with
+     * overlapping timings; rendering those verbatim makes a subtitle renderer
+     * draw identical lines stacked on top of each other.
+     *
+     * @param cues parsed cues in document (time) order
+     * @return cues with identical adjacent duplicates merged
+     */
+    @NonNull
+    private static List<VttParser.Cue> mergeIdenticalOverlappingCues(
+            @NonNull final List<VttParser.Cue> cues) {
+        final List<VttParser.Cue> merged = new ArrayList<>();
+        for (final VttParser.Cue cue : cues) {
+            if (!merged.isEmpty()) {
+                final VttParser.Cue last = merged.get(merged.size() - 1);
+                if (last.joinedText().equals(cue.joinedText())
+                        && cue.startMs <= last.endMs) {
+                    merged.set(merged.size() - 1, new VttParser.Cue(last.startMs,
+                            Math.max(last.endMs, cue.endMs), last.lines));
+                    continue;
+                }
+            }
+            merged.add(cue);
+        }
+        return merged;
+    }
+
+    /**
+     * Truncates each cue at the start of its successor so that no two cues
+     * overlap in time. Auto-generated tracks use rolling windows in which
+     * several cues are active at the same moment and a subtitle renderer
+     * draws all of them stacked on top of each other, which makes every
+     * line unreadable. Cues sharing the same start time are collapsed to
+     * the one that stays on screen longest; every other cue is cut at the
+     * next cue's start. This keeps exactly one cue (original line above
+     * its translation) on screen at any moment while preserving the
+     * original cue order and text.
+     *
+     * @param cues parsed cues in document (time) order
+     * @return cues whose end times no longer cross into the following cue
+     */
+    @NonNull
+    private static List<VttParser.Cue> deOverlapCues(
+            @NonNull final List<VttParser.Cue> cues) {
+        final List<VttParser.Cue> result = new ArrayList<>(cues.size());
+        int i = 0;
+        while (i < cues.size()) {
+            // Cues starting at the same moment would be rendered stacked
+            // on top of each other; keep only the longest-lived one (the
+            // later one on ties, as rolling windows update over time).
+            VttParser.Cue kept = cues.get(i);
+            int j = i + 1;
+            while (j < cues.size() && cues.get(j).startMs == kept.startMs) {
+                if (cues.get(j).endMs >= kept.endMs) {
+                    kept = cues.get(j);
+                }
+                j++;
+            }
+            long endMs = kept.endMs;
+            if (j < cues.size()) {
+                final long nextStartMs = cues.get(j).startMs;
+                // Only shorten when the successor starts later but still
+                // within this cue; unsorted input is left untouched
+                // instead of producing an unrenderable zero-length cue.
+                if (nextStartMs > kept.startMs && nextStartMs < endMs) {
+                    endMs = nextStartMs;
+                }
+            }
+            result.add(new VttParser.Cue(kept.startMs, endMs, kept.lines));
+            i = j;
+        }
+        return result;
+    }
+
+    /**
+     * Logs the parsed cue structure to make rolling-window formats
+     * diagnosable from a device log alone.
+     *
+     * @param cues   the cues that will be composed
+     * @param source the track the cues were parsed from
+     */
+    private static void logCueStructure(@NonNull final List<VttParser.Cue> cues,
+                                        @NonNull final SubtitlesStream source) {
+        int overlappingPairs = 0;
+        long longestOverlapMs = 0;
+        for (int i = 1; i < cues.size(); i++) {
+            final long overlap = cues.get(i - 1).endMs - cues.get(i).startMs;
+            if (overlap > 0) {
+                overlappingPairs++;
+                longestOverlapMs = Math.max(longestOverlapMs, overlap);
+            }
+        }
+        Log.i(TAG, "Parsed " + cues.size() + " cues (" + overlappingPairs
+                + " overlapping pairs, longest overlap " + longestOverlapMs
+                + " ms, auto=" + source.isAutoGenerated() + ")");
+    }
+
+    /**
+     * Translates one batch on the shared batch pool. Lines that a model
+     * reply left out (a truncated array, for example) or that failed with
+     * an error are re-sent in follow-up requests until they are translated
+     * or the attempt budget is exhausted, so an incomplete reply no longer
+     * silently leaves whole minutes of a video untranslated. Batches that
+     * only start after the deadline has passed return no translations.
+     */
+    private static final class BatchJob implements Callable<Map<String, String>> {
+        @NonNull private final List<String> batch;
+        @NonNull private final BisubPrefs.Config cfg;
+        private final long deadline;
+
+        BatchJob(@NonNull final List<String> batch,
+                 @NonNull final BisubPrefs.Config cfg, final long deadline) {
+            this.batch = batch;
+            this.cfg = cfg;
+            this.deadline = deadline;
+        }
+
+        @Override
+        public Map<String, String> call() {
+            final Map<String, String> translated = new HashMap<>();
+            final List<String> remaining = new ArrayList<>(batch);
+            for (int attempt = 1; attempt <= BATCH_MAX_ATTEMPTS
+                    && !remaining.isEmpty(); attempt++) {
+                if (attempt > 1) {
+                    try {
+                        Thread.sleep(BATCH_RETRY_DELAY_MS);
+                    } catch (final InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        break;
+                    }
+                    if (System.currentTimeMillis() >= deadline) {
+                        Log.w(TAG, "Translation budget exhausted, keeping the "
+                                + "original text for the remaining " + remaining.size()
+                                + " lines");
+                        break;
+                    }
+                }
+                try {
+                    final Map<String, String> part =
+                            SubtitleTranslator.translateBatch(remaining, cfg);
+                    for (final Map.Entry<String, String> entry : part.entrySet()) {
+                        translated.put(entry.getKey(), entry.getValue());
+                        remaining.remove(entry.getKey());
+                    }
+                } catch (final Exception e) {
+                    Log.w(TAG, "Translation attempt " + attempt + " of a "
+                            + batch.size() + "-line batch failed (" + remaining.size()
+                            + " lines still missing)", e);
+                }
+            }
+            if (!remaining.isEmpty()) {
+                Log.w(TAG, "Translation batch incomplete after " + BATCH_MAX_ATTEMPTS
+                        + " attempts, keeping the original text for " + remaining.size()
+                        + " of " + batch.size() + " lines");
+            }
+            return translated;
+        }
+    }
+
+    /**
+     * Tells the user that a translation just finished, including how much of
+     * the video is covered, so that they know to reopen the video for the
+     * bilingual track to appear in the subtitle menu.
+     *
+     * @param context    the application context used for the toast
+     * @param translated number of unique lines that were translated
+     * @param total      number of unique lines that were submitted
+     */
+    private static void notifyReady(@NonNull final Context context,
+                                    final int translated, final int total) {
+        MAIN.post(() -> Toast.makeText(context,
+                context.getString(R.string.bisub_toast_ready, translated, total,
+                        BILINGUAL_TRACK_LANGUAGE),
+                Toast.LENGTH_LONG).show());
+    }
+
+    /**
+     * Deletes cache files written by older cache versions. Runs once per
+     * process; cheap because the directory only ever holds a few files.
+     */
+    private void cleanLegacyCacheOnce() {
+        if (sLegacyCacheCleaned) {
+            return;
+        }
+        synchronized (BisubManager.class) {
+            if (sLegacyCacheCleaned) {
+                return;
+            }
+            sLegacyCacheCleaned = true;
+        }
+        final File dir = new File(appContext.getFilesDir(), CACHE_DIR);
+        final File[] files = dir.listFiles();
+        if (files == null) {
+            return;
+        }
+        final String keepPrefix = "v" + CACHE_VERSION + "-";
+        int removed = 0;
+        for (final File file : files) {
+            if (!file.getName().startsWith(keepPrefix) && file.delete()) {
+                removed++;
+            }
+        }
+        if (removed > 0) {
+            Log.i(TAG, "Removed " + removed + " legacy bisub cache file(s) "
+                    + "from older cache versions");
+        }
+    }
+
+    @NonNull
+    private static SubtitlesStream pickStream(@NonNull final List<SubtitlesStream> candidates,
+                                              @Nullable final String preferredLanguage) {
+        if (preferredLanguage == null || preferredLanguage.trim().isEmpty()) {
+            return firstNonAutoTrack(candidates);
+        }
+        final String prefix = preferredLanguage.trim().toLowerCase(Locale.ROOT);
+        // Prefer manually created tracks over auto-generated ones
+        SubtitlesStream autoMatch = null;
+        for (final SubtitlesStream stream : candidates) {
+            final String code = stream.getLanguageTag();
+            if (code != null && code.toLowerCase(Locale.ROOT).startsWith(prefix)) {
+                if (!stream.isAutoGenerated()) {
+                    return stream;
+                }
+                if (autoMatch == null) {
+                    autoMatch = stream;
+                }
+            }
+        }
+        if (autoMatch != null) {
+            return autoMatch;
+        }
+        // No track matches the preferred source language: fall back to the
+        // first usable track instead of giving up entirely, so that videos
+        // in any language still get bilingual subtitles.
+        Log.i(TAG, "No subtitle track matches preferred language '" + prefix
+                + "', falling back to the first available track");
+        return firstNonAutoTrack(candidates);
+    }
+
+    @NonNull
+    private static SubtitlesStream firstNonAutoTrack(
+            @NonNull final List<SubtitlesStream> candidates) {
+        for (final SubtitlesStream stream : candidates) {
+            if (!stream.isAutoGenerated()) {
+                return stream;
+            }
+        }
+        return candidates.get(0);
+    }
+
+    @NonNull
+    private static String downloadSubtitle(@NonNull final String url) throws IOException {
+        final Response response;
+        try {
+            response = DownloaderImpl.getInstance().get(url);
+        } catch (final ReCaptchaException e) {
+            // Subtitle downloads hitting a reCaptcha just mean no bilingual
+            // subtitles for this video; the button reports a failure.
+            throw new IOException("ReCaptcha challenge while downloading subtitle", e);
+        }
+        final String body = response.responseBody();
+        if (body == null || body.isEmpty()) {
+            throw new IOException("Empty subtitle response for " + url);
+        }
+        return body;
+    }
+
+    /**
+     * Writes content to the file via a temporary file and an atomic move, so
+     * that a player concurrently reading the previous version never observes
+     * a half-written document.
+     *
+     * @param file    the file to (over)write
+     * @param content the new content
+     * @throws IOException when writing fails
+     */
+    private static void atomicWriteCache(@NonNull final File file, @NonNull final String content)
+            throws IOException {
+        final File parent = file.getParentFile();
+        if (parent != null && !parent.exists() && !parent.mkdirs()) {
+            throw new IOException("Could not create bisub cache directory");
+        }
+        final File tmp = new File(parent, file.getName() + ".tmp");
+        Files.write(tmp.toPath(), content.getBytes(StandardCharsets.UTF_8));
+        try {
+            Files.move(tmp.toPath(), file.toPath(), StandardCopyOption.REPLACE_EXISTING,
+                    StandardCopyOption.ATOMIC_MOVE);
+        } catch (final IOException e) {
+            // Some file systems do not support atomic moves: fall back to a
+            // plain replace, which is still safe enough for these small files.
+            Files.move(tmp.toPath(), file.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+
+    @NonNull
+    private static String sha256Hex(@NonNull final String input) {
+        try {
+            final MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            final byte[] hash = digest.digest(input.getBytes(StandardCharsets.UTF_8));
+            final StringBuilder sb = new StringBuilder();
+            for (final byte b : hash) {
+                sb.append(String.format(Locale.US, "%02x", b));
+            }
+            return sb.substring(0, 16);
+        } catch (final NoSuchAlgorithmException e) {
+            // SHA-256 is guaranteed to be available on Android
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /**
+     * @return the MIME type of the generated bilingual subtitle files
+     */
+    @NonNull
+    public static String subtitleMimeType() {
+        return "text/vtt";
+    }
+
+    /**
+     * @return the language string (and menu label) of the bilingual track
+     *         that the playback resolver appends to the player's subtitle
+     *         selection
+     */
+    @NonNull
+    public static String bilingualTrackLanguage() {
+        return BILINGUAL_TRACK_LANGUAGE;
+    }
+}
