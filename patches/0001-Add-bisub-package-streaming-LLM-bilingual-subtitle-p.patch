@@ -0,0 +1,174 @@
+package org.schabi.newpipe.bisub;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.PreferenceManager;
+
+import org.schabi.newpipe.R;
+
+/**
+ * Reads and validates the bilingual subtitle ("bisub") user configuration
+ * from the default shared preferences.
+ */
+public final class BisubPrefs {
+
+    private BisubPrefs() { }
+
+    /**
+     * Immutable snapshot of all bisub-related settings.
+     */
+    public static final class Config {
+        public final boolean enabled;
+        @Nullable public final String provider;
+        @Nullable public final String baseUrl;
+        @Nullable public final String apiKey;
+        @Nullable public final String model;
+        @Nullable public final String targetLanguage;
+        @Nullable public final String sourceLanguage;
+
+        private Config(final boolean enabled, @Nullable final String provider,
+                       @Nullable final String baseUrl, @Nullable final String apiKey,
+                       @Nullable final String model, @Nullable final String targetLanguage,
+                       @Nullable final String sourceLanguage) {
+            this.enabled = enabled;
+            this.provider = provider;
+            this.baseUrl = baseUrl;
+            this.apiKey = apiKey;
+            this.model = model;
+            this.targetLanguage = targetLanguage;
+            this.sourceLanguage = sourceLanguage;
+        }
+
+        /**
+         * @return true when every field required to call a translation API is present
+         */
+        public boolean isUsable() {
+            return enabled && !isNullOrBlank(baseUrl) && !isNullOrBlank(apiKey)
+                    && !isNullOrBlank(model) && !isNullOrBlank(targetLanguage);
+        }
+
+        private static boolean isNullOrBlank(@Nullable final String s) {
+            return s == null || s.trim().isEmpty();
+        }
+    }
+
+    /**
+     * Immutable snapshot of the in-app bilingual subtitle style. It replaces
+     * the Android system caption style (which is unreachable on systems that
+     * ship without the Android caption settings, e.g. HarmonyOS) and is only
+     * applied while the bilingual track is selected.
+     */
+    public static final class Style {
+        /** Overall scale of the whole subtitle block: text, padding and
+         *  corner radius all grow with it, like resizing the outer
+         *  component that contains both language layers. */
+        public final float baseScale;
+        /** Text color, ARGB. */
+        public final int textColor;
+        /** One of {@link BisubStyle#BG_TRANSLUCENT}, {@link BisubStyle#BG_OPAQUE},
+         *  {@link BisubStyle#BG_NONE}. */
+        public final int backgroundMode;
+        /** Padding between the text and the background block edge, in dp. */
+        public final float paddingDp;
+        /** Background corner radius in dp; 0 means square corners. */
+        public final float cornerRadiusDp;
+        /** Maximum text width as a fraction of the view width (0.5-1.0).
+         *  Larger values wrap later, up to single lines spanning the screen. */
+        public final float maxWidthPercent;
+        /** Distance between the subtitle block and the bottom of the view,
+         *  as a fraction of the view height (0.0-0.3). */
+        public final float positionPercent;
+
+        @SuppressWarnings("checkstyle:ParameterNumber")
+        public Style(final float baseScale, final int textColor, final int backgroundMode,
+                     final float paddingDp, final float cornerRadiusDp,
+                     final float maxWidthPercent, final float positionPercent) {
+            this.baseScale = baseScale;
+            this.textColor = textColor;
+            this.backgroundMode = backgroundMode;
+            this.paddingDp = paddingDp;
+            this.cornerRadiusDp = cornerRadiusDp;
+            this.maxWidthPercent = maxWidthPercent;
+            this.positionPercent = positionPercent;
+        }
+    }
+
+    /**
+     * Loads the in-app bilingual subtitle style.
+     *
+     * @param context any context
+     * @return the current style, never {@code null}
+     */
+    @NonNull
+    public static Style loadStyle(@NonNull final Context context) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        return new Style(
+                prefs.getFloat(context.getString(R.string.bisub_style_base_scale_key),
+                        BisubStyle.DEFAULT_BASE_SCALE),
+
+                prefs.getInt(context.getString(R.string.bisub_style_text_color_key),
+                        BisubStyle.DEFAULT_TEXT_COLOR),
+                prefs.getInt(context.getString(R.string.bisub_style_background_key),
+                        BisubStyle.BG_TRANSLUCENT),
+                prefs.getFloat(context.getString(R.string.bisub_style_padding_key),
+                        BisubStyle.DEFAULT_PADDING_DP),
+                prefs.getFloat(context.getString(R.string.bisub_style_corner_radius_key),
+                        BisubStyle.DEFAULT_CORNER_RADIUS_DP),
+                prefs.getFloat(context.getString(R.string.bisub_style_max_width_key),
+                        BisubStyle.DEFAULT_MAX_WIDTH_PERCENT),
+                prefs.getFloat(context.getString(R.string.bisub_style_position_key),
+                        BisubStyle.DEFAULT_POSITION_PERCENT));
+    }
+
+    /**
+     * Persists the in-app bilingual subtitle style.
+     *
+     * @param context any context
+     * @param style   the style to save
+     */
+    public static void saveStyle(@NonNull final Context context, @NonNull final Style style) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        final SharedPreferences.Editor editor = prefs.edit();
+        editor.putFloat(context.getString(R.string.bisub_style_base_scale_key),
+                style.baseScale);
+
+        editor.putInt(context.getString(R.string.bisub_style_text_color_key),
+                style.textColor);
+        editor.putInt(context.getString(R.string.bisub_style_background_key),
+                style.backgroundMode);
+        editor.putFloat(context.getString(R.string.bisub_style_padding_key),
+                style.paddingDp);
+        editor.putFloat(context.getString(R.string.bisub_style_corner_radius_key),
+                style.cornerRadiusDp);
+        editor.putFloat(context.getString(R.string.bisub_style_max_width_key),
+                style.maxWidthPercent);
+        editor.putFloat(context.getString(R.string.bisub_style_position_key),
+                style.positionPercent);
+        editor.apply();
+    }
+
+    /**
+     * Loads the current bisub configuration.
+     *
+     * @param context any context; only the application context is retained indirectly
+     * @return a snapshot of the current settings
+     */
+    @NonNull
+    public static Config load(@NonNull final Context context) {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        return new Config(
+                prefs.getBoolean(context.getString(R.string.bisub_enable_key), false),
+                prefs.getString(context.getString(R.string.bisub_provider_key), null),
+                prefs.getString(context.getString(R.string.bisub_base_url_key), null),
+                prefs.getString(context.getString(R.string.bisub_api_key_key), null),
+                prefs.getString(context.getString(R.string.bisub_model_key), null),
+                prefs.getString(context.getString(R.string.bisub_target_lang_key), null),
+                prefs.getString(context.getString(R.string.bisub_source_lang_key), null));
+    }
+}
