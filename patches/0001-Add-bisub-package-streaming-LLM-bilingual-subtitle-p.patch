--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/SubtitleTranslator.java
@@ -0,0 +1,241 @@
+package org.schabi.newpipe.bisub;
+
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.schabi.newpipe.bisub.BisubPrefs.Config;
+
+import java.io.IOException;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Translates subtitle lines in batches by calling an OpenAI-compatible
+ * chat completion endpoint (OpenAI, DeepSeek, Moonshot, GLM, OpenRouter, ...).
+ *
+ * <p>Translations are requested as a strict JSON array so that the result can
+ * be aligned back to the input by index. When the model returns fewer items
+ * than requested, the missing entries simply fall back to the original text.</p>
+ */
+public final class SubtitleTranslator {
+
+    private static final String TAG = SubtitleTranslator.class.getSimpleName();
+    private static final MediaType JSON = MediaType.parse("application/json; charset=utf-8");
+    private static final int PER_BATCH_TIMEOUT_SECONDS = 60;
+
+    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
+            .connectTimeout(20, TimeUnit.SECONDS)
+            .readTimeout(PER_BATCH_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+            .writeTimeout(20, TimeUnit.SECONDS)
+            .build();
+
+    private SubtitleTranslator() { }
+
+    /**
+     * Translates one batch of texts using the provided configuration, in a
+     * single chat completion request. Batch scheduling (size, parallelism,
+     * retries, budget) is handled by the caller.
+     *
+     * @param batch the unique subtitle texts of one batch
+     * @param cfg   the user configuration (must be usable)
+     * @return a map from original text to translated text; texts that the
+     *         model did not translate are absent from the map
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when the response cannot be parsed
+     */
+    @NonNull
+    static Map<String, String> translateBatch(@NonNull final List<String> batch,
+                                              @NonNull final Config cfg)
+            throws IOException, JSONException {
+        final Map<String, String> result = new HashMap<>();
+
+        final JSONObject payload = buildPayload(batch, cfg);
+        final Request request = new Request.Builder()
+                .url(normalizeEndpoint(cfg.baseUrl))
+                .header("Authorization", "Bearer " + cfg.apiKey.trim())
+                .header("Content-Type", "application/json")
+                .post(RequestBody.create(payload.toString(), JSON))
+                .build();
+
+        try (Response response = CLIENT.newCall(request).execute()) {
+            final String body = response.body() == null ? "" : response.body().string();
+            if (!response.isSuccessful()) {
+                throw new IOException("Translation API returned HTTP " + response.code()
+                        + describeErrorBody(body));
+            }
+            final String content = extractContent(body);
+            final JSONArray translations = extractTranslations(content, batch.size());
+            if (translations.length() < batch.size()) {
+                Log.w(TAG, "Translation response contained " + translations.length()
+                        + " of " + batch.size() + " expected items, missing lines "
+                        + "fall back to the original text");
+            }
+
+            for (int i = 0; i < batch.size() && i < translations.length(); i++) {
+                final String translated = translations.optString(i, "").trim();
+                if (!translated.isEmpty()) {
+                    result.put(batch.get(i), translated);
+                }
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Extracts a short human-readable reason from an error response body.
+     * OpenAI-compatible APIs usually reply with
+     * {@code {"error":{"message":"..."}}} which is shown verbatim.
+     *
+     * @param body the raw error response body, possibly empty
+     * @return a suffix like ": invalid api key" or an empty string
+     */
+    @NonNull
+    private static String describeErrorBody(@Nullable final String body) {
+        if (body == null || body.trim().isEmpty()) {
+            return "";
+        }
+        try {
+            final JSONObject root = new JSONObject(body);
+            final String message = root.optJSONObject("error") != null
+                    ? root.optJSONObject("error").optString("message", "") : "";
+            if (!message.trim().isEmpty()) {
+                return ": " + message.trim();
+            }
+        } catch (final JSONException ignored) {
+            // Not JSON: fall back to the raw body below
+        }
+        final String raw = body.trim();
+        return ": " + (raw.length() > 200 ? raw.substring(0, 200) + "…" : raw);
+    }
+
+    @NonNull
+    private static JSONObject buildPayload(@NonNull final List<String> batch,
+                                           @NonNull final Config cfg) throws JSONException {
+        final JSONArray lines = new JSONArray();
+        for (final String text : batch) {
+            lines.put(text);
+        }
+
+        final String systemPrompt = "You are a professional subtitle translator. "
+                + "Translate every subtitle line from its original language into "
+                + cfg.targetLanguage + ". Keep translations natural, concise and "
+                + "suitable for subtitles. Preserve names, numbers and tone. "
+                + "Use the context of the whole list to keep wording consistent. "
+                + "Reply with ONLY a JSON object of the exact form "
+                + "{\"t\":[\"translation 1\",\"translation 2\",...]} containing exactly "
+                + batch.size() + " items, in the same order as the input. "
+                + "Do not add any other text.";
+
+        final JSONObject userMsg = new JSONObject();
+        userMsg.put("lines", lines);
+
+        final JSONArray messages = new JSONArray();
+        messages.put(new JSONObject().put("role", "system").put("content", systemPrompt));
+        messages.put(new JSONObject().put("role", "user").put("content", userMsg.toString()));
+
+        final JSONObject payload = new JSONObject();
+        payload.put("model", cfg.model.trim());
+        payload.put("messages", messages);
+        payload.put("temperature", 0.3);
+        return payload;
+    }
+
+    @Nullable
+    private static String extractContent(@NonNull final String responseBody)
+            throws JSONException {
+        final JSONObject root = new JSONObject(responseBody);
+        final JSONArray choices = root.optJSONArray("choices");
+        if (choices == null || choices.length() == 0) {
+            return null;
+        }
+        return choices.getJSONObject(0).getJSONObject("message").optString("content", null);
+    }
+
+    @NonNull
+    private static JSONArray extractTranslations(@Nullable final String content,
+                                                 final int expectedSize) throws JSONException {
+        if (content == null) {
+            return new JSONArray();
+        }
+        // The model may wrap the JSON in a markdown code fence
+        String cleaned = content.trim();
+        if (cleaned.startsWith("```")) {
+            final int first = cleaned.indexOf('\n');
+            final int last = cleaned.lastIndexOf("```");
+            if (first >= 0 && last > first) {
+                cleaned = cleaned.substring(first + 1, last).trim();
+            }
+        }
+        final JSONObject parsed = new JSONObject(cleaned);
+        final JSONArray t = parsed.optJSONArray("t");
+        if (t != null) {
+            return t;
+        }
+        Log.w(TAG, "Translation response did not contain the expected \"t\" array");
+        return new JSONArray();
+    }
+
+    /**
+     * Sends a one-line probe request through the full translation pipeline
+     * so that the settings screen can verify the provider configuration.
+     *
+     * @param cfg the user configuration (must be usable)
+     * @return the translated probe text, for display to the user
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when the response cannot be parsed
+     */
+    @NonNull
+    public static String testConnection(@NonNull final Config cfg)
+            throws IOException, JSONException {
+        final List<String> probe = Collections.singletonList(
+                "Hello, this is a connection test.");
+        final Map<String, String> result = translateBatch(probe, cfg);
+        final String translated = result.get(probe.get(0));
+        if (translated == null || translated.trim().isEmpty()) {
+            throw new IOException("The API responded but returned no translation, "
+                    + "please check the model name");
+        }
+        return translated;
+    }
+
+    /**
+     * Normalizes a user-provided base URL into a full chat completion endpoint.
+     * For example "https://api.deepseek.com" becomes
+     * "https://api.deepseek.com/v1/chat/completions".
+     *
+     * @param baseUrl the user-provided base URL
+     * @return the full chat completion endpoint URL
+     */
+    @NonNull
+    static String normalizeEndpoint(@Nullable final String baseUrl) throws IOException {
+        String url = baseUrl == null ? "" : baseUrl.trim();
+        if (url.isEmpty()) {
+            throw new IOException("Empty translation API base URL");
+        }
+        while (url.endsWith("/")) {
+            url = url.substring(0, url.length() - 1);
+        }
+        if (url.endsWith("/chat/completions")) {
+            return url;
+        }
+        if (url.endsWith("/v1")) {
+            return url + "/chat/completions";
+        }
+        return url + "/v1/chat/completions";
+    }
+}
