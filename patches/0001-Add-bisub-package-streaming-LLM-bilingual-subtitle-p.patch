index 000000000..a079ca45b
--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/VttParser.java
@@ -0,0 +1,364 @@
+package org.schabi.newpipe.bisub;
+
+import android.util.Xml;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.xmlpull.v1.XmlPullParser;
+
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Minimal subtitle parser and composer.
+ *
+ * <p>Both WebVTT and YouTube-flavored TTML are supported because NewPipe's
+ * YouTube extractor hands out TTML tracks by default while other services
+ * (e.g. PeerTube) provide WebVTT. The format is detected from the content
+ * itself. It is good enough for YouTube subtitles (manual and
+ * auto-generated): it parses cue timings and text lines, strips inline tags
+ * and restores the most common HTML entities.</p>
+ */
+public final class VttParser {
+
+    private static final String WEBVTT_HEADER = "WEBVTT";
+    private static final String CUE_ARROW = "-->";
+
+    private VttParser() { }
+
+    /**
+     * A single subtitle cue.
+     */
+    public static final class Cue {
+        public final long startMs;
+        public final long endMs;
+        public final List<String> lines;
+
+        Cue(final long startMs, final long endMs, @NonNull final List<String> lines) {
+            this.startMs = startMs;
+            this.endMs = endMs;
+            this.lines = Collections.unmodifiableList(lines);
+        }
+
+        /**
+         * @return the cue text lines joined into a single line. Used as the
+         *         translation key and as the original line of the bilingual
+         *         output: BisubSubtitleView splits a rendered cue at the
+         *         first newline (original above, translation below), so the
+         *         original must never contain a newline itself. Auto
+         *         generated tracks carry two rolling-window lines per cue
+         *         that belong to the same sentence, joining them with a
+         *         space keeps them one line.
+         */
+        @NonNull
+        public String joinedText() {
+            return String.join(" ", lines);
+        }
+    }
+
+    /**
+     * Parses a subtitle document into a list of cues. Both WebVTT and
+     * YouTube-flavored TTML are supported; the format is detected from the
+     * content. Malformed blocks are skipped.
+     *
+     * @param content the raw subtitle content
+     * @return the parsed cues, possibly empty
+     */
+    @NonNull
+    public static List<Cue> parse(@NonNull final String content) {
+        final String cleaned = content.replace("\uFEFF", "").trim();
+        if (cleaned.startsWith("<")) {
+            return parseTtml(cleaned);
+        }
+        return parseVtt(cleaned);
+    }
+
+    /**
+     * Parses a WebVTT document into a list of cues.
+     *
+     * @param vtt the raw WebVTT content
+     * @return the parsed cues, possibly empty
+     */
+    @NonNull
+    private static List<Cue> parseVtt(@NonNull final String vtt) {
+        final List<Cue> cues = new ArrayList<>();
+        final String[] lines = vtt.replace("\r\n", "\n").replace('\r', '\n').split("\n");
+
+        int i = 0;
+        // Skip the file header block (WEBVTT ... up to the first empty line)
+        while (i < lines.length && !lines[i].startsWith(WEBVTT_HEADER)) {
+            i++;
+        }
+        i++;
+
+        while (i < lines.length) {
+            // Skip blank lines and metadata blocks (NOTE, STYLE, REGION)
+            if (lines[i].trim().isEmpty() || lines[i].startsWith("NOTE")
+                    || lines[i].startsWith("STYLE") || lines[i].startsWith("REGION")
+                    || lines[i].startsWith(WEBVTT_HEADER)) {
+                i++;
+                continue;
+            }
+
+            // A block may start with an optional cue identifier line
+            int timingLine = i;
+            if (!lines[timingLine].contains(CUE_ARROW)) {
+                timingLine++;
+            }
+            if (timingLine >= lines.length || !lines[timingLine].contains(CUE_ARROW)) {
+                i++;
+                continue;
+            }
+
+            final long[] timing = parseTiming(lines[timingLine]);
+            if (timing == null) {
+                i = timingLine + 1;
+                continue;
+            }
+
+            final List<String> textLines = new ArrayList<>();
+            int j = timingLine + 1;
+            while (j < lines.length && !lines[j].trim().isEmpty()) {
+                final String cleanedLine = cleanLine(lines[j]);
+                if (!cleanedLine.isEmpty()) {
+                    textLines.add(cleanedLine);
+                }
+                j++;
+            }
+
+            if (!textLines.isEmpty()) {
+                cues.add(new Cue(timing[0], timing[1], textLines));
+            }
+            i = j;
+        }
+        return cues;
+    }
+
+    /**
+     * Parses a TTML document into a list of cues. Handles both the standard
+     * {@code begin}/{@code end} clock attributes and YouTube's flavor using
+     * {@code t} (start in milliseconds) plus {@code d} (duration), including
+     * the word-level {@code <s>} tags of auto-generated tracks.
+     *
+     * @param ttml the raw TTML content
+     * @return the parsed cues, possibly empty
+     */
+    @NonNull
+    private static List<Cue> parseTtml(@NonNull final String ttml) {
+        final List<Cue> cues = new ArrayList<>();
+        try {
+            final XmlPullParser parser = Xml.newPullParser();
+            parser.setInput(new StringReader(ttml));
+
+            long startMs = -1;
+            long endMs = -1;
+            final StringBuilder text = new StringBuilder();
+
+            int event = parser.getEventType();
+            while (event != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.START_TAG) {
+                    if ("p".equals(parser.getName())) {
+                        startMs = ttmlStartMs(parser);
+                        endMs = ttmlEndMs(parser, startMs);
+                        text.setLength(0);
+                    } else if ("br".equals(parser.getName()) && startMs >= 0) {
+                        text.append('\n');
+                    }
+                } else if (event == XmlPullParser.TEXT && startMs >= 0) {
+                    text.append(parser.getText());
+                } else if (event == XmlPullParser.END_TAG) {
+                    if ("p".equals(parser.getName())) {
+                        if (startMs >= 0 && endMs > startMs) {
+                            final List<String> cueLines = splitTtmlText(text.toString());
+                            if (!cueLines.isEmpty()) {
+                                cues.add(new Cue(startMs, endMs, cueLines));
+                            }
+                        }
+                        startMs = -1;
+                    } else if ("s".equals(parser.getName()) && startMs >= 0) {
+                        // YouTube's word tags do not carry separators themselves
+                        text.append(' ');
+                    }
+                }
+                event = parser.next();
+            }
+        } catch (final Exception ignored) {
+            // Malformed TTML: return whatever was parsed so far
+        }
+        return cues;
+    }
+
+    @NonNull
+    private static List<String> splitTtmlText(@NonNull final String rawText) {
+        final List<String> cueLines = new ArrayList<>();
+        for (final String line : rawText.split("\n")) {
+            final String cleaned = line.replaceAll("[ \\t]+", " ").trim();
+            if (!cleaned.isEmpty()) {
+                cueLines.add(cleaned);
+            }
+        }
+        return cueLines;
+    }
+
+    /**
+     * @param parser the parser positioned on a TTML {@code <p>} start tag
+     * @return the cue start time in milliseconds, or {@code -1} if unknown
+     */
+    private static long ttmlStartMs(@NonNull final XmlPullParser parser) {
+        final String t = parser.getAttributeValue(null, "t");
+        if (t != null) {
+            return parseTimingMs(t);
+        }
+        final String begin = parser.getAttributeValue(null, "begin");
+        return begin != null ? parseTimingMs(begin) : -1;
+    }
+
+    /**
+     * @param parser  the parser positioned on a TTML {@code <p>} start tag
+     * @param startMs the cue start time in milliseconds
+     * @return the cue end time in milliseconds, or {@code -1} if unknown
+     */
+    private static long ttmlEndMs(@NonNull final XmlPullParser parser, final long startMs) {
+        final String end = parser.getAttributeValue(null, "end");
+        if (end != null) {
+            return parseTimingMs(end);
+        }
+        final String duration = parser.getAttributeValue(null, "d") != null
+                ? parser.getAttributeValue(null, "d")
+                : parser.getAttributeValue(null, "dur");
+        if (duration != null && startMs >= 0) {
+            return startMs + parseTimingMs(duration);
+        }
+        return -1;
+    }
+
+    /**
+     * Parses a TTML timing value, which may be a plain millisecond number
+     * (YouTube: {@code 1200}), a clock value ({@code 00:00:01.200}) or a
+     * suffixed offset ({@code 1.2s}, {@code 1200ms}).
+     *
+     * @param value the raw attribute value
+     * @return the value in milliseconds, or {@code -1} if it cannot be parsed
+     */
+    private static long parseTimingMs(@Nullable final String value) {
+        if (value == null) {
+            return -1;
+        }
+        String v = value.trim();
+        boolean seconds = false;
+        if (v.endsWith("ms")) {
+            v = v.substring(0, v.length() - 2);
+        } else if (v.endsWith("s")) {
+            seconds = true;
+            v = v.substring(0, v.length() - 1);
+        }
+        if (v.contains(":")) {
+            final String[] parts = v.split(":");
+            try {
+                if (parts.length == 3) {
+                    return (long) (Double.parseDouble(parts[0]) * 3_600_000
+                            + Double.parseDouble(parts[1]) * 60_000
+                            + Double.parseDouble(parts[2]) * 1000);
+                } else if (parts.length == 2) {
+                    return (long) (Double.parseDouble(parts[0]) * 60_000
+                            + Double.parseDouble(parts[1]) * 1000);
+                }
+            } catch (final NumberFormatException ignored) {
+                // fall through: malformed timestamp
+            }
+            return -1;
+        }
+        try {
+            final double number = Double.parseDouble(v);
+            return (long) (seconds ? number * 1000 : number);
+        } catch (final NumberFormatException ignored) {
+            // fall through: malformed number
+        }
+        return -1;
+    }
+
+    /**
+     * Composes a bilingual WebVTT document. For every cue the original text
+     * lines are followed by the translated text (when available).
+     *
+     * @param cues        the original parsed cues
+     * @param translation a map from original joined cue text to translated text
+     * @return a WebVTT document as a string
+     */
+    @NonNull
+    public static String composeBilingual(@NonNull final List<Cue> cues,
+                                          @NonNull final Map<String, String> translation) {
+        final StringBuilder sb = new StringBuilder();
+        sb.append(WEBVTT_HEADER).append('\n');
+        sb.append('\n');
+        for (final Cue cue : cues) {
+            sb.append(formatTiming(cue.startMs)).append(' ').append(CUE_ARROW).append(' ')
+                    .append(formatTiming(cue.endMs)).append('\n');
+            // Exactly two lines per cue: the original text first, the
+            // translation second. BisubSubtitleView relies on this fixed
+            // structure to render the two lines with separate font sizes.
+            sb.append(cue.joinedText()).append('\n');
+            final String translated = translation.get(cue.joinedText());
+            if (translated != null && !translated.trim().isEmpty()) {
+                sb.append(translated.replace("\n", " ").trim()).append('\n');
+            }
+            sb.append('\n');
+        }
+        return sb.toString();
+    }
+
+    @NonNull
+    private static String formatTiming(final long ms) {
+        return String.format(Locale.US, "%02d:%02d:%02d.%03d",
+                ms / 3_600_000, (ms / 60_000) % 60, (ms / 1000) % 60, ms % 1000);
+    }
+
+    @Nullable
+    private static long[] parseTiming(@NonNull final String line) {
+        // "00:00:01.000 --> 00:00:03.000 align:start position:0%" or short form "00:01.000 --> ..."
+        final String[] parts = line.split(CUE_ARROW);
+        if (parts.length < 2) {
+            return null;
+        }
+        final Long start = parseTimestamp(parts[0].trim());
+        final Long end = parseTimestamp(parts[1].trim().split("\\s+")[0]);
+        if (start == null || end == null || end <= start) {
+            return null;
+        }
+        return new long[]{start, end};
+    }
+
+    @Nullable
+    private static Long parseTimestamp(@NonNull final String stamp) {
+        final String[] hms = stamp.replace(',', '.').split(":");
+        try {
+            if (hms.length == 3) {
+                return (Long.parseLong(hms[0]) * 3_600_000L)
+                        + (Long.parseLong(hms[1]) * 60_000L)
+                        + (long) (Double.parseDouble(hms[2]) * 1000);
+            } else if (hms.length == 2) {
+                return (Long.parseLong(hms[0]) * 60_000L)
+                        + (long) (Double.parseDouble(hms[1]) * 1000);
+            }
+        } catch (final NumberFormatException ignored) {
+            // fall through: malformed timestamp
+        }
+        return null;
+    }
+
+    @NonNull
+    private static String cleanLine(@NonNull final String raw) {
+        String s = raw;
+        // Strip inline timing tags like <00:00:01.000> and voice/style tags <v Name>, <c>, </c>
+        s = s.replaceAll("<[^>]*>", "");
+        // Restore common HTML entities
+        s = s.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">")
+                .replace("&quot;", "\"").replace("&#39;", "'").replace("&nbsp;", " ");
+        return s.trim();
+    }
+}
