@@ -0,0 +1,55 @@
+package org.schabi.newpipe.bisub;
+
+import androidx.annotation.NonNull;
+
+/**
+ * In-app style of the bilingual subtitle track.
+ *
+ * <p>The style replaces the Android system caption style while the bilingual
+ * track is selected. This keeps the bilingual appearance adjustable on
+ * systems that ship without the Android caption settings (e.g. HarmonyOS,
+ * where {@code Settings.ACTION_CAPTIONING_SETTINGS} leads nowhere). The
+ * actual rendering happens in {@link BisubSubtitleView}, which is used by
+ * both the player and the style editor preview, so both always match.</p>
+ */
+public final class BisubStyle {
+
+    /** Translucent black background behind each subtitle block (default). */
+    public static final int BG_TRANSLUCENT = 0;
+    /** Fully opaque black background behind each subtitle block. */
+    public static final int BG_OPAQUE = 1;
+    /** No background, black outline around the glyphs instead. */
+    public static final int BG_NONE = 2;
+
+    /** Default text color: white, like the Android system caption default. */
+    public static final int DEFAULT_TEXT_COLOR = 0xFFFFFFFF;
+    /** Default overall scale of the whole subtitle block (text, padding
+     *  and corner radius all follow it). */
+    public static final float DEFAULT_BASE_SCALE = 1.0f;
+    /** Default padding between the text and the background block edge, in dp. */
+    public static final float DEFAULT_PADDING_DP = 4.0f;
+    /** Default background corner radius in dp; 0 means square corners. */
+    public static final float DEFAULT_CORNER_RADIUS_DP = 4.0f;
+    /** Default maximum text width as a fraction of the view width; 1.0 lets
+     *  long lines span the whole screen before wrapping. */
+    public static final float DEFAULT_MAX_WIDTH_PERCENT = 1.0f;
+    /** Default distance between the subtitle block and the bottom of the
+     *  view, as a fraction of the view height. */
+    public static final float DEFAULT_POSITION_PERCENT = 0.05f;
+
+    static final int COLOR_TRANSLUCENT_BLACK = 0x8A000000;
+    static final int COLOR_OPAQUE_BLACK = 0xFF000000;
+
+    private BisubStyle() { }
+
+    /**
+     * Applies a style to the self-drawn bilingual subtitle view.
+     *
+     * @param view  the subtitle view to style (player view or preview)
+     * @param style the style to apply
+     */
+    public static void applyTo(@NonNull final BisubSubtitleView view,
+                               @NonNull final BisubPrefs.Style style) {
+        view.setBisubStyle(style);
+    }
+}
diff --git a/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java b/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java
new file mode 100644
index 000000000..ac09cda42
--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/BisubSubtitleView.java
@@ -0,0 +1,300 @@
+package org.schabi.newpipe.bisub;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.text.Layout;
+import android.text.StaticLayout;
+import android.text.TextPaint;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.android.exoplayer2.text.Cue;
+import com.google.android.exoplayer2.ui.SubtitleView;
+
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Self-drawn rendering view for the bilingual subtitle track.
+ *
+ * <p>ExoPlayer's {@code SubtitleView} paints plain axis-aligned rectangles
+ * tightly around each cue line: no padding and no rounded corners can be
+ * expressed through {@code CaptionStyleCompat}. This view instead renders
+ * the bilingual cues itself, so the in-app style fully controls the
+ * appearance: one overall size for the whole block (the background bar,
+ * the font size of both language lines, padding and corner radius all
+ * follow it), text color, translucent/opaque/none background (with a
+ * black outline in the "none" case), background padding, rounded corners,
+ * the wrap width and the vertical position of the subtitle block.</p>
+ *
+ * <p>The layout is a fixed-width container, like a div with a set width
+ * containing two centered text layers: the background bar's width is
+ * derived from the overall size and the wrap width only, never from the
+ * text. Growing the size re-wraps both layers inside the bar (centered),
+ * it can never stretch or shrink the background.</p>
+ *
+ * <p>The bilingual VTT written by {@link VttParser} uses exactly two lines
+ * per cue (original text, then translation), which is how this view tells
+ * the two apart. It is used both by the player and by the style editor
+ * preview. The preview sets a reference player size: the cues are laid
+ * out exactly as on a fullscreen player (same font sizes, same wrap
+ * points) and the finished drawing is scaled down as a whole, so the
+ * preview is a true miniature of the on-screen result instead of wrapping
+ * early inside the narrow dialog box.</p>
+ */
+public final class BisubSubtitleView extends View {
+
+    private List<Cue> cues = Collections.emptyList();
+    private BisubPrefs.Style style = new BisubPrefs.Style(
+            BisubStyle.DEFAULT_BASE_SCALE,
+            BisubStyle.DEFAULT_TEXT_COLOR, BisubStyle.BG_TRANSLUCENT,
+            BisubStyle.DEFAULT_PADDING_DP, BisubStyle.DEFAULT_CORNER_RADIUS_DP,
+            BisubStyle.DEFAULT_MAX_WIDTH_PERCENT,
+            BisubStyle.DEFAULT_POSITION_PERCENT);
+
+    private final TextPaint textPaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint backgroundPaint = new Paint();
+
+    /** Reference player width the preview lays out at; 0 disables it. */
+    private float referenceWidthPx;
+    /** Reference player height the preview lays out at; 0 disables it. */
+    private float referenceHeightPx;
+
+    public BisubSubtitleView(@NonNull final Context context,
+                             @Nullable final AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    /**
+     * Sets the cues to render, the same list the player hands to the
+     * regular subtitle view.
+     *
+     * @param cueList the active cues; {@code null} clears the view
+     */
+    public void setCues(@Nullable final List<Cue> cueList) {
+        this.cues = cueList == null ? Collections.emptyList() : cueList;
+        invalidate();
+    }
+
+    /**
+     * Sets the style used while drawing the cues.
+     *
+     * @param newStyle the in-app bilingual subtitle style
+     */
+    public void setBisubStyle(@NonNull final BisubPrefs.Style newStyle) {
+        this.style = newStyle;
+        invalidate();
+    }
+
+    /**
+     * Sets the player size the preview emulates: cues are laid out at the
+     * reference size and the drawing is scaled down as a whole, so font
+     * sizes and wrap points match a fullscreen player exactly.
+     *
+     * @param widthDp  the reference player width in dp, or 0 to use the
+     *                 view's own size (what the player does)
+     * @param heightDp the reference player height in dp, or 0 to use the
+     *                 view's own size
+     */
+    public void setReferenceSize(final float widthDp, final float heightDp) {
+        final float density = getResources().getDisplayMetrics().density;
+        this.referenceWidthPx = widthDp > 0 ? widthDp * density : 0f;
+        this.referenceHeightPx = heightDp > 0 ? heightDp * density : 0f;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(@NonNull final Canvas canvas) {
+        final int viewWidth = getWidth() - getPaddingLeft() - getPaddingRight();
+        final int viewHeight = getHeight() - getPaddingTop() - getPaddingBottom();
+        if (viewWidth <= 0 || viewHeight <= 0 || cues.isEmpty()) {
+            return;
+        }
+
+        final boolean preview = referenceWidthPx > 0 && referenceHeightPx > 0;
+        final float width = preview ? referenceWidthPx : viewWidth;
+        final float height = preview ? referenceHeightPx : viewHeight;
+
+        final float baseScale =
+                Math.max(0.4f, Math.min(3.0f, style.baseScale));
+        final float baseTextSize =
+                height * SubtitleView.DEFAULT_TEXT_SIZE_FRACTION;
+        if (baseTextSize <= 0) {
+            return;
+        }
+        final float density = getResources().getDisplayMetrics().density;
+        // The overall scale resizes the whole block like resizing the
+        // outer component: the background bar, the base font size,
+        // padding, corners and cue gaps all follow it.
+        final float padPx = style.paddingDp * density * baseScale;
+        final float radiusPx = style.cornerRadiusDp * density * baseScale;
+        final float cueGapPx = 12 * density * baseScale;
+        // The background is a fixed-width container: its width depends
+        // only on the overall scale and the user-adjustable wrap width
+        // (0.5-1.0 of the view width), never on the text. Font sizes are
+        // relative to that fixed bar: growing a language layer just
+        // re-wraps it inside the bar, it can never stretch or shrink the
+        // background (which is what "fit the background to the widest
+        // line" did before).
+        final float blockWidth = Math.min(
+                width * Math.max(0.5f, Math.min(1.0f, style.maxWidthPercent))
+                        * baseScale,
+                width);
+        final float layoutWidth = Math.max(1f, blockWidth - 2 * padPx);
+
+        if (preview) {
+            final float scale = Math.min(viewWidth / width, viewHeight / height);
+            canvas.save();
+            canvas.translate((viewWidth - width * scale) / 2f,
+                    (viewHeight - height * scale) / 2f);
+            canvas.scale(scale, scale);
+        }
+
+        textPaint.setTypeface(Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD));
+
+        float bottom = height - height
+                * Math.max(0f, Math.min(0.3f, style.positionPercent));
+        for (final Cue cue : cues) {
+            final CharSequence cueText = cue == null ? null : cue.text;
+            if (cueText == null || cueText.length() == 0) {
+                continue;
+            }
+            final String raw = cueText.toString();
+            final int newline = raw.indexOf('\n');
+            final String original = newline > 0 ? raw.substring(0, newline) : raw;
+            final String translation =
+                    newline > 0 && newline < raw.length() - 1
+                            ? raw.substring(newline + 1) : null;
+
+            final float textSize = baseTextSize * baseScale;
+
+            // Both text layers live inside the fixed-width bar: each one
+            // is laid out with the full layout width and centered on it
+            // by ALIGN_CENTER, exactly like text-align: center inside a
+            // fixed-width container. No per-layer re-wrapping, no shared
+            // width measuring: the layers can never influence the bar.
+            final StaticLayout originalLayout =
+                    fitLayout(original, textSize, layoutWidth);
+            final StaticLayout translationLayout = translation != null
+                    ? fitLayout(translation, textSize, layoutWidth)
+                    : null;
+
+            final float gapPx = textSize * 0.25f;
+            final float blockHeight = originalLayout.getHeight()
+                    + (translationLayout != null
+                        ? translationLayout.getHeight() + gapPx : 0) + 2 * padPx;
+            final float center = width / 2f;
+            final float left = center - blockWidth / 2f;
+            // Keep oversized blocks (large scales) on screen instead of
+            // letting them start above the top of the view.
+            float top = bottom - blockHeight;
+            if (top < 0) {
+                top = 0;
+            }
+            final float blockBottom = top + blockHeight;
+
+            if (style.backgroundMode != BisubStyle.BG_NONE) {
+                backgroundPaint.setColor(style.backgroundMode == BisubStyle.BG_OPAQUE
+                        ? BisubStyle.COLOR_OPAQUE_BLACK
+                        : BisubStyle.COLOR_TRANSLUCENT_BLACK);
+                backgroundPaint.setStyle(Paint.Style.FILL);
+                if (radiusPx > 0) {
+                    canvas.drawRoundRect(left, top, left + blockWidth, blockBottom,
+                            radiusPx, radiusPx, backgroundPaint);
+                } else {
+                    canvas.drawRect(left, top, left + blockWidth, blockBottom,
+                            backgroundPaint);
+                }
+            }
+
+            float y = top + padPx;
+            y = drawLayout(canvas, originalLayout, left + padPx, y,
+                    style.backgroundMode == BisubStyle.BG_NONE, textSize);
+            if (translationLayout != null) {
+                drawLayout(canvas, translationLayout, left + padPx, y + gapPx,
+                        style.backgroundMode == BisubStyle.BG_NONE,
+                        textSize);
+            }
+
+            bottom = top - cueGapPx;
+        }
+
+        if (preview) {
+            canvas.restore();
+        }
+    }
+
+    @NonNull
+    private StaticLayout layout(@NonNull final String text, final float textSize,
+                                final float width) {
+        textPaint.setTextSize(textSize);
+        return StaticLayout.Builder.obtain(
+                text, 0, text.length(), textPaint, Math.max(1,
+                        (int) Math.ceil(width)))
+                .setAlignment(Layout.Alignment.ALIGN_CENTER)
+                .setLineSpacing(0f, 1.0f)
+                .setIncludePad(false)
+                .build();
+    }
+
+    /**
+     * Builds a layout that fits the given width: a line holding a single
+     * unbreakable token (long word, URL) wider than the available width
+     * is not wrapped by {@link StaticLayout} but overflows it, so the
+     * font size is stepped down until every line fits. This keeps text
+     * inside the background block at any font scale.
+     *
+     * @param text     the text to lay out
+     * @param textSize the desired font size in px
+     * @param maxWidth the available width in px
+     * @return a layout whose widest line does not exceed {@code maxWidth}
+     */
+    @NonNull
+    private StaticLayout fitLayout(@NonNull final String text, final float textSize,
+                                   final float maxWidth) {
+        float size = textSize;
+        StaticLayout result = layout(text, size, maxWidth);
+        for (int attempt = 0; attempt < 3; attempt++) {
+            final float measured = measureWidth(result);
+            if (measured <= maxWidth) {
+                break;
+            }
+            size *= Math.max(0.5f, maxWidth / measured * 0.98f);
+            result = layout(text, size, maxWidth);
+        }
+        return result;
+    }
+
+    private static float measureWidth(@NonNull final StaticLayout layout) {
+        float textWidth = 0;
+        for (int line = 0; line < layout.getLineCount(); line++) {
+            textWidth = Math.max(textWidth, layout.getLineWidth(line));
+        }
+        return textWidth;
+    }
+
+    private float drawLayout(@NonNull final Canvas canvas,
+                             @NonNull final StaticLayout layout,
+                             final float x, final float y, final boolean outline,
+                             final float textSize) {
+        canvas.save();
+        canvas.translate(x, y);
+        if (outline) {
+            textPaint.setStyle(Paint.Style.STROKE);
+            textPaint.setStrokeWidth(Math.max(2f, textSize / 12f));
+            textPaint.setColor(Color.BLACK);
+            layout.draw(canvas);
+            textPaint.setStyle(Paint.Style.FILL);
+        }
+        textPaint.setColor(style.textColor);
+        layout.draw(canvas);
+        canvas.restore();
+        return y + layout.getHeight();
+    }
+}
