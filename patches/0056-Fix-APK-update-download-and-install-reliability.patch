 public final class BisubUpdateChecker {
 
@@ -100,7 +107,7 @@ public final class BisubUpdateChecker {
                 final String releaseName =
                         json.optString("name", tagName);
                 runOnUi(() -> showUpdateAvailable(
-                        context, releaseName, notes, apkUrl));
+                        context, releaseName, notes, apkUrl, remote));
             }
         } catch (final Exception e) {
             BisubLog.e("Update check failed", e);
@@ -183,7 +190,7 @@ public final class BisubUpdateChecker {
 
     private static void showUpdateAvailable(final Context context,
             final String releaseName, final String notes,
-            final String apkUrl) {
+            final String apkUrl, final int remoteNumber) {
         final ScrollView scroller = new ScrollView(context);
         final TextView view = new TextView(context);
         view.setText(notes);
@@ -197,21 +204,82 @@ public final class BisubUpdateChecker {
                         releaseName))
                 .setView(scroller)
                 .setPositiveButton(R.string.bisub_update_download,
-                        (d, w) -> downloadAndInstall(context, apkUrl))
+                        (d, w) -> downloadAndInstall(
+                                context, apkUrl, remoteNumber))
                 .setNegativeButton(android.R.string.cancel, null)
                 .show();
     }
 
+    /**
+     * Returns the path where the APK for the given bisub run-number
+     * should be stored.  Prefers the external files dir (persistent,
+     * not cleared by the OS); falls back to the cache dir if external
+     * storage is unavailable.
+     */
+    private static File getApkFile(final Context context,
+                                   final int remoteNumber) {
+        final String name = "bisub-update-" + remoteNumber + ".apk";
+        final File extDir = context.getExternalFilesDir(null);
+        if (extDir != null) {
+            return new File(extDir, name);
+        }
+        return new File(context.getCacheDir(), name);
+    }
+
+    /**
+     * Deletes any previously cached APK files that belong to a
+     * different bisub version, keeping the download directory tidy.
+     */
+    private static void cleanupOldApks(final File currentApk) {
+        final File dir = currentApk.getParentFile();
+        if (dir == null) {
+            return;
+        }
+        final File[] files = dir.listFiles();
+        if (files == null) {
+            return;
+        }
+        for (final File f : files) {
+            final String fn = f.getName();
+            if (fn.startsWith("bisub-update-")
+                    && fn.endsWith(".apk")
+                    && !fn.equals(currentApk.getName())) {
+                f.delete();
+            }
+        }
+    }
+
+    @SuppressWarnings("deprecation")
     private static void downloadAndInstall(final Context context,
-                                           final String apkUrl) {
-        Toast.makeText(context, R.string.bisub_update_downloading,
-                Toast.LENGTH_SHORT).show();
-        new Thread(() -> doDownload(context, apkUrl)).start();
+                                           final String apkUrl,
+                                           final int remoteNumber) {
+        final File apkFile = getApkFile(context, remoteNumber);
+        if (apkFile.exists() && apkFile.length() > 0) {
+            Toast.makeText(context, R.string.bisub_update_installing,
+                    Toast.LENGTH_SHORT).show();
+            installApk(context, apkFile);
+            return;
+        }
+
+        final ProgressDialog progress = new ProgressDialog(context);
+        progress.setTitle(R.string.bisub_update_downloading);
+        progress.setProgressStyle(ProgressDialog.STYLE_HORIZONTAL);
+        progress.setMax(100);
+        progress.setProgress(0);
+        progress.setIndeterminate(false);
+        progress.setCancelable(false);
+        progress.show();
+
+        new Thread(() -> doDownload(
+                context, apkUrl, apkFile, progress)).start();
     }
 
     private static void doDownload(final Context context,
-                                   final String apkUrl) {
+                                   final String apkUrl,
+                                   final File apkFile,
+                                   final ProgressDialog progress) {
         try {
+            cleanupOldApks(apkFile);
             final OkHttpClient client = new OkHttpClient.Builder()
                     .connectTimeout(30, TimeUnit.SECONDS)
                     .readTimeout(120, TimeUnit.SECONDS)
@@ -223,26 +291,54 @@ public final class BisubUpdateChecker {
             try (Response response = client.newCall(request).execute()) {
                 if (!response.isSuccessful()) {
                     final int code = response.code();
-                    runOnUi(() -> showError(context,
-                            "Download HTTP " + code));
+                    runOnUi(() -> {
+                        progress.dismiss();
+                        showError(context, "Download HTTP " + code);
+                    });
                     return;
                 }
-                final File apkFile = new File(
-                        context.getCacheDir(), "bisub-update.apk");
+                final long contentLength =
+                        response.body().contentLength();
                 try (InputStream is = response.body().byteStream();
                      FileOutputStream fos =
                              new FileOutputStream(apkFile)) {
                     final byte[] buf = new byte[8192];
                     int n;
+                    long total = 0;
+                    long lastUpdate = 0;
                     while ((n = is.read(buf)) > 0) {
                         fos.write(buf, 0, n);
+                        total += n;
+                        if (contentLength > 0
+                                && total - lastUpdate > 100_000) {
+                            lastUpdate = total;
+                            final int pct = (int) (total * 100
+                                    / contentLength);
+                            runOnUi(() -> progress.setProgress(pct));
+                        }
                     }
                 }
-                runOnUi(() -> installApk(context, apkFile));
+                if (contentLength > 0
+                        && apkFile.length() != contentLength) {
+                    apkFile.delete();
+                    runOnUi(() -> {
+                        progress.dismiss();
+                        showError(context, "Download incomplete");
+                    });
+                    return;
+                }
+                runOnUi(() -> {
+                    progress.dismiss();
+                    installApk(context, apkFile);
+                });
             }
         } catch (final Exception e) {
             BisubLog.e("APK download failed", e);
-            runOnUi(() -> showError(context, e.getMessage()));
+            apkFile.delete();
+            runOnUi(() -> {
+                progress.dismiss();
+                showError(context, e.getMessage());
+            });
         }
     }
 
