+    /**
+     * Merges cues that carry a sentence fragment with the cue that
+     * continues it. Auto-generated subtitles use rolling windows that cut
+     * one spoken sentence into several cues; translating those fragments
+     * separately produces incoherent bilingual lines, so a cue whose text
+     * clearly does not end a sentence joins the following cue when they are
+     * close in time and the combined text still fits one subtitle line.
+     * The merged cue spans both time ranges, so nothing on screen is lost.
+     *
+     * @param cues parsed cues in document (time) order
+     * @return cues with sentence fragments joined into whole sentences
+     */
+    @NonNull
+    private static List<VttParser.Cue> mergeSentenceFragments(
+            @NonNull final List<VttParser.Cue> cues) {
+        final List<VttParser.Cue> merged = new ArrayList<>();
+        for (final VttParser.Cue cue : cues) {
+            if (!merged.isEmpty()) {
+                final VttParser.Cue last = merged.get(merged.size() - 1);
+                final String lastText = last.joinedText();
+                final String nextText = cue.joinedText();
+                final boolean endsSentence = endsSentence(lastText);
+                final boolean closeInTime = cue.startMs - last.endMs
+                        <= SENTENCE_MERGE_GAP_MS;
+                final boolean fitsLine = lastText.length() + nextText.length() + 1
+                        <= SENTENCE_MERGE_MAX_CHARS;
+                if (!endsSentence && closeInTime && fitsLine) {
+                    merged.set(merged.size() - 1, new VttParser.Cue(last.startMs,
+                            Math.max(last.endMs, cue.endMs),
+                            Collections.singletonList(lastText + " " + nextText)));
+                    continue;
+                }
+            }
+            merged.add(cue);
+        }
+        return merged;
+    }
+
+    /**
+     * @param text a cue text
+     * @return whether the text ends with a sentence-ending character, i.e.
+     *         it is not continued by the following cue
+     */
+    private static boolean endsSentence(@NonNull final String text) {
+        final String trimmed = text.trim();
+        if (trimmed.isEmpty()) {
+            return true;
+        }
+        final char c = trimmed.charAt(trimmed.length() - 1);
+        return c == '.' || c == '!' || c == '?' || c == ';'
+                || c == '。' || c == '！' || c == '？' || c == '；'
+                || c == '…' || c == '»' || c == '"';
+    }
