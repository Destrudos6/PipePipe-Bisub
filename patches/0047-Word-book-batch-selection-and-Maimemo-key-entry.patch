+    /**
+     * Removes several words at once (the word book's batch delete).
+     *
+     * @param context any context
+     * @param words   the words to remove
+     */
+    public static void removeAll(@NonNull final Context context,
+                                 @NonNull final List<String> words) {
+        if (words.isEmpty()) {
+            return;
+        }
+        final List<Item> items = readItems(context);
+        boolean removed = false;
+        for (int i = items.size() - 1; i >= 0; i--) {
+            if (words.contains(items.get(i).word)) {
+                items.remove(i);
+                removed = true;
+            }
+        }
+        if (removed) {
+            writeItems(context, items);
+        }
+    }
