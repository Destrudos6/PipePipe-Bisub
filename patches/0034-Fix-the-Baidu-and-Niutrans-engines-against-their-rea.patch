+    /**
+     * Computes the Niutrans {@code authStr} permission string: the API
+     * key plus every sent parameter, sorted by parameter name in ASCII
+     * order, joined as {@code key=value} pairs and hashed with MD5. The
+     * {@code authStr} itself and empty fields never take part in the
+     * digest, and the values are used verbatim (no URL encoding), per
+     * the API documentation.
+     *
+     * @param apiKey    the Niutrans API key (not sent, but signed)
+     * @param appId     the Niutrans application id
+     * @param srcText   the joined text of this request
+     * @param timestamp the current time in milliseconds
+     * @param target    the target language code
+     * @return the 32-character lowercase MD5 digest
+     */
+    @NonNull
+    private static String niutransAuthStr(@NonNull final String apiKey,
+                                          @NonNull final String appId,
+                                          @NonNull final String srcText,
+                                          @NonNull final String timestamp,
+                                          @NonNull final String target) {
+        final Map<String, String> params = new TreeMap<>();
+        params.put("apikey", apiKey);
+        params.put("appId", appId);
+        params.put("from", "auto");
+        params.put("srcText", srcText);
+        params.put("timestamp", timestamp);
+        params.put("to", target);
+        final StringBuilder builder = new StringBuilder();
+        for (final Map.Entry<String, String> entry : params.entrySet()) {
+            if (builder.length() > 0) {
+                builder.append('&');
+            }
+            builder.append(entry.getKey()).append('=').append(entry.getValue());
+        }
+        return md5Hex(builder.toString());
+    }
