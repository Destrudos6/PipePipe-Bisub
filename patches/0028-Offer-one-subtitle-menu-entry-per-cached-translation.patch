     /**
-     * Returns the completed bilingual subtitle file of a video, if one is
-     * cached. This only reads disk and never starts or waits for a
-     * translation, so the playback resolver can call it freely.
+     * Lists every completed bilingual subtitle of a video across all
+     * provider profiles, so the playback resolver can offer one subtitle
+     * menu entry per cached translation. The entry of the active profile
+     * comes first, so it stays on top of the menu. This only reads disk and
+     * never starts or waits for a translation, so the playback resolver can
+     * call it freely.
      *
      * @param info the stream info of the video being resolved
-     * @return the local bilingual WebVTT file, or {@code null}
+     * @return the cached tracks, ordered active-profile-first; empty when
+     *         bisub is disabled, misconfigured, or nothing is cached yet
+     */
+    @NonNull
+    public List<CachedBilingualTrack> listCompletedBilingualTracks(
+            @NonNull final StreamInfo info) {
+        final List<CachedBilingualTrack> result = new ArrayList<>();
+        final List<BisubPrefs.ProviderProfile> profiles = BisubPrefs.loadProfiles(appContext);
+        if (profiles.isEmpty()) {
+            return result;
+        }
+        final String activeId = BisubPrefs.getActiveProfileId(appContext);
+        // The active profile leads the menu; the others follow in list order.
+        final List<BisubPrefs.ProviderProfile> ordered = new ArrayList<>(profiles.size());
+        for (final BisubPrefs.ProviderProfile profile : profiles) {
+            if (profile.id.equals(activeId)) {
+                ordered.add(profile);
+                break;
+            }
+        }
+        for (final BisubPrefs.ProviderProfile profile : profiles) {
+            if (!profile.id.equals(activeId)) {
+                ordered.add(profile);
+            }
+        }
+        // Track languages must be unique: ExoPlayer only normalizes them to
+        // lower case, so two profiles whose names differ in case alone would
+        // otherwise collide into one indistinguishable track.
+        final Set<String> usedLabels = new HashSet<>();
+        for (final BisubPrefs.ProviderProfile profile : ordered) {
+            final CacheTarget target =
+                    resolveCacheTarget(info, BisubPrefs.configOf(appContext, profile));
+            if (target == null || !isDone(target)) {
+                continue;
+            }
+            String label = profile.name;
+            if (!usedLabels.add(label.toLowerCase(Locale.ROOT))) {
+                int suffix = 2;
+                while (!usedLabels.add(
+                        (profile.name + " " + suffix).toLowerCase(Locale.ROOT))) {
+                    suffix++;
+                }
+                label = profile.name + " " + suffix;
+            }
+            result.add(new CachedBilingualTrack(Uri.fromFile(target.cacheFile),
+                    BILINGUAL_TRACK_PREFIX + label + "）",
+                    profile.id.equals(activeId)));
+            Log.i(TAG, "Bilingual subtitle cache hit: " + target.cacheFile.getName()
+                    + " (" + info.getId() + ", profile '" + profile.name + "')");
+            BisubLog.i("Playback: video " + info.getId()
+                    + " offers the cached bilingual file "
+                    + target.cacheFile.getName() + " from profile '" + profile.name + "'");
+        }
+        return result;
+    }
+
+    /**
+     * @param info the stream info of the video being resolved
+     * @return the track language of the active profile's cached bilingual
+     *         subtitle, or {@code null} when the active profile has no
+     *         completed cache for this video
      */
     @Nullable
-    public Uri getCompletedBilingualSubtitle(@NonNull final StreamInfo info) {
-        final CacheTarget target = resolveCacheTarget(info);
-        if (target == null || !isDone(target)) {
-            return null;
+    public String activeBilingualTrackLanguage(@NonNull final StreamInfo info) {
+        for (final CachedBilingualTrack track : listCompletedBilingualTracks(info)) {
+            if (track.active) {
+                return track.language;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * One per-profile completed bilingual subtitle offered to the playback
+     * resolver: the cached file plus the player track language (also the
+     * label shown in the player's subtitle menu, e.g.
+     * "Bilingual（Google）") and whether it belongs to the active profile.
+     */
+    public static final class CachedBilingualTrack {
+        /** The local bilingual WebVTT file on disk. */
+        @NonNull public final Uri file;
+        /** Player track language and menu label of this translation. */
+        @NonNull public final String language;
+        /** Whether the track belongs to the currently active profile. */
+        public final boolean active;
+
+        CachedBilingualTrack(@NonNull final Uri file, @NonNull final String language,
+                             final boolean active) {
+            this.file = file;
+            this.language = language;
+            this.active = active;
         }
-        Log.i(TAG, "Bilingual subtitle cache hit: " + target.cacheFile.getName()
-                + " (" + info.getId() + ")");
-        BisubLog.i("Playback: video " + info.getId()
-                + " resolves to the cached bilingual file " + target.cacheFile.getName());
-        return Uri.fromFile(target.cacheFile);
     }
 
