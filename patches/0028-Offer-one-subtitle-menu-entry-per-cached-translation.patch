     @NonNull
     private static final String BILINGUAL_TRACK_LANGUAGE = "Bilingual（双语）";
 
+    /**
+     * Every per-profile bilingual track language starts with this prefix
+     * ("Bilingual（…）"), which is also what the player uses to tell the
+     * self-drawn bilingual rendering apart from regular subtitle tracks:
+     * ExoPlayer normalizes track languages to lower case, so the check is a
+     * case-insensitive prefix match.
+     */
+    @NonNull
+    private static final String BILINGUAL_TRACK_PREFIX = "Bilingual（";
+
+    /**
+     * Tells whether a player text-track language refers to a bilingual
+     * track (any provider profile), so the caller can route it to the
+     * self-drawn bilingual rendering. Works with the legacy single
+     * "Bilingual（双语）" track as well as with the per-profile ones.
+     *
+     * @param language the track language to check, may be {@code null}
+     * @return whether the language marks a bilingual track
+     */
+    public static boolean isBilingualTrackLanguage(@Nullable final String language) {
+        return language != null
+                && language.toLowerCase(Locale.ROOT).startsWith("bilingual");
+    }
