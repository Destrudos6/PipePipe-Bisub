+     * (tappable to play the pronunciation), exam labels, senses, word
+     * forms, web translations as a fallback, and the word book button.
+     *
+     * @param view  the inflated popup layout
+     * @param word  the looked-up word
+     * @param entry the lookup result, or {@code null} on failure
+     */
+    private void fillWordDialog(@NonNull final View view, @NonNull final String word,
+                                @Nullable final WordEntry entry) {
+        final TextView phoneticView = view.findViewById(R.id.bisub_word_phonetic);
+        final TextView examView = view.findViewById(R.id.bisub_word_exam);
+        final android.view.ViewGroup content = view.findViewById(R.id.bisub_word_content);
+        content.removeAllViews();
+        if (entry == null) {
+            content.addView(row(getString(R.string.bisub_word_lookup_failed), false));
+            return;
+        }
+        if (entry.phonetic != null) {
+            phoneticView.setText("/" + entry.phonetic + "/");
+            phoneticView.setOnClickListener(v -> {
+                if (entry.speechUrl != null) {
+                    playSpeech(entry.speechUrl);
+                } else {
+                    playSpeech(entry.word);
+                }
+            });
+        } else {
+            phoneticView.setOnClickListener(v -> playSpeech(entry.word));
+        }
+        examView.setText(android.text.TextUtils.join(" · ", entry.examTypes));
+        if (entry.isEmpty()) {
+            content.addView(row(getString(R.string.bisub_word_no_result), false));
+        }
+        for (final String translation : entry.translations) {
+            content.addView(row(translation, false));
+        }
+        if (!entry.forms.isEmpty()) {
+            final StringBuilder forms = new StringBuilder();
+            for (final String[] form : entry.forms) {
+                if (forms.length() > 0) {
+                    forms.append("；");
+                }
+                forms.append(form[0]).append(' ').append(form[1]);
+            }
+            content.addView(row(forms.toString(), true));
+        }
+        for (final String[] web : entry.webTranslations) {
+            content.addView(row(web[0] + "：" + web[1], false));
+        }
+
+    }
+
+    /**
+     * @param button the word book button
+     * @param word   the looked-up word
