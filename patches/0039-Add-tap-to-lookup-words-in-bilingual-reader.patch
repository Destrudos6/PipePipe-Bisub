+        /**
+         * Builds the original line with one clickable span per word, so
+         * tapping a word opens the dictionary popup. The spannable is
+         * rebuilt per bind; the layout cost of a few dozen spans per
+         * line is far below a frame.
+         *
+         * @param text the original line
+         * @return the line with word spans
+         */
+        @NonNull
+        private CharSequence spannedOriginal(@NonNull final String text) {
+            final SpannableStringBuilder builder = new SpannableStringBuilder(text);
+            final Matcher matcher = WORD.matcher(text);
+            while (matcher.find()) {
+                final String word = matcher.group();
+                if (word.length() == 1 && !isSingleLetterWord(word.charAt(0))) {
+                    continue;
+                }
+                builder.setSpan(new WordSpan(word), matcher.start(), matcher.end(),
