diff --git a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordBook.java b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordBook.java
new file mode 100644
index 000000000..3f0bbcfa4
--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordBook.java
@@ -0,0 +1,115 @@
+package org.schabi.newpipe.bisub.wordlookup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+
+import androidx.preference.PreferenceManager;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The local word book: every word the learner saved from the reader's
+ * word popup. Stored as a JSON array in the default shared preferences,
+ * so it rides along in every data export and cloud backup (and will be
+ * ready for an export to a spaced-repetition app later).
+ */
+public final class WordBook {
+
+    private static final String KEY = "bisub_word_book";
+
+    private WordBook() {
+    }
+
+    private static SharedPreferences prefs(@NonNull final Context context) {
+        return PreferenceManager.getDefaultSharedPreferences(
+                context.getApplicationContext());
+    }
+
+    /**
+     * Saves a word (most recent first). Saving an existing word moves
+     * it to the front without duplicating it.
+     *
+     * @param context any context
+     * @param word    the word to save
+     */
+    public static void add(@NonNull final Context context, @NonNull final String word) {
+        final List<String> words = list(context);
+        words.remove(word);
+        words.add(0, word);
+        save(context, words);
+    }
+
+    /**
+     * Removes a word.
+     *
+     * @param context any context
+     * @param word    the word to remove
+     */
+    public static void remove(@NonNull final Context context, @NonNull final String word) {
+        final List<String> words = list(context);
+        if (words.remove(word)) {
+            save(context, words);
+        }
+    }
+
+    /**
+     * @param context any context
+     * @param word    the word to check
+     * @return whether the word is in the book
+     */
+    public static boolean contains(@NonNull final Context context,
+                                   @NonNull final String word) {
+        return list(context).contains(word);
+    }
+
+    /**
+     * @param context any context
+     * @return the saved words, most recent first
+     */
+    @NonNull
+    public static List<String> list(@NonNull final Context context) {
+        final List<String> words = new ArrayList<>();
+        final String json = prefs(context).getString(KEY, null);
+        if (json == null) {
+            return words;
+        }
+        try {
+            final JSONArray array = new JSONArray(json);
+            for (int i = 0; i < array.length(); i++) {
+                final JSONObject item = array.optJSONObject(i);
+                final String word = item == null ? null : item.optString("word", "");
+                if (!word.isEmpty()) {
+                    words.add(word);
+                }
+            }
+        } catch (final JSONException e) {
+            // A corrupted list is replaced by the next save; reading an
+            // empty book is better than crashing the reader.
+        }
+        return words;
+    }
+
+    private static void save(@NonNull final Context context,
+                             @NonNull final List<String> words) {
+        final JSONArray array = new JSONArray();
+        for (final String word : words) {
+            final JSONObject item = new JSONObject();
+            try {
+                item.put("word", word);
+                item.put("time", System.currentTimeMillis());
+                array.put(item);
+            } catch (final JSONException e) {
+                // JSONObject.put with a non-null value never throws
+            }
+        }
+        prefs(context).edit().putString(KEY, array.toString()).apply();
+    }
+
+}
