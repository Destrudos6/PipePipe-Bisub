@@ -0,0 +1,52 @@
+package org.schabi.newpipe.bisub.wordlookup;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * One dictionary entry of a looked-up word, as shown in the word popup
+ * of the bilingual reader. The fields follow what the Youdao dictionary
+ * API returns for a word: phonetic transcription, one translation per
+ * sense, exam labels (like CET4 or postgraduate), word forms (past
+ * tense, plural, ...) and - as a fallback for phrases and unknown
+ * words - web translations.
+ */
+public final class WordEntry {
+
+    /** The word that was looked up. */
+    @NonNull public final String word;
+    /** Phonetic transcription (US), without slashes. */
+    @Nullable public final String phonetic;
+    /** URL of the pronunciation audio clip, playable when present. */
+    @Nullable public final String speechUrl;
+    /** Dictionary translations, one per sense, e.g. "n. 苹果". */
+    @NonNull public final List<String> translations = new ArrayList<>();
+    /** Exam labels, e.g. "CET4", "CET6", "考研". */
+    @NonNull public final List<String> examTypes = new ArrayList<>();
+    /** Word forms as label/value pairs, e.g. ["复数", "apples"]. */
+    @NonNull public final List<String[]> forms = new ArrayList<>();
+    /** Web translations as key/value pairs, used when no dictionary
+     *  entry exists (phrases, proper nouns). */
+    @NonNull public final List<String[]> webTranslations = new ArrayList<>();
+    /** Whether the word has a real dictionary entry. */
+    public final boolean isWord;
+
+    public WordEntry(@NonNull final String word, @Nullable final String phonetic,
+                     @Nullable final String speechUrl, final boolean isWord) {
+        this.word = word;
+        this.phonetic = phonetic;
+        this.speechUrl = speechUrl;
+        this.isWord = isWord;
+    }
+
+    /**
+     * @return whether the entry carries anything worth showing; an empty
+     *         entry renders as "no result"
+     */
+    public boolean isEmpty() {
+        return translations.isEmpty() && webTranslations.isEmpty() && forms.isEmpty();
+    }
+}
