new file mode 100644
index 000000000..41d44e7d0
--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/YoudaoDictionary.java
@@ -0,0 +1,265 @@
+package org.schabi.newpipe.bisub.wordlookup;
+
+import android.util.LruCache;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.schabi.newpipe.bisub.BisubLog;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+
+/**
+ * Word lookup through the Youdao web dictionary API
+ * ({@code dict.youdao.com/jsonapi}), the same endpoint the Youdao web
+ * dictionary uses. It returns exactly what a learner needs on a tapped
+ * word: phonetic transcription, per-sense Chinese translations, exam
+ * labels, word forms and web translations as a fallback for phrases.
+ *
+ * <p>Tapping a word is a rare, single-shot request, so rate limits are
+ * not a concern. Results are cached in an {@link LruCache}, so reading
+ * the same word again while browsing a transcript is instant and
+ * free.</p>
+ */
+public final class YoudaoDictionary {
+
+    private static final String TAG = YoudaoDictionary.class.getSimpleName();
+    private static final String ENDPOINT =
+            "https://dict.youdao.com/jsonapi?le=eng&q=";
+    /**
+     * Restricts the reply to the modules the popup shows: the
+     * English-Chinese dictionary and the web translations. This is the
+     * same parameter the Youdao web client sends, just without the
+     * encyclopedia and Chinese dictionary modules.
+     */
+    private static final String DICTS_PARAM =
+            "&dicts=%7B%22count%22%3A99%2C%22dicts%22%3A%5B%5B%22web_trans%22%2C%22ec%22%5D%5D%7D";
+
+    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
+            .connectTimeout(10, TimeUnit.SECONDS)
+            .readTimeout(10, TimeUnit.SECONDS)
+            .build();
+
+    /** Recently looked-up words, so re-taps while reading are instant. */
+    private static final LruCache<String, WordEntry> CACHE = new LruCache<>(256);
+
+    private YoudaoDictionary() {
+    }
+
+    /**
+     * Looks one word up, preferring the cache. Blocking network call:
+     * run off the main thread.
+     *
+     * @param word the word (or phrase) to look up
+     * @return the entry; translations and web translations may both be
+     *         empty when nothing was found
+     * @throws IOException on network errors
+     */
+    @NonNull
+    public static WordEntry lookup(@NonNull final String word) throws IOException {
+        final String key = word.toLowerCase();
+        final WordEntry cached = CACHE.get(key);
+        if (cached != null) {
+            return cached;
+        }
+        final Request request = new Request.Builder()
+                .url(ENDPOINT + encode(word) + DICTS_PARAM)
+                .header("User-Agent",
+                        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+                                + "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
+                .get()
+                .build();
+        final String body;
+        try (Response response = CLIENT.newCall(request).execute()) {
+            if (!response.isSuccessful() || response.body() == null) {
+                throw new IOException("Dictionary lookup failed: HTTP "
+                        + response.code());
+            }
+            body = response.body().string();
+        }
+        final WordEntry entry = parse(word, body);
+        CACHE.put(key, entry);
+        return entry;
+    }
+
+    @NonNull
+    private static String encode(@NonNull final String word) {
+        // OkHttp accepts pre-encoded URLs; the word may contain spaces
+        // when a phrase was passed, so percent-encode defensively.
+        return word.replace(" ", "%20");
+    }
+
+    /**
+     * Parses the jsonapi reply, following the field layout of the
+     * Youdao web client: {@code ec.word[0]} carries the phonetic
+     * transcription, the senses ({@code trs}) and the word forms
+     * ({@code wfs}), {@code ec.exam_type} the exam labels, and
+     * {@code web_trans.web-translation} the web translations.
+     *
+     * @param word the looked-up word
+     * @param body the response body
+     * @return the parsed entry, never {@code null}
+     */
+    @NonNull
+    private static WordEntry parse(@NonNull final String word,
+                                   @NonNull final String body) {
+        try {
+            final JSONObject root = new JSONObject(body);
+            String phonetic = null;
+            String speechUrl = null;
+            boolean isWord = false;
+            final JSONObject ec = root.optJSONObject("ec");
+            final JSONObject firstWord = firstEcWord(ec);
+            if (firstWord != null) {
+                isWord = true;
+                phonetic = optTrim(firstWord, "usphone");
+                final String speech = optTrim(firstWord, "usspeech");
+                if (speech != null) {
+                    speechUrl = "https://dict.youdao.com/dictvoice?audio=" + speech;
+                }
+            }
+            final WordEntry entry = new WordEntry(word, phonetic, speechUrl, isWord);
+            if (firstWord != null) {
+                final JSONArray trs = firstWord.optJSONArray("trs");
+                if (trs != null) {
+                    for (int i = 0; i < trs.length(); i++) {
+                        final String text = senseText(trs.optJSONObject(i));
+                        if (text != null && !text.isEmpty()) {
+                            entry.translations.add(text);
+                        }
+                    }
+                }
+                final JSONArray wfs = firstWord.optJSONArray("wfs");
+                if (wfs != null) {
+                    for (int i = 0; i < wfs.length(); i++) {
+                        final JSONObject wf = wfs.optJSONObject(i);
+                        final JSONObject form = wf == null
+                                ? null : wf.optJSONObject("wf");
+                        if (form == null) {
+                            continue;
+                        }
+                        final String name = optTrim(form, "name");
+                        final String value = optTrim(form, "value");
+                        if (name != null && value != null) {
+                            entry.forms.add(new String[]{name, value});
+                        }
+                    }
+                }
+            }
+            if (ec != null) {
+                final JSONArray examTypes = ec.optJSONArray("exam_type");
+                if (examTypes != null) {
+                    for (int i = 0; i < examTypes.length(); i++) {
+                        final String label = examTypes.optString(i, "");
+                        if (!label.isEmpty()) {
+                            entry.examTypes.add(label);
+                        }
+                    }
+                }
+            }
+            final JSONObject webTrans = root.optJSONObject("web_trans");
+            final JSONArray webArray = webTrans == null
+                    ? null : webTrans.optJSONArray("web-translation");
+            if (webArray != null) {
+                for (int i = 0; i < webArray.length(); i++) {
+                    final JSONObject item = webArray.optJSONObject(i);
+                    if (item == null) {
+                        continue;
+                    }
+                    final String phrase = optTrim(item, "key");
+                    final JSONArray trans = item.optJSONArray("trans");
+                    if (phrase == null || trans == null || trans.length() == 0) {
+                        continue;
+                    }
+                    final StringBuilder values = new StringBuilder();
+                    for (int t = 0; t < trans.length() && t < 3; t++) {
+                        final String value = optTrim(trans.optJSONObject(t), "value");
+                        if (value != null) {
+                            if (values.length() > 0) {
+                                values.append("；");
+                            }
+                            values.append(value);
+                        }
+                    }
+                    if (values.length() > 0) {
+                        entry.webTranslations.add(new String[]{phrase, values.toString()});
+                    }
+                }
+            }
+            BisubLog.i("word lookup '" + word + "': " + entry.translations.size()
+                    + " senses, " + entry.webTranslations.size() + " web, isWord="
+                    + entry.isWord);
+            return entry;
+        } catch (final JSONException e) {
+            BisubLog.w("word lookup '" + word + "': malformed reply");
+            return new WordEntry(word, null, null, false);
+        }
+    }
+
+    @Nullable
+    private static JSONObject firstEcWord(@Nullable final JSONObject ec) {
+        if (ec == null) {
+            return null;
+        }
+        final JSONArray words = ec.optJSONArray("word");
+        return words != null && words.length() > 0 ? words.optJSONObject(0) : null;
+    }
+
+    /**
+     * Reads one sense of the ec dictionary: {@code tr.l.i} holds the
+     * text, and {@code l.pos} may hold the part of speech.
+     *
+     * @param tr one element of the {@code trs} array
+     * @return the sense text like "n. 苹果", or {@code null}
+     */
+    @Nullable
+    private static String senseText(@Nullable final JSONObject tr) {
+        if (tr == null) {
+            return null;
+        }
+        final JSONObject l = tr.optJSONObject("l");
+        if (l == null) {
+            return null;
+        }
+        String text = null;
+        final JSONArray i = l.optJSONArray("i");
+        if (i != null) {
+            for (int k = 0; k < i.length(); k++) {
+                final Object part = i.opt(k);
+                final String piece = part instanceof String ? (String) part
+                        : part instanceof JSONObject
+                        ? ((JSONObject) part).optString("#text", "") : "";
+                if (!piece.isEmpty()) {
+                    text = text == null ? piece : text + piece;
+                }
+            }
+        } else {
+            text = optTrim(l, "i");
+        }
+        if (text == null || text.isEmpty()) {
+            return null;
+        }
+        final String pos = optTrim(l, "pos");
+        return pos == null ? text : pos + " " + text;
+    }
+
+    @Nullable
+    private static String optTrim(@Nullable final JSONObject object,
+                                  @NonNull final String key) {
+        if (object == null) {
+            return null;
+        }
+        final String value = object.optString(key, "");
+        final String trimmed = value.trim();
+        return trimmed.isEmpty() ? null : trimmed;
+    }
+
+}
