+
+    /**
+     * @param text      the row text
+     * @param secondary whether the row renders as secondary (word forms)
+     * @return one row of the popup content
+     */
+    @NonNull
+    private TextView row(@NonNull final String text, final boolean secondary) {
+        final TextView textView = new TextView(requireContext());
+        textView.setLayoutParams(new android.view.ViewGroup.LayoutParams(
+                android.view.ViewGroup.LayoutParams.MATCH_PARENT,
+                android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
+        final float density = getResources().getDisplayMetrics().density;
+        final int pad = (int) (secondary ? 2 * density : 4 * density);
+        textView.setPadding(0, pad, 0, pad);
+        textView.setTextSize(secondary ? 13 : 15);
+        // Theme attributes resolve differently per day/night theme, so
+        // they cannot be read as a static color.
+        textView.setTextColor(secondary
+                ? resolveThemeColor(android.R.attr.textColorTertiary)
