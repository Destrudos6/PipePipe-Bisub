                 app:iconSpaceReserved="false" />
 
+        <ListPreference
+                android:key="@string/bisub_cloud_backup_preset_key"
+                android:defaultValue="none"
+                android:entries="@array/bisub_cloud_backup_presets"
+                android:entryValues="@array/bisub_cloud_backup_preset_values"
+                android:title="@string/bisub_cloud_backup_preset_title"
+                android:summary="%s"
+                app:singleLineTitle="false"
+                app:iconSpaceReserved="false" />
+
         <EditTextPreference
                 android:key="@string/bisub_cloud_backup_webdav_url_key"
                 android:title="@string/bisub_cloud_backup_webdav_url_title"
