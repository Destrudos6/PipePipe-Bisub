     }
 
     /**
-     * Reads one sense of the ec dictionary: {@code tr.l.i} holds the
-     * text, and {@code l.pos} may hold the part of speech.
+     * Reads one sense of the ec dictionary: {@code trs[i].tr[0].l.i}
+     * holds the text (verified against the live API: the {@code tr}
+     * element is an array, and the part of speech is usually already
+     * part of the text, like "n. 苹果").
      *
-     * @param tr one element of the {@code trs} array
-     * @return the sense text like "n. 苹果", or {@code null}
+     * @param trsItem one element of the {@code trs} array
+     * @return the sense text, or {@code null}
      */
     @Nullable
-    private static String senseText(@Nullable final JSONObject tr) {
+    private static String senseText(@Nullable final JSONObject trsItem) {
+        if (trsItem == null) {
+            return null;
+        }
+        final JSONArray trArray = trsItem.optJSONArray("tr");
+        if (trArray == null || trArray.length() == 0) {
+            return null;
+        }
+        final JSONObject tr = trArray.optJSONObject(0);
         if (tr == null) {
             return null;
         }
