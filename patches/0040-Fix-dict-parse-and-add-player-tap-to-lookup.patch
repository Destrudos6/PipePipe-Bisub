@@ -277,10 +494,13 @@ public final class BisubSubtitleView extends View {
             final float translationAlpha =
                     Math.max(0.3f, Math.min(1f, style.translationAlpha));
             float y = top + padYPx;
+            hitLayers.add(new HitLayer(originalLayout, original, left + padXPx, y));
             y = drawLayout(canvas, originalLayout, left + padXPx, y,
                     style.backgroundMode == BisubStyle.BG_NONE, originalSize,
                     originalAlpha);
             if (translationLayout != null) {
+                hitLayers.add(new HitLayer(translationLayout, translation,
+                        left + padXPx, y + gapPx));
                 drawLayout(canvas, translationLayout, left + padXPx, y + gapPx,
                         style.backgroundMode == BisubStyle.BG_NONE,
                         translationSize, translationAlpha);
diff --git a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
new file mode 100644
