--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
@@ -0,0 +1,230 @@
+package org.schabi.newpipe.bisub.wordlookup;
+
+import android.content.Context;
+import android.media.MediaPlayer;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+
+import org.schabi.newpipe.R;
+
+import java.io.IOException;
+
+/**
+ * The dictionary popup for a tapped word, shared by the bilingual
+ * reader and the player's tap-to-lookup: it opens instantly with a
+ * "looking up" state, runs the (cached) Youdao lookup on a background
+ * thread and fills the phonetic transcription (tappable to play the
+ * pronunciation), the exam labels, the senses, the word forms and the
+ * web translations in place. The word-book button works on both the
+ * success and the failure path.
+ */
+public final class WordDialogHelper {
+
+    private static MediaPlayer speechPlayer;
+
+    private WordDialogHelper() {
+    }
+
+    /**
+     * Opens the dictionary popup for one word.
+     *
+     * @param context an activity context (the popup is a dialog)
+     * @param word    the tapped word
+     */
+    public static void show(@NonNull final Context context, @NonNull final String word) {
+        stopSpeech();
+        final View view = LayoutInflater.from(context)
+                .inflate(R.layout.dialog_bisub_word, null);
+        final TextView wordView = view.findViewById(R.id.bisub_word);
+        wordView.setText(word);
+        final ViewGroup content = view.findViewById(R.id.bisub_word_content);
+        content.addView(row(context, context.getString(R.string.bisub_word_looking_up), false));
+        final AlertDialog dialog;
+        try {
+            dialog = new AlertDialog.Builder(context)
+                    .setView(view)
+                    .show();
+        } catch (final IllegalArgumentException e) {
+            // The activity is finishing and cannot host a dialog.
+            return;
+        }
+        dialog.setOnDismissListener(d -> stopSpeech());
+
+        final Button bookButton = view.findViewById(R.id.bisub_word_book_button);
+        refreshBookButton(bookButton, word);
+        bookButton.setOnClickListener(v -> {
+            if (WordBook.contains(v.getContext(), word)) {
+                WordBook.remove(v.getContext(), word);
+                Toast.makeText(v.getContext(), R.string.bisub_word_book_removed,
+                        Toast.LENGTH_SHORT).show();
+            } else {
+                WordBook.add(v.getContext(), word);
+                Toast.makeText(v.getContext(), R.string.bisub_word_book_added,
+                        Toast.LENGTH_SHORT).show();
+            }
+            refreshBookButton(bookButton, word);
+        });
+
+        final Handler mainHandler = new Handler(Looper.getMainLooper());
+        new Thread(() -> {
+            WordEntry entry = null;
+            try {
+                entry = YoudaoDictionary.lookup(word);
+            } catch (final IOException e) {
+                // keep null: shown as a lookup failure below
+            }
+            final WordEntry result = entry;
+            mainHandler.post(() -> {
+                if (!dialog.isShowing()) {
+                    return;
+                }
+                fill(context, view, word, result);
+            });
+        }).start();
+    }
+
+    /**
+     * Fills the popup with the lookup result.
+     *
+     * @param context the popup's context
+     * @param view    the inflated popup layout
+     * @param word    the looked-up word
+     * @param entry   the lookup result, or {@code null} on failure
+     */
+    private static void fill(@NonNull final Context context, @NonNull final View view,
+                             @NonNull final String word, @Nullable final WordEntry entry) {
+        final TextView phoneticView = view.findViewById(R.id.bisub_word_phonetic);
+        final TextView examView = view.findViewById(R.id.bisub_word_exam);
+        final ViewGroup content = view.findViewById(R.id.bisub_word_content);
+        content.removeAllViews();
+        if (entry == null) {
+            content.addView(row(context,
+                    context.getString(R.string.bisub_word_lookup_failed), false));
+            return;
+        }
+        if (entry.phonetic != null) {
+            phoneticView.setText("/" + entry.phonetic + "/");
+            phoneticView.setOnClickListener(v -> {
+                if (entry.speechUrl != null) {
+                    playSpeech(context, entry.speechUrl);
+                } else {
+                    playSpeech(context, entry.word);
+                }
+            });
+        } else {
+            phoneticView.setOnClickListener(v -> playSpeech(context, entry.word));
+        }
+        examView.setText(TextUtils.join(" · ", entry.examTypes));
+        if (entry.isEmpty()) {
+            content.addView(row(context,
+                    context.getString(R.string.bisub_word_no_result), false));
+        }
+        for (final String translation : entry.translations) {
+            content.addView(row(context, translation, false));
+        }
+        if (!entry.forms.isEmpty()) {
+            final StringBuilder forms = new StringBuilder();
+            for (final String[] form : entry.forms) {
+                if (forms.length() > 0) {
+                    forms.append("；");
+                }
+                forms.append(form[0]).append(' ').append(form[1]);
+            }
+            content.addView(row(context, forms.toString(), true));
+        }
+        for (final String[] web : entry.webTranslations) {
+            content.addView(row(context, web[0] + "：" + web[1], false));
+        }
+    }
+
+    /**
+     * @param button the word book button
+     * @param word   the looked-up word
+     */
+    private static void refreshBookButton(@NonNull final Button button,
+                                          @NonNull final String word) {
+        if (WordBook.contains(button.getContext(), word)) {
+            button.setText(R.string.bisub_word_book_remove);
+        } else {
+            button.setText(R.string.bisub_word_book_add);
+        }
+    }
+
+    /**
+     * @param context   the popup's context
+     * @param text      the row text
+     * @param secondary whether the row renders as secondary (word forms)
+     * @return one row of the popup content
+     */
+    @NonNull
+    private static TextView row(@NonNull final Context context, @NonNull final String text,
+                                final boolean secondary) {
+        final TextView textView = new TextView(context);
+        textView.setLayoutParams(new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        final float density = context.getResources().getDisplayMetrics().density;
+        final int pad = (int) (secondary ? 2 * density : 4 * density);
+        textView.setPadding(0, pad, 0, pad);
+        textView.setTextSize(secondary ? 13 : 15);
+        textView.setTextColor(secondary
+                ? resolveThemeColor(context, android.R.attr.textColorTertiary)
+                : resolveThemeColor(context, android.R.attr.textColorPrimary));
+        return textView;
+    }
+
+    /**
+     * @param context the popup's context
+     * @param attr     a theme attribute like {@code android.R.attr.textColorPrimary}
+     * @return the resolved color for the current theme
+     */
+    private static int resolveThemeColor(@NonNull final Context context, final int attr) {
+        final TypedValue typedValue = new TypedValue();
+        context.getTheme().resolveAttribute(attr, typedValue, true);
+        if (typedValue.resourceId != 0) {
+            return context.getResources().getColor(typedValue.resourceId, null);
+        }
+        return typedValue.data;
+    }
+
+    /**
+     * Plays the pronunciation of the popup word, streaming the Youdao
+     * audio clip; when no clip exists, the word itself is spoken.
+     *
+     * @param context the popup's context
+     * @param audio   the audio URL or the word itself
+     */
+    private static void playSpeech(@NonNull final Context context,
+                                   @NonNull final String audio) {
+        stopSpeech();
+        try {
+            speechPlayer = new MediaPlayer();
+            speechPlayer.setDataSource(audio.startsWith("http")
+                    ? audio : "https://dict.youdao.com/dictvoice?audio=" + audio);
+            speechPlayer.setOnPreparedListener(MediaPlayer::start);
+            speechPlayer.setOnCompletionListener(MediaPlayer::release);
+            speechPlayer.prepareAsync();
+        } catch (final IOException e) {
+            Toast.makeText(context, R.string.bisub_word_lookup_failed,
+                    Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    private static void stopSpeech() {
+        if (speechPlayer != null) {
+            speechPlayer.release();
+            speechPlayer = null;
+        }
+    }
+}
\ No newline at end of file
