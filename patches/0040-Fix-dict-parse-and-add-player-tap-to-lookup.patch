@@ -80,6 +83,214 @@ public final class BisubSubtitleView extends View {
     /** Reference player height the preview lays out at; 0 disables it. */
     private float referenceHeightPx;
 
+    /**
+     * Receiver of the tap-to-lookup feature of the player: called with
+     * the word a tap landed on.
+     */
+    public interface OnWordClickListener {
+        /**
+         * @param word the tapped word of the original layer
+         */
+        void onWordClick(@NonNull String word);
+    }
+
+    /**
+     * Live gate evaluated on every touch-down, so tap-to-lookup follows
+     * the player state without this view holding a player reference.
+     */
+    public interface LookupGate {
+        /**
+         * @return whether tapping words is currently allowed
+         */
+        boolean isTapToLookupEnabled();
+    }
+
+    private OnWordClickListener wordClickListener;
+    private LookupGate lookupGate;
+
+    /** The text layers of the last draw, with their view offsets, for
+     *  the touch hit-test. Rebuilt on every draw. */
+    private final List<HitLayer> hitLayers = new ArrayList<>();
+
+    /** The word the ongoing gesture started on; null when it did not. */
+    @Nullable private String pressedWord;
+    private float downX;
+    private float downY;
+    private long downTime;
+    private int scaledTouchSlop;
+    /** Maximum duration of a tap that opens the dictionary. */
+    private static final long TAP_TIMEOUT_MS = 350L;
+
+    private static final class HitLayer {
+        final StaticLayout layout;
+        final String text;
+        final float x;
+        final float y;
+
+        HitLayer(@NonNull final StaticLayout layout, @NonNull final String text,
+                 final float x, final float y) {
+            this.layout = layout;
+            this.text = text;
+            this.x = x;
+            this.y = y;
+        }
+    }
+
+    /**
+     * Installs the tap-to-lookup callback: tapping a word of the
+     * original layer reports it here. The gate decides per touch-down
+     * whether the feature is active at all.
+     *
+     * @param listener the callback, or {@code null} to remove it
+     * @param gate     the gate, or {@code null} to disable the feature
+     */
+    public void setTapToLookup(@Nullable final OnWordClickListener listener,
+                               @Nullable final LookupGate gate) {
+        this.wordClickListener = listener;
+        this.lookupGate = listener == null ? null : gate;
+        this.scaledTouchSlop = listener == null
+                ? 0 : ViewConfiguration.get(getContext()).getScaledTouchSlop();
+        this.pressedWord = null;
+    }
+
+    /**
+     * Maps a touch position onto the word of the original layer it lands
+     * on, using the layout recorded by the last draw. Latin words
+     * (including embedded apostrophes and hyphens) are hit; anything
+     * else — punctuation, CJK text, digits — returns {@code null}, so
+     * those taps keep flowing to the player gestures.
+     *
+     * @param viewX the x position in view coordinates
+     * @param viewY the y position in view coordinates
+     * @return the tapped word, or {@code null} when none was hit
+     */
+    @Nullable
+    public String hitWord(final float viewX, final float viewY) {
+        if (isPreview()) {
+            return null;
+        }
+        // A little slack around each layer makes thin lines hittable.
+        final float slop = 12f * getResources().getDisplayMetrics().density;
+        for (int i = 0; i < hitLayers.size(); i++) {
+            final HitLayer layer = hitLayers.get(i);
+            if (viewY < layer.y - slop || viewY > layer.y + layer.layout.getHeight() + slop) {
+                continue;
+            }
+            if (viewX < layer.x - slop
+                    || viewX > layer.x + layer.layout.getWidth() + slop) {
+                continue;
+            }
+            final int line = layer.layout.getLineForVertical((int) (viewY - layer.y));
+            final int offset = layer.layout.getOffsetForHorizontal(line, viewX - layer.x);
+            final String word = wordAt(layer.text, offset);
+            if (word != null) {
+                return word;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Expands a character offset to the word it sits in.
+     *
+     * @param text   the layer text
+     * @param offset the character offset from the hit-test
+     * @return the word, or {@code null} when the offset is not inside
+     *         a Latin word
+     */
+    @Nullable
+    private static String wordAt(@NonNull final String text, int offset) {
+        if (offset < 0 || offset >= text.length()) {
+            return null;
+        }
+        if (!isWordChar(text.charAt(offset))) {
+            // The tap fell between characters: accept the one to the right.
+            if (offset + 1 < text.length() && isWordChar(text.charAt(offset + 1))) {
+                offset++;
+            } else {
+                return null;
+            }
+        }
+        int start = offset;
+        while (start > 0 && isWordChar(text.charAt(start - 1))) {
+            start--;
+        }
+        int end = offset;
+        while (end < text.length() && isWordChar(text.charAt(end))) {
+            end++;
+        }
+        // Trim dangling apostrophes or hyphens at the word edges.
+        while (start < end && !isLatinLetter(text.charAt(start))) {
+            start++;
+        }
+        while (end > start && !isLatinLetter(text.charAt(end - 1))) {
+            end--;
+        }
+        if (end - start < 1) {
+            return null;
+        }
+        final String word = text.substring(start, end);
+        if (word.length() == 1) {
+            final char c = word.charAt(0);
+            if (c != 'a' && c != 'A' && c != 'i' && c != 'I') {
+                return null;
+            }
+        }
+        return word;
+    }
+
+    private static boolean isWordChar(final char c) {
+        return isLatinLetter(c) || c == '\'' || c == '’' || c == '-';
+    }
+
+    private static boolean isLatinLetter(final char c) {
+        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+    }
+
+    @Override
+    public boolean onTouchEvent(@NonNull final MotionEvent event) {
+        if (wordClickListener == null || lookupGate == null || isPreview()) {
+            return false;
+        }
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                if (!lookupGate.isTapToLookupEnabled()) {
+                    return false;
+                }
+                downX = event.getX();
+                downY = event.getY();
+                downTime = event.getDownTime();
+                pressedWord = hitWord(downX, downY);
+                // Taking the gesture only when a word was hit keeps every
+                // other touch (tap-to-show-controls, double-tap seek,
+                // swipes) flowing to the player gestures untouched.
+                return pressedWord != null;
+            case MotionEvent.ACTION_UP:
+                if (pressedWord != null) {
+                    final float dx = event.getX() - downX;
+                    final float dy = event.getY() - downY;
+                    final boolean isTap = dx * dx + dy * dy
+                            <= (float) scaledTouchSlop * scaledTouchSlop
+                            && event.getEventTime() - downTime <= TAP_TIMEOUT_MS;
+                    if (isTap) {
+                        wordClickListener.onWordClick(pressedWord);
+                    }
+                    pressedWord = null;
+                    return true;
+                }
+                return false;
+            case MotionEvent.ACTION_CANCEL:
+                pressedWord = null;
+                return false;
+            default:
+                return pressedWord != null;
+        }
+    }
+
+    private boolean isPreview() {
+        return referenceWidthPx > 0 && referenceHeightPx > 0;
+    }
+
