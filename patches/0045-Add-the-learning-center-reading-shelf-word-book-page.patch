+package org.schabi.newpipe.settings;
+
+import android.content.Context;
+import android.content.DialogInterface;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.fragment.app.Fragment;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.BisubManager;
+import org.schabi.newpipe.bisub.ReaderShelf;
+import org.schabi.newpipe.util.PicassoHelper;
+import org.schabi.newpipe.util.ThemeHelper;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The reading list of the learning center: the bilingual subtitles the
+ * learner moved onto the reader shelf from the subtitle cache. Tapping
+ * one opens the bilingual reader; a long press takes it off the shelf
+ * (the cache entry itself stays until the cache cleanup catches it).
+ */
+public final class ReaderListFragment extends Fragment {
+
+    private RecyclerView recyclerView;
+    private TextView emptyView;
+    private final ReaderListAdapter adapter = new ReaderListAdapter();
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull final LayoutInflater inflater,
+                             @Nullable final ViewGroup container,
+                             @Nullable final Bundle savedInstanceState) {
+        final View root =
+                inflater.inflate(R.layout.fragment_bisub_cache, container, false);
+        recyclerView = root.findViewById(R.id.bisub_cache_list);
+        emptyView = root.findViewById(R.id.bisub_cache_empty);
+        emptyView.setText(R.string.bisub_reader_shelf_empty);
+        recyclerView.setLayoutManager(new LinearLayoutManager(requireContext()));
+        recyclerView.setAdapter(adapter);
+        return root;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        ThemeHelper.setTitleToAppCompatActivity(getActivity(),
+                getString(R.string.bisub_reader_shelf_title));
+        reload();
+    }
+
+    /**
+     * Lists the shelved subtitles on a background thread and swaps them
+     * into the list on the UI thread.
+     */
+    private void reload() {
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        new Thread(() -> {
+            final List<BisubManager.CachedSubtitle> shelved = new ArrayList<>();
+            for (final BisubManager.CachedSubtitle entry
+                    : BisubManager.getInstance(context).listCachedSubtitles()) {
+                if (entry.pinned) {
+                    shelved.add(entry);
+                }
+            }
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                adapter.setEntries(shelved);
+                final boolean empty = shelved.isEmpty();
+                emptyView.setVisibility(empty ? View.VISIBLE : View.GONE);
+                recyclerView.setVisibility(empty ? View.GONE : View.VISIBLE);
+            });
+        }).start();
+    }
+
+    /**
+     * Opens the bilingual reader page for a shelved subtitle, pushed on
+     * top of the shelf list in the settings fragment holder.
+     *
+     * @param entry the subtitle to read
+     */
+    private void openReader(@NonNull final BisubManager.CachedSubtitle entry) {
+        final BisubSubtitleReaderFragment reader = new BisubSubtitleReaderFragment();
+        reader.setArguments(BisubSubtitleReaderFragment.buildArguments(
+                entry.file.getAbsolutePath(), entry.title));
+        if (getActivity() == null) {
+            return;
+        }
+        getActivity().getSupportFragmentManager()
+                .beginTransaction()
+                .setCustomAnimations(R.animator.custom_fade_in,
+                        R.animator.custom_fade_out,
+                        R.animator.custom_fade_in, R.animator.custom_fade_out)
+                .replace(R.id.settings_fragment_holder, reader)
+                .addToBackStack(null)
+                .commit();
+    }
+
+    /**
+     * Asks for confirmation before a subtitle is taken off the shelf.
+     *
+     * @param context a context to build the dialog with
+     * @param entry   the subtitle to unshelve
+     */
+    private void confirmUnshelve(@NonNull final Context context,
+                                 @NonNull final BisubManager.CachedSubtitle entry) {
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_shelf_remove_title)
+                .setMessage(R.string.bisub_shelf_remove_message)
+                .setPositiveButton(R.string.bisub_shelf_remove,
+                        (final DialogInterface dialog, final int which) -> {
+                            ReaderShelf.remove(context,
+                                    ReaderShelf.idOf(entry.file.getName()));
+                            Toast.makeText(context, R.string.bisub_shelf_removed,
+                                    Toast.LENGTH_SHORT).show();
+                            reload();
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private final class ReaderListAdapter
+            extends RecyclerView.Adapter<ReaderListHolder> {
+        private final List<BisubManager.CachedSubtitle> entries = new ArrayList<>();
+
+        void setEntries(@NonNull final List<BisubManager.CachedSubtitle> newEntries) {
+            entries.clear();
+            entries.addAll(newEntries);
+            notifyDataSetChanged();
+        }
+
+        @NonNull
+        @Override
+        public ReaderListHolder onCreateViewHolder(@NonNull final ViewGroup parent,
+                                                   final int viewType) {
+            return new ReaderListHolder(LayoutInflater.from(parent.getContext())
+                    .inflate(R.layout.item_bisub_cache, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull final ReaderListHolder holder,
+                                     final int position) {
+            holder.bind(entries.get(position));
+        }
+
+        @Override
+        public int getItemCount() {
+            return entries.size();
+        }
+    }
+
+    private final class ReaderListHolder extends RecyclerView.ViewHolder {
+        private final ImageView thumbnailView;
+        private final TextView titleView;
+        private final TextView detailsView;
+
+        ReaderListHolder(@NonNull final View itemView) {
+            super(itemView);
+            thumbnailView = itemView.findViewById(R.id.bisub_cache_thumbnail);
+            titleView = itemView.findViewById(R.id.bisub_cache_title);
+            detailsView = itemView.findViewById(R.id.bisub_cache_details);
+        }
+
+        /**
+         * Fills one row: thumbnail, video title and the detail line with
+         * the target language and the shelving date.
+         *
+         * @param entry the subtitle to show
+         */
+        void bind(@NonNull final BisubManager.CachedSubtitle entry) {
+            titleView.setText(entry.title == null
+                    ? entry.file.getName() : entry.title);
+            final List<String> details = new ArrayList<>();
+            if (entry.targetLanguage != null && !entry.targetLanguage.isEmpty()) {
+                details.add(entry.targetLanguage);
+            }
+            details.add(getString(R.string.bisub_cached_lines_count, entry.cueCount));
+            details.add(new SimpleDateFormat("yyyy-MM-dd", Locale.getDefault())
+                    .format(new Date(entry.timestamp)));
+            detailsView.setText(TextUtils.join(" · ", details));
+            if (entry.videoId != null && entry.videoId.matches("[A-Za-z0-9_-]{11}")) {
+                PicassoHelper.loadThumbnail(
+                        "https://i.ytimg.com/vi/" + entry.videoId + "/mqdefault.jpg")
+                        .resize(192, 108)
+                        .centerCrop()
+                        .into(thumbnailView);
+            } else {
+                thumbnailView.setImageResource(R.drawable.dummy_thumbnail);
+            }
+            itemView.setOnClickListener(view -> openReader(entry));
+            itemView.setOnLongClickListener(view -> {
+                confirmUnshelve(view.getContext(), entry);
+                return true;
+            });
+        }
+    }
+}
