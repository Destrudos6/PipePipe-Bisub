+    /**
+     * Deletes the oldest unpinned cache entries until at most
+     * {@code threshold} entries remain, honoring the automatic cleanup
+     * setting. Subtitles on the reader shelf are never deleted, so the
+     * count can stay above the threshold when everything is shelved.
+     * Only touches disk; call from a background thread.
+     *
+     * @return how many entries were deleted
+     */
+    public int pruneCachedSubtitles() {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(appContext);
+        if (!prefs.getBoolean(appContext.getString(
+                R.string.bisub_cache_auto_clean_key), true)) {
+            return 0;
+        }
+        final int threshold;
+        final String value = prefs.getString(appContext.getString(
+                R.string.bisub_cache_auto_clean_threshold_key), "100");
+        try {
+            threshold = Math.max(1, Integer.parseInt(value));
+        } catch (final NumberFormatException e) {
+            return 0;
+        }
+        final List<CachedSubtitle> entries = listCachedSubtitles();
+        // entries is newest-first; the deletable tail is the oldest
+        // unpinned run at the end.
+        int deleted = 0;
+        for (int i = entries.size() - 1; i >= threshold && !entries.get(i).pinned; i--) {
+            if (deleteCachedSubtitle(entries.get(i))) {
+                deleted++;
+            } else {
+                break;
+            }
+        }
+        if (deleted > 0) {
+            Log.i(TAG, "Automatic cache cleanup removed " + deleted
+                    + " entr" + (deleted == 1 ? "y" : "ies")
+                    + " (threshold " + threshold + ")");
+        }
+        return deleted;
+    }
+
