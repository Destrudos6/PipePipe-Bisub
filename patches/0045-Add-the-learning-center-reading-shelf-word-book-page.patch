+package org.schabi.newpipe.settings;
+
+import android.os.Bundle;
+
+import androidx.annotation.Nullable;
+import androidx.preference.Preference;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.wordlookup.WordBook;
+
+/**
+ * First-level settings page of the learning center: the bilingual
+ * reading list and the word book, the two resources that turn watched
+ * videos into learning material. The word-book summary shows how many
+ * words it holds.
+ */
+public final class LearningCenterFragment extends BasePreferenceFragment {
+
+    @Override
+    public void onCreatePreferences(@Nullable final Bundle savedInstanceState,
+                                    @Nullable final String rootKey) {
+        addPreferencesFromResourceRegistry();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final Preference wordBook = findPreference(
+                getString(R.string.bisub_word_book_key));
+        if (wordBook != null) {
+            final int count = WordBook.list(requireContext()).size();
+            wordBook.setSummary(count == 0
+                    ? getString(R.string.bisub_word_book_summary)
+                    : getResources()
+                            .getQuantityString(R.plurals.bisub_word_book_count,
+                                    count, count));
+        }
+    }
