+package org.schabi.newpipe.settings;
+
+import android.content.Context;
+import android.content.DialogInterface;
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.fragment.app.Fragment;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.wordlookup.WordBook;
+import org.schabi.newpipe.bisub.wordlookup.WordDialogHelper;
+import org.schabi.newpipe.bisub.wordlookup.WordEntry;
+import org.schabi.newpipe.util.ThemeHelper;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The word book page of the learning center: every word the learner
+ * saved, as a compact card showing the word, its phonetic transcription
+ * and a preview of the locally cached definition. Tapping a card opens
+ * the shared dictionary popup, which reads the stored definition - no
+ * request, no rate limit, works offline; words saved before their
+ * definition was cached are fetched on demand and backfilled. A long
+ * press removes a word.
+ */
+public final class WordBookFragment extends Fragment {
+
+    private RecyclerView recyclerView;
+    private TextView emptyView;
+    private final WordBookAdapter adapter = new WordBookAdapter();
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull final LayoutInflater inflater,
+                             @Nullable final ViewGroup container,
+                             @Nullable final Bundle savedInstanceState) {
+        final View root =
+                inflater.inflate(R.layout.fragment_word_book, container, false);
+        recyclerView = root.findViewById(R.id.word_book_list);
+        emptyView = root.findViewById(R.id.word_book_empty);
+        recyclerView.setLayoutManager(new LinearLayoutManager(requireContext()));
+        recyclerView.setAdapter(adapter);
+        return root;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        ThemeHelper.setTitleToAppCompatActivity(getActivity(),
+                getString(R.string.bisub_word_book_title));
+        reload();
+    }
+
+    /**
+     * Reads the saved words with their cached definitions on a background
+     * thread and swaps them into the list on the UI thread.
+     */
+    private void reload() {
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        new Thread(() -> {
+            final List<WordCard> cards = new ArrayList<>();
+            for (final String word : WordBook.list(context)) {
+                cards.add(new WordCard(word, WordBook.getEntry(context, word),
+                        WordBook.timeOf(context, word)));
+            }
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                adapter.setCards(cards);
+                final boolean empty = cards.isEmpty();
+                emptyView.setVisibility(empty ? View.VISIBLE : View.GONE);
+                recyclerView.setVisibility(empty ? View.GONE : View.VISIBLE);
+            });
+        }).start();
+    }
+
+    /**
+     * One card of the list.
+     */
+    private static final class WordCard {
+        final String word;
+        @Nullable final WordEntry entry;
+        final long time;
+
+        WordCard(@NonNull final String word, @Nullable final WordEntry entry,
+                 final long time) {
+            this.word = word;
+            this.entry = entry;
+            this.time = time;
+        }
+    }
+
+    private final class WordBookAdapter
+            extends RecyclerView.Adapter<WordBookHolder> {
+        private final List<WordCard> cards = new ArrayList<>();
+
+        void setCards(@NonNull final List<WordCard> newCards) {
+            cards.clear();
+            cards.addAll(newCards);
+            notifyDataSetChanged();
+        }
+
+        @NonNull
+        @Override
+        public WordBookHolder onCreateViewHolder(@NonNull final ViewGroup parent,
+                                                 final int viewType) {
+            return new WordBookHolder(LayoutInflater.from(parent.getContext())
+                    .inflate(R.layout.item_word_book, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull final WordBookHolder holder,
+                                     final int position) {
+            holder.bind(cards.get(position));
+        }
+
+        @Override
+        public int getItemCount() {
+            return cards.size();
+        }
+    }
+
+    private final class WordBookHolder extends RecyclerView.ViewHolder {
+        private final TextView wordView;
+        private final TextView phoneticView;
+        private final TextView definitionView;
+        private final TextView timeView;
+
+        WordBookHolder(@NonNull final View itemView) {
+            super(itemView);
+            wordView = itemView.findViewById(R.id.word_book_word);
+            phoneticView = itemView.findViewById(R.id.word_book_phonetic);
+            definitionView = itemView.findViewById(R.id.word_book_definition);
+            timeView = itemView.findViewById(R.id.word_book_time);
+        }
+
+        /**
+         * Fills one card: the word, the phonetic transcription, a preview
+         * of the cached definition (or a hint that it will be fetched on
+         * demand) and the save date.
+         *
+         * @param card the card to show
+         */
+        void bind(@NonNull final WordCard card) {
+            wordView.setText(card.word);
+            phoneticView.setText(card.entry != null && card.entry.phonetic != null
+                    ? "/" + card.entry.phonetic + "/" : "");
+            definitionView.setText(card.entry != null
+                    && !card.entry.translations.isEmpty()
+                    ? firstLine(card.entry.translations.get(0))
+                    : getString(R.string.bisub_word_book_uncached));
+            timeView.setText(new SimpleDateFormat("MM-dd", Locale.getDefault())
+                    .format(new Date(card.time)));
+            itemView.setOnClickListener(view ->
+                    WordDialogHelper.show(view.getContext(), card.word));
+            itemView.setOnLongClickListener(view -> {
+                confirmRemove(view.getContext(), card.word);
+                return true;
+            });
+        }
+
+        private String firstLine(@NonNull final String translation) {
+            final int newline = translation.indexOf('\n');
+            return newline > 0 ? translation.substring(0, newline) : translation;
+        }
+    }
+
+    /**
+     * Asks for confirmation before a word is removed from the book.
+     *
+     * @param context a context to build the dialog with
+     * @param word    the word to remove
+     */
+    private void confirmRemove(@NonNull final Context context,
+                               @NonNull final String word) {
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_word_book_remove_title)
+                .setMessage(getString(R.string.bisub_word_book_remove_message, word))
+                .setPositiveButton(R.string.delete,
+                        (final DialogInterface dialog, final int which) -> {
+                            WordBook.remove(context, word);
+                            Toast.makeText(context, R.string.bisub_word_book_removed,
+                                    Toast.LENGTH_SHORT).show();
+                            reload();
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+}
