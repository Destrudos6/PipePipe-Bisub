+package org.schabi.newpipe.bisub;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+
+import androidx.preference.PreferenceManager;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The reader shelf: the bilingual subtitles the learner moved out of
+ * the plain subtitle cache into the learning center's reading list.
+ * A shelved subtitle is never touched by the automatic cache cleanup,
+ * so it stays readable - and keeps riding along in every backup -
+ * until the learner removes it.
+ *
+ * <p>Entries are the cache file base names (like
+ * {@code v7-2fa46a1e579d6e48}), stored as a JSON array in the default
+ * shared preferences, so the shelf rides along in every data export
+ * and cloud backup automatically.</p>
+ */
+public final class ReaderShelf {
+
+    private static final String KEY = "bisub_reader_shelf";
+
+    private ReaderShelf() {
+    }
+
+    /**
+     * @param fileBaseName the cache file name without extensions, used
+     *                     as the shelf entry id
+     * @return the normalized shelf id
+     */
+    @NonNull
+    public static String idOf(@NonNull final String fileBaseName) {
+        return fileBaseName.replaceAll("\\.(vtt|done|meta)$", "");
+    }
+
+    /**
+     * Puts a cached subtitle onto the shelf.
+     *
+     * @param context any context
+     * @param id      the shelf id of the subtitle
+     */
+    public static void add(@NonNull final Context context, @NonNull final String id) {
+        final List<String> ids = list(context);
+        if (!ids.contains(id)) {
+            ids.add(0, id);
+            save(context, ids);
+        }
+    }
+
+    /**
+     * Takes a subtitle off the shelf.
+     *
+     * @param context any context
+     * @param id      the shelf id of the subtitle
+     */
+    public static void remove(@NonNull final Context context, @NonNull final String id) {
+        final List<String> ids = list(context);
+        if (ids.remove(id)) {
+            save(context, ids);
+        }
+    }
+
+    /**
+     * @param context any context
+     * @param id      the shelf id of the subtitle
+     * @return whether the subtitle is on the shelf
+     */
+    public static boolean contains(@NonNull final Context context,
+                                   @NonNull final String id) {
+        return list(context).contains(id);
+    }
+
+    /**
+     * @param context any context
+     * @return the shelved ids, most recently shelved first
+     */
+    @NonNull
+    public static List<String> list(@NonNull final Context context) {
+        final List<String> ids = new ArrayList<>();
+        final String json = PreferenceManager
+                .getDefaultSharedPreferences(context.getApplicationContext())
+                .getString(KEY, null);
+        if (json == null) {
+            return ids;
+        }
+        try {
+            final JSONArray array = new JSONArray(json);
+            for (int i = 0; i < array.length(); i++) {
+                final JSONObject item = array.optJSONObject(i);
+                final String id = item == null ? null : item.optString("id", "");
+                if (!id.isEmpty()) {
+                    ids.add(id);
+                }
+            }
+        } catch (final JSONException e) {
+            // A corrupted shelf is replaced by the next save; reading an
+            // empty shelf is better than crashing the cache list.
+        }
+        return ids;
+    }
+
+    private static void save(@NonNull final Context context,
+                             @NonNull final List<String> ids) {
+        final JSONArray array = new JSONArray();
+        for (final String id : ids) {
+            final JSONObject item = new JSONObject();
+            try {
+                item.put("id", id);
+                item.put("time", System.currentTimeMillis());
+                array.put(item);
+            } catch (final JSONException e) {
+                // JSONObject.put with a non-null value never throws
+            }
+        }
+        PreferenceManager
+                .getDefaultSharedPreferences(context.getApplicationContext())
+                .edit().putString(KEY, array.toString()).apply();
+    }
+}
