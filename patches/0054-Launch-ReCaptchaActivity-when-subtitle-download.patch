From 3faa0bf2aae822605a4387a4f0c56cc684ac9994 Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Mon, 26 Oct 2026 12:30:09 +0800
Subject: [PATCH] 0054: Launch ReCaptchaActivity when subtitle download hits
 reCaptcha

Instead of silently swallowing ReCaptchaException and converting it
to an IOException, launch ReCaptchaActivity so the user can solve
the captcha. Once solved, the cookies are stored in DownloaderImpl
and the next subtitle download attempt will succeed.
---
 .../org/schabi/newpipe/bisub/BisubManager.java   | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/org/schabi/newpipe/bisub/BisubManager.java b/app/src/main/java/org/schabi/newpipe/bisub/BisubManager.java
index 49695c2e3..37cfb0356 100644
--- a/app/src/main/java/org/schabi/newpipe/bisub/BisubManager.java
+++ b/app/src/main/java/org/schabi/newpipe/bisub/BisubManager.java
@@ -1,6 +1,7 @@
 package org.schabi.newpipe.bisub;
 
 import android.content.Context;
+import android.content.Intent;
 import android.net.Uri;
 import android.os.Handler;
 import android.os.Looper;
@@ -14,6 +15,7 @@ import androidx.preference.PreferenceManager;
 import org.json.JSONException;
 import org.json.JSONObject;
 import org.schabi.newpipe.DownloaderImpl;
+import org.schabi.newpipe.error.ReCaptchaActivity;
 import android.content.SharedPreferences;
 
 import org.schabi.newpipe.R;
@@ -934,7 +936,7 @@ public final class BisubManager {
      */
     private void generateAndCache(@NonNull final CacheTarget target) throws IOException {
         final long deadline = System.currentTimeMillis() + TOTAL_BUDGET_MS;
-        final String original = downloadSubtitle(target.source.getContent());
+        final String original = downloadSubtitle(appContext, target.source.getContent());
         List<VttParser.Cue> cues = VttParser.parse(original);
         if (cues.isEmpty()) {
             Log.i(TAG, "Subtitle track could not be parsed into any cues (format="
@@ -1438,13 +1440,19 @@ public final class BisubManager {
     }
 
     @NonNull
-    private static String downloadSubtitle(@NonNull final String url) throws IOException {
+    private static String downloadSubtitle(@NonNull final Context context,
+                                           @NonNull final String url) throws IOException {
         final Response response;
         try {
             response = DownloaderImpl.getInstance().get(url);
         } catch (final ReCaptchaException e) {
-            // Subtitle downloads hitting a reCaptcha just mean no bilingual
-            // subtitles for this video; the button reports a failure.
+            // Launch the ReCaptcha challenge activity so the user can solve
+            // it. Once solved, the cookies are stored in DownloaderImpl and
+            // the next subtitle download attempt will succeed.
+            final Intent intent = new Intent(context, ReCaptchaActivity.class);
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            intent.putExtra(ReCaptchaActivity.RECAPTCHA_URL_EXTRA, url);
+            context.startActivity(intent);
             throw new IOException("ReCaptcha challenge while downloading subtitle", e);
         }
         final String body = response.responseBody();
-- 
