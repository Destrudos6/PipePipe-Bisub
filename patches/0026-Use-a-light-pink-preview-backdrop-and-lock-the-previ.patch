From ddc2167038da0f0633ae84e5e342a8cd0f1a6b4d Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Wed, 21 Oct 2026 07:25:40 +0800
Subject: [PATCH 26/51] Use a light pink preview backdrop and lock the preview
 to 16:9

The dark cinema gradient made style adjustments hard to read, so
the preview background is now a soft light-pink gradient.

The preview container was a fixed 180dp tall frame whose aspect
ratio (about 1.3-1.6 on phones) is narrower than the 16:9
reference frame the preview emulates. The uniform fit-to-contain
scale was therefore clamped by the width, leaving empty bands
above and below the miniature and diluting the caption-to-frame
ratio to roughly 4% instead of the real 5.33%. Locking the
container to a 16:9 ratio via ConstraintLayout makes the scaled
reference frame fill it exactly, matching fullscreen landscape
playback.
---
 .../res/drawable/bisub_preview_background.xml |  6 +++---
 .../main/res/layout/dialog_bisub_style.xml    | 20 +++++++++++++------
 2 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/app/src/main/res/drawable/bisub_preview_background.xml b/app/src/main/res/drawable/bisub_preview_background.xml
index da00593d1..1e24572b6 100644
--- a/app/src/main/res/drawable/bisub_preview_background.xml
+++ b/app/src/main/res/drawable/bisub_preview_background.xml
@@ -3,8 +3,8 @@
     android:shape="rectangle">
     <gradient
         android:angle="270"
-        android:startColor="#FF30303A"
-        android:centerColor="#FF1A1A21"
-        android:endColor="#FF0B0B0F"
+        android:startColor="#FFFDEFF5"
+        android:centerColor="#FFF8D8E6"
+        android:endColor="#FFF1C2D6"
         android:type="linear" />
 </shape>
diff --git a/app/src/main/res/layout/dialog_bisub_style.xml b/app/src/main/res/layout/dialog_bisub_style.xml
index d5d40bbba..0bf47a72e 100644
--- a/app/src/main/res/layout/dialog_bisub_style.xml
+++ b/app/src/main/res/layout/dialog_bisub_style.xml
@@ -8,17 +8,25 @@
     android:paddingTop="12dp">
 
     <!-- The preview stays fixed above the parameter tabs, so adjusting any
-         slider keeps the result visible without scrolling it off screen. -->
-    <FrameLayout
+         slider keeps the result visible without scrolling it off screen.
+         The container is locked to 16:9 so the scaled reference frame fills
+         it completely, keeping the caption-to-frame ratio identical to a
+         fullscreen landscape playback. -->
+    <androidx.constraintlayout.widget.ConstraintLayout
         android:layout_width="match_parent"
-        android:layout_height="180dp"
+        android:layout_height="wrap_content"
         android:background="@drawable/bisub_preview_background">
 
         <org.schabi.newpipe.bisub.BisubSubtitleView
             android:id="@+id/bisub_style_preview"
-            android:layout_width="match_parent"
-            android:layout_height="match_parent" />
-    </FrameLayout>
+            android:layout_width="0dp"
+            android:layout_height="0dp"
+            app:layout_constraintDimensionRatio="16:9"
+            app:layout_constraintStart_toStartOf="parent"
+            app:layout_constraintEnd_toEndOf="parent"
+            app:layout_constraintTop_toTopOf="parent"
+            app:layout_constraintBottom_toBottomOf="parent" />
+    </androidx.constraintlayout.widget.ConstraintLayout>
 
     <com.google.android.material.tabs.TabLayout
         android:id="@+id/bisub_style_tabs"
-- 
