+    /**
+     * Marks words as synced to the Maimemo cloud notepad.
+     *
+     * @param context any context
+     * @param words   the words that were confirmed in the notepad
+     */
+    public static void markSynced(@NonNull final Context context,
+                                  @NonNull final List<String> words) {
+        if (words.isEmpty()) {
+            return;
+        }
+        final List<Item> items = readItems(context);
+        boolean changed = false;
+        for (final Item item : items) {
+            if (!item.synced && words.contains(item.word)) {
+                item.synced = true;
+                item.syncTime = System.currentTimeMillis();
+                changed = true;
+            }
+        }
+        if (changed) {
+            writeItems(context, items);
+        }
+    }
+
+    /**
+     * @param context any context
+     * @param word    the word to check
+     * @return whether the word is marked as synced to Maimemo
+     */
+    public static boolean isSynced(@NonNull final Context context,
+                                   @NonNull final String word) {
+        for (final Item item : readItems(context)) {
+            if (item.word.equals(word)) {
+                return item.synced;
+            }
+        }
+        return false;
+    }
