+package org.schabi.newpipe.bisub.wordlookup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.PreferenceManager;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.BisubLog;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Client of the Maimemo open API, used to push the local word book into
+ * the user's Maimemo account as one cloud notepad named "BiPipe". The
+ * notepad is created (as a private one) when the token is first entered,
+ * and every synchronization appends the not-yet-synced words to it:
+ * incremental, idempotent (the existing content is read and de-duplicated
+ * before writing), and every word is written with the {@code //} prefix,
+ * which asks Maimemo to map inflected forms back to their base form (the
+ * prefix is a no-op for words that exist as entries of their own).
+ *
+ * <p>Response shape verified against the live API: every reply is wrapped
+ * in an {@code {errors, data, success}} envelope, the private notepad
+ * status is {@code UNPUBLISHED}, and the parsed word list of a notepad is
+ * produced asynchronously - it only shows up a few seconds after an
+ * update, so a synchronization confirms its words by re-reading the list
+ * after a pause instead of trusting the update reply.</p>
+ */
+public final class MaimemoClient {
+
+    private static final String TAG = MaimemoClient.class.getSimpleName();
+    private static final String BASE = "https://open.maimemo.com/open/api/v1";
+    private static final String NOTEPAD_TITLE = "BiPipe";
+    private static final String NOTEPAD_BRIEF = "BiPipe word book";
+    private static final MediaType JSON =
+            MediaType.parse("application/json; charset=utf-8");
+    /** Pause before re-reading the notepad after an update, because the
+     *  server parses the content asynchronously. */
+    private static final long PARSE_SETTLE_MS = 5000L;
+
+    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
+            .connectTimeout(15, TimeUnit.SECONDS)
+            .readTimeout(20, TimeUnit.SECONDS)
+            .build();
+
+    private MaimemoClient() {
+    }
+
+    /**
+     * @param context any context
+     * @return the stored Maimemo open API token, or {@code null}
+     */
+    @Nullable
+    public static String token(@NonNull final Context context) {
+        return PreferenceManager
+                .getDefaultSharedPreferences(context.getApplicationContext())
+                .getString(context.getString(R.string.bisub_maimemo_token_key), null);
+    }
+
+    /**
+     * Verifies the token by listing the account's notepads.
+     *
+     * @param token the Maimemo open API token
+     * @throws IOException when the token is rejected or the network fails
+     */
+    public static void testConnection(@NonNull final String token) throws IOException {
+        request(token, "GET", "/memo/notepads?limit=1", null);
+    }
+
+    /**
+     * Finds the account's "BiPipe" notepad, creating it (private) when it
+     * does not exist yet.
+     *
+     * @param token the Maimemo open API token
+     * @return the notepad id
+     * @throws IOException when the request fails
+     */
+    @NonNull
+    public static String ensureNotepad(@NonNull final String token) throws IOException {
+        // The list endpoint allows at most 10 per page; a word book the
+        // user maintains on the side rarely exceeds a few pages.
+        for (int offset = 0; offset < 200; offset += 10) {
+            final JSONObject body = request(token, "GET",
+                    "/memo/notepads?limit=10&offset=" + offset, null);
+            final JSONArray notepads = body.optJSONArray("notepads");
+            if (notepads == null) {
+                break;
+            }
+            for (int i = 0; i < notepads.length(); i++) {
+                final JSONObject notepad = notepads.optJSONObject(i);
+                if (notepad != null && NOTEPAD_TITLE.equals(notepad.optString("title"))) {
+                    final String id = notepad.optString("id", "");
+                    if (!id.isEmpty()) {
+                        return id;
+                    }
+                }
+            }
+            if (notepads.length() < 10) {
+                break;
+            }
+        }
+        final JSONObject content = new JSONObject();
+        try {
+            content.put("content", "bi pipe");
+            content.put("title", NOTEPAD_TITLE);
+            content.put("brief", NOTEPAD_BRIEF);
+            content.put("status", "UNPUBLISHED");
+            content.put("tags", new JSONArray());
+            final JSONObject envelope = new JSONObject();
+            envelope.put("notepad", content);
+            final JSONObject created = request(token, "POST", "/memo/notepads",
+                    envelope.toString());
+            final JSONObject notepad = created.optJSONObject("notepad");
+            final String id = notepad == null ? "" : notepad.optString("id", "");
+            if (id.isEmpty()) {
+                throw new IOException("Creating the BiPipe notepad failed");
+            }
+            BisubLog.i("maimemo: created notepad " + NOTEPAD_TITLE);
+            return id;
+        } catch (final JSONException e) {
+            throw new IOException("Building the notepad request failed: " + e.getMessage());
+        }
+    }
+
+    /**
+     * The outcome of one synchronization.
+     */
+    public static final class SyncResult {
+        /** The words confirmed present in the notepad after the update. */
+        @NonNull public final List<String> confirmed = new ArrayList<>();
+        /** The words that were sent but did not show up in the parsed
+         *  list (unknown to the Maimemo dictionary); they stay unsynced
+         *  and are retried by the next synchronization. */
+        @NonNull public final List<String> unknown = new ArrayList<>();
+        /** The notepad the words went into. */
+        @NonNull public final String notepadId;
+
+        SyncResult(@NonNull final String notepadId) {
+            this.notepadId = notepadId;
+        }
+    }
+
+    /**
+     * Appends the given words to the BiPipe notepad, skipping the ones it
+     * already contains, then re-reads the parsed list to confirm them.
+     *
+     * @param token the Maimemo open API token
+     * @param words the words to sync (raw, possibly inflected)
+     * @return the sync outcome
+     * @throws IOException when any request fails
+     */
+    @NonNull
+    public static SyncResult syncWords(@NonNull final String token,
+                                       @NonNull final List<String> words)
+            throws IOException {
+        final String notepadId = ensureNotepad(token);
+        final JSONObject current = request(token, "GET", "/memo/notepads/" + notepadId,
+                null).optJSONObject("notepad");
+        if (current == null) {
+            throw new IOException("Reading the BiPipe notepad failed");
+        }
+        final Set<String> existing = existingLines(current.optString("content", ""));
+        final List<String> fresh = new ArrayList<>();
+        for (final String word : words) {
+            if (!word.isEmpty() && !existing.contains(lineOf(word))) {
+                fresh.add(word);
+            }
+        }
+        if (fresh.isEmpty()) {
+            // Everything is already in the notepad: nothing to send, all
+            // words count as confirmed.
+            final SyncResult result = new SyncResult(notepadId);
+            result.confirmed.addAll(words);
+            return result;
+        }
+        final StringBuilder content = new StringBuilder(
+                current.optString("content", "").trim());
+        for (final String word : fresh) {
+            if (content.length() > 0) {
+                content.append('\n');
+            }
+            content.append(lineOf(word));
+        }
+        try {
+            final JSONObject notepad = new JSONObject();
+            notepad.put("content", content.toString());
+            notepad.put("title", NOTEPAD_TITLE);
+            notepad.put("brief", NOTEPAD_BRIEF);
+            notepad.put("status", "UNPUBLISHED");
+            notepad.put("tags", new JSONArray());
+            final JSONObject envelope = new JSONObject();
+            envelope.put("notepad", notepad);
+            request(token, "POST", "/memo/notepads/" + notepadId,
+                    envelope.toString());
+        } catch (final JSONException e) {
+            throw new IOException("Building the sync request failed: " + e.getMessage());
+        }
+        BisubLog.i("maimemo: appended " + fresh.size() + " word(s) to "
+                + NOTEPAD_TITLE);
+        // The server parses the content asynchronously: give it a moment
+        // before confirming the words from the parsed list.
+        try {
+            Thread.sleep(PARSE_SETTLE_MS);
+        } catch (final InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+        // A word counts as confirmed when it shows up in the parsed list
+        // (as itself, or as its base form when Maimemo mapped an inflected
+        // one), or when its line is part of the content now - the parse
+        // may still lag behind the write.
+        final Set<String> written = existingLines(content.toString());
+        final SyncResult result = new SyncResult(notepadId);
+        final JSONObject updated = request(token, "GET", "/memo/notepads/" + notepadId,
+                null).optJSONObject("notepad");
+        final Set<String> parsed = updated == null
+                ? new HashSet<>() : parsedWords(updated);
+        for (final String word : words) {
+            final boolean inList = parsed.contains(word.toLowerCase());
+            final boolean writtenLine = written.contains(lineOf(word));
+            final boolean existingLine = existing.contains(lineOf(word));
+            if (inList || writtenLine || existingLine || parsed.isEmpty()) {
+                result.confirmed.add(word);
+            } else {
+                result.unknown.add(word);
+            }
+        }
+        return result;
+    }
+
+    /**
+     * @param word the word to write
+     * @return the notepad line for it: the {@code //} prefix asks Maimemo
+     *         to map inflected forms to their base form
+     */
+    @NonNull
+    private static String lineOf(@NonNull final String word) {
+        return "//" + word.trim();
+    }
+
+    @NonNull
+    private static Set<String> existingLines(@NonNull final String content) {
+        final Set<String> lines = new HashSet<>();
+        for (final String line : content.split("\n")) {
+            final String trimmed = line.trim();
+            if (!trimmed.isEmpty()) {
+                lines.add(trimmed);
+            }
+        }
+        return lines;
+    }
+
+    @NonNull
+    private static Set<String> parsedWords(@NonNull final JSONObject notepad) {
+        final Set<String> words = new HashSet<>();
+        final JSONArray list = notepad.optJSONArray("list");
+        if (list == null) {
+            return words;
+        }
+        for (int i = 0; i < list.length(); i++) {
+            final JSONObject item = list.optJSONObject(i);
+            final String word = item == null ? "" : item.optString("word", "");
+            if (!word.isEmpty()) {
+                words.add(word.toLowerCase());
+            }
+        }
+        return words;
+    }
+
+    /**
+     * Sends one request and unwraps the {@code {errors, data, success}}
+     * envelope every endpoint uses.
+     *
+     * @param token the Maimemo open API token
+     * @param method the HTTP method
+     * @param path  the path below {@code /api/v1}, with query string
+     * @param body  the JSON request body, or {@code null} for GET
+     * @return the {@code data} object of the reply
+     * @throws IOException on network errors, non-2xx replies or
+     *                     {@code success:false} replies
+     */
+    @NonNull
+    private static JSONObject request(@NonNull final String token,
+                                      @NonNull final String method,
+                                      @NonNull final String path,
+                                      @Nullable final String body)
+            throws IOException {
+        final Request.Builder builder = new Request.Builder()
+                .url(BASE + path)
+                .header("Accept", "application/json")
+                .header("Authorization", "Bearer " + token);
+        if (body == null) {
+            builder.get();
+        } else {
+            builder.post(RequestBody.create(body, JSON));
+        }
+        final String text;
+        try (Response response = CLIENT.newCall(builder.build()).execute()) {
+            if (response.code() == 401) {
+                throw new IOException("The Maimemo token was rejected (401)");
+            }
+            text = response.body() == null ? "" : response.body().string();
+            if (!response.isSuccessful()) {
+                throw new IOException("Maimemo API error: HTTP " + response.code()
+                        + " " + text.substring(0, Math.min(200, text.length())));
+            }
+        }
+        try {
+            final JSONObject envelope = new JSONObject(text);
+            if (!envelope.optBoolean("success", false)) {
+                throw new IOException("Maimemo API rejected the request: "
+                        + text.substring(0, Math.min(200, text.length())));
+            }
+            final JSONObject data = envelope.optJSONObject("data");
+            return data == null ? new JSONObject() : data;
+        } catch (final JSONException e) {
+            throw new IOException("Malformed Maimemo reply: " + e.getMessage());
+        }
+    }
+}
