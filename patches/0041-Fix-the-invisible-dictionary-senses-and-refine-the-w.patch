+package org.schabi.newpipe.bisub.wordlookup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.LruCache;
+
+import androidx.annotation.NonNull;
+import androidx.preference.PreferenceManager;
+
+import org.schabi.newpipe.R;
+
+import java.io.IOException;
+
+/**
+ * Routes word lookups to the dictionary provider the user picked in the
+ * settings: the Youdao web dictionary (default; Chinese senses,
+ * phonetics, exam labels) or the free Microsoft translator endpoint
+ * (plain translations). Results are cached per provider, so re-tapping
+ * a word while reading is instant and free.
+ */
+public final class WordLookupService {
+
+    /** Provider value of the Youdao web dictionary. */
+    public static final String PROVIDER_YOUDAO = "youdao";
+    /** Provider value of the free Microsoft translator endpoint. */
+    public static final String PROVIDER_MICROSOFT = "microsoft";
+
+    private static final LruCache<String, WordEntry> CACHE = new LruCache<>(256);
+
+    private WordLookupService() {
+    }
+
+    /**
+     * Looks one word up with the configured provider. Blocking network
+     * call: run off the main thread.
+     *
+     * @param context any context
+     * @param word    the word to look up
+     * @return the entry; the fields the provider cannot fill stay empty
+     * @throws IOException on network errors
+     */
+    @NonNull
+    public static WordEntry lookup(@NonNull final Context context,
+                                    @NonNull final String word) throws IOException {
+        final SharedPreferences prefs =
+                PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+        final String provider = prefs.getString(
+                context.getString(R.string.bisub_dictionary_provider_key), PROVIDER_YOUDAO);
+        final String cacheKey = provider + ':' + word.toLowerCase();
+        final WordEntry cached = CACHE.get(cacheKey);
+        if (cached != null) {
+            return cached;
+        }
+        final WordEntry entry;
+        if (PROVIDER_MICROSOFT.equals(provider)) {
+            entry = MicrosoftDictionary.lookup(word, prefs.getString(
+                    context.getString(R.string.bisub_target_lang_key), null));
+        } else {
+            entry = YoudaoDictionary.lookup(word);
+        }
+        CACHE.put(cacheKey, entry);
+        return entry;
+    }
+}
