+package org.schabi.newpipe.bisub.wordlookup;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.schabi.newpipe.bisub.BisubLog;
+import org.schabi.newpipe.bisub.SubtitleTranslator;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.HttpUrl;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Word lookup through the free Microsoft translator endpoint
+ * ({@code edge.microsoft.com/translate/translatetext}) — the same
+ * endpoint the subtitle translation already uses for its free
+ * Microsoft engine. It answers with a plain translation instead of a
+ * dictionary entry (no phonetics, no senses, no exam labels), which
+ * makes it the lightweight fallback for users the Youdao dictionary
+ * does not work for.
+ */
+public final class MicrosoftDictionary {
+
+    private static final MediaType JSON =
+            MediaType.parse("application/json; charset=utf-8");
+    private static final String USER_AGENT =
+            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+                    + "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36";
+
+    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
+            .connectTimeout(10, TimeUnit.SECONDS)
+            .readTimeout(10, TimeUnit.SECONDS)
+            .build();
+
+    private MicrosoftDictionary() {
+    }
+
+    /**
+     * Looks one word up by translating it. Blocking network call: run
+     * off the main thread.
+     *
+     * @param word           the word to look up
+     * @param targetLanguage the user's subtitle target language, used as
+     *                       the translation target
+     * @return the entry with the translation as its single sense
+     * @throws IOException on network errors
+     */
+    @NonNull
+    public static WordEntry lookup(@NonNull final String word,
+                                    @Nullable final String targetLanguage)
+            throws IOException {
+        final String target = SubtitleTranslator.engineTargetCode(
+                "microsoft", SubtitleTranslator.normalizeLanguage(targetLanguage));
+        final HttpUrl url = HttpUrl
+                .parse("https://edge.microsoft.com/translate/translatetext")
+                .newBuilder()
+                .addQueryParameter("from", "")
+                .addQueryParameter("to", target == null ? "zh-Hans" : target)
+                .addQueryParameter("isEnterpriseClient", "false")
+                .build();
+        final JSONArray texts = new JSONArray();
+        texts.put(word);
+        final Request request = new Request.Builder()
+                .url(url)
+                .header("User-Agent", USER_AGENT)
+                .post(RequestBody.create(texts.toString(), JSON))
+                .build();
+        final String body;
+        try (Response response = CLIENT.newCall(request).execute()) {
+            if (!response.isSuccessful() || response.body() == null) {
+                throw new IOException("Dictionary lookup failed: HTTP "
+                        + response.code());
+            }
+            body = response.body().string();
+        }
+        final WordEntry entry = new WordEntry(word, null, null, true);
+        try {
+            final JSONArray reply = new JSONArray(body);
+            final JSONObject item = reply.length() > 0 ? reply.optJSONObject(0) : null;
+            final JSONArray translations = item == null
+                    ? null : item.optJSONArray("translations");
+            final JSONObject first = translations != null && translations.length() > 0
+                    ? translations.optJSONObject(0) : null;
+            final String text = first == null ? null : first.optString("text", "");
+            if (text != null && !text.trim().isEmpty()) {
+                entry.translations.add(text.trim());
+            }
+        } catch (final JSONException e) {
+            BisubLog.w("microsoft word lookup '" + word + "': malformed reply");
+        }
+        return entry;
+    }
+}
