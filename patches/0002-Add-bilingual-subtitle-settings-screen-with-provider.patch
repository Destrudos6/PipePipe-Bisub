+
+        <org.schabi.newpipe.views.NewPipeTextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+
+            android:text="@string/bisub_style_text_color" />
+
+        <RadioGroup
+            android:id="@+id/bisub_style_text_color_group"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal">
+
+            <RadioButton
+                android:id="@+id/bisub_color_white"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginEnd="8dp"
+                android:buttonTint="#FFFFFF" />
+
+            <RadioButton
+                android:id="@+id/bisub_color_yellow"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginEnd="8dp"
+                android:buttonTint="#FFFF00" />
+
+            <RadioButton
+                android:id="@+id/bisub_color_cyan"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginEnd="8dp"
+                android:buttonTint="#00FFFF" />
+
+            <RadioButton
+                android:id="@+id/bisub_color_green"
+                android:layout_width="wrap_content"
