+package org.schabi.newpipe.settings;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.RadioGroup;
+import android.widget.SeekBar;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.EditTextPreference;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceManager;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.google.android.exoplayer2.text.Cue;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.BisubPrefs;
+import org.schabi.newpipe.bisub.BisubStyle;
+import org.schabi.newpipe.bisub.BisubSubtitleView;
+import org.schabi.newpipe.bisub.SubtitleTranslator;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Settings fragment for the bilingual subtitle (bisub) feature.
+ *
+ * <p>Selecting a known provider automatically fills in the API base URL and
+ * the model name, unless the user has customized them. The API key summary
+ * only shows whether a key is set, never the key itself. The master switch
+ * summary always reflects the current configuration state and a test button
+ * sends a one-line probe request through the whole translation pipeline.</p>
+ */
+public class BisubSettingsFragment extends BasePreferenceFragment {
+
+    /**
+     * Base URL and default model for every built-in provider.
+     * Keys match the values of {@code bisub_provider_values}.
+     */
+    private static final Map<String, String[]> PROVIDER_PRESETS = new HashMap<>();
+
+    static {
+        PROVIDER_PRESETS.put("openai",
+                new String[]{"https://api.openai.com/v1", "gpt-4o-mini"});
+        PROVIDER_PRESETS.put("deepseek",
+                new String[]{"https://api.deepseek.com/v1", "deepseek-chat"});
+        PROVIDER_PRESETS.put("moonshot",
+                new String[]{"https://api.moonshot.cn/v1", "moonshot-v1-8k"});
+        PROVIDER_PRESETS.put("zhipu",
+                new String[]{"https://open.bigmodel.cn/api/paas/v4", "glm-4-flash"});
+        PROVIDER_PRESETS.put("openrouter",
+                new String[]{"https://openrouter.ai/api/v1", "openrouter/auto"});
+    }
+
+    private SharedPreferences prefs;
+
+    /**
+     * Keeps the master switch summary in sync while the user edits any
+     * bisub preference on this screen.
+     */
+    private final SharedPreferences.OnSharedPreferenceChangeListener prefChangeListener =
+            (final SharedPreferences sharedPreferences, final String key) -> {
+                if (getString(R.string.bisub_enable_key).equals(key)
+                        || getString(R.string.bisub_base_url_key).equals(key)
+                        || getString(R.string.bisub_api_key_key).equals(key)
+                        || getString(R.string.bisub_model_key).equals(key)
+                        || getString(R.string.bisub_target_lang_key).equals(key)) {
+                    refreshEnableSummary();
+                }
+            };
+
+    @Override
+    public void onCreatePreferences(@Nullable final Bundle savedInstanceState,
+                                    @Nullable final String rootKey) {
+        addPreferencesFromResourceRegistry();
+
+        prefs = PreferenceManager.getDefaultSharedPreferences(requireContext());
+
+        setupProviderPreset();
+        setupApiKeySummary();
+        setupTestButton();
+        setupCaptionStyleButton();
+        prefs.registerOnSharedPreferenceChangeListener(prefChangeListener);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshEnableSummary();
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        if (prefs != null) {
+            prefs.unregisterOnSharedPreferenceChangeListener(prefChangeListener);
+        }
+    }
+
+    private void setupProviderPreset() {
+        final ListPreference providerPref =
+                (ListPreference) requirePreference(R.string.bisub_provider_key);
+        providerPref.setOnPreferenceChangeListener((final Preference p,
+                                                    final Object newValue) -> {
+            final String[] preset = PROVIDER_PRESETS.get(String.valueOf(newValue));
+            if (preset != null) {
+                final SharedPreferences.Editor editor = prefs.edit();
+                editor.putString(getString(R.string.bisub_base_url_key), preset[0]);
+                editor.putString(getString(R.string.bisub_model_key), preset[1]);
+                editor.apply();
+                // Also refresh the visible preferences immediately
+                final EditTextPreference baseUrlPref =
+                        (EditTextPreference) requirePreference(R.string.bisub_base_url_key);
+                baseUrlPref.setText(preset[0]);
+                final EditTextPreference modelPref =
+                        (EditTextPreference) requirePreference(R.string.bisub_model_key);
+                modelPref.setText(preset[1]);
+            }
+            refreshEnableSummary();
+            return true;
+        });
+    }
+
+    private void setupApiKeySummary() {
+        final EditTextPreference apiKeyPref =
+                (EditTextPreference) requirePreference(R.string.bisub_api_key_key);
+        apiKeyPref.setSummary(isBlank(prefs.getString(
+                getString(R.string.bisub_api_key_key), null))
+                ? getString(R.string.bisub_api_key_unset)
+                : getString(R.string.bisub_api_key_set));
+
+        apiKeyPref.setOnPreferenceChangeListener((final Preference p,
+                                                  final Object newValue) -> {
+            final String value = newValue == null ? null : String.valueOf(newValue);
+            p.setSummary(isBlank(value)
+                    ? getString(R.string.bisub_api_key_unset)
+                    : getString(R.string.bisub_api_key_set));
+            return true;
+        });
+    }
+
+    /**
+     * Updates the master switch summary so the user can immediately see
+     * whether bisub is enabled and whether the configuration is complete.
+     */
+    private void refreshEnableSummary() {
+        final SwitchPreferenceCompat enablePref =
+                (SwitchPreferenceCompat) requirePreference(R.string.bisub_enable_key);
+        if (!enablePref.isChecked()) {
+            enablePref.setSummary(R.string.bisub_enable_summary);
+            return;
+        }
+        final int missingResId = findMissingFieldResId();
+        if (missingResId != 0) {
+            enablePref.setSummary(getString(R.string.bisub_status_incomplete,
+                    getString(missingResId)));
+        } else {
+            enablePref.setSummary(R.string.bisub_status_ready);
+        }
+    }
+
+    /**
+     * @return the string resource of the first missing required field,
+     *         or {@code 0} when the configuration is complete
+     */
+    private int findMissingFieldResId() {
+        if (isBlank(prefs.getString(getString(R.string.bisub_base_url_key), null))) {
+            return R.string.bisub_missing_base_url;
+        }
+        if (isBlank(prefs.getString(getString(R.string.bisub_api_key_key), null))) {
+            return R.string.bisub_missing_api_key;
+        }
+        if (isBlank(prefs.getString(getString(R.string.bisub_model_key), null))) {
+            return R.string.bisub_missing_model;
+        }
+        if (isBlank(prefs.getString(getString(R.string.bisub_target_lang_key), null))) {
+            return R.string.bisub_missing_target_lang;
+        }
+        return 0;
+    }
+
+    private void setupTestButton() {
+        final Preference testPref = requirePreference(R.string.bisub_test_connection_key);
+        testPref.setOnPreferenceClickListener((final Preference p) -> {
+            runConnectionTest();
+            return true;
+        });
+    }
+
+    /**
+     * Runs the API probe on a background thread and shows the result in a
+     * dialog on the UI thread.
+     */
+    private void runConnectionTest() {
+        final Context context = requireContext();
+        final BisubPrefs.Config cfg = BisubPrefs.load(context);
+        if (!cfg.isUsable()) {
+            showTestResult(context, false, getString(R.string.bisub_test_missing_config));
+            return;
+        }
+
+        final Preference testPref = requirePreference(R.string.bisub_test_connection_key);
+        testPref.setEnabled(false);
+        testPref.setSummary(R.string.bisub_test_running);
+        final long started = System.currentTimeMillis();
+
+        new Thread(() -> {
+            boolean success = false;
+            String message;
+            try {
+                final String translated = SubtitleTranslator.testConnection(cfg);
+                success = true;
+                message = getString(R.string.bisub_test_result_success_format,
+                        System.currentTimeMillis() - started, translated);
+            } catch (final Exception e) {
+                message = e.getMessage() == null ? e.getClass().getSimpleName()
+                        : e.getMessage();
+            }
+            final boolean ok = success;
+            final String result = message;
+            if (getActivity() == null) {
+                return;
+            }
+            getActivity().runOnUiThread(() -> {
+                testPref.setEnabled(true);
+                testPref.setSummary(R.string.bisub_test_connection_summary);
+                showTestResult(context, ok, result);
+            });
+        }).start();
+    }
+
+    private void showTestResult(@NonNull final Context context, final boolean success,
+                                @NonNull final String message) {
+        if (getActivity() == null) {
+            return;
+        }
+        new AlertDialog.Builder(context)
+                .setTitle(success ? R.string.bisub_test_success : R.string.bisub_test_failed)
+                .setMessage(message)
+                .setPositiveButton(android.R.string.ok, null)
+                .show();
+    }
+
+    /**
+     * Opens the in-app bilingual subtitle style editor with a live preview.
+     * The preview uses the very same {@link BisubSubtitleView} the player
+     * uses, so what the user sees in the dialog is exactly what the
+     * bilingual track will look like. This replaces the old shortcut to the
+     * Android system caption settings, which does not exist on HarmonyOS.
+     */
+    private void setupCaptionStyleButton() {
+        final Preference stylePref = requirePreference(R.string.bisub_caption_style_key);
+        stylePref.setOnPreferenceClickListener((final Preference p) -> {
+            showStyleDialog();
+            return true;
+        });
+    }
+
+    /**
+     * Text colors offered in the style editor, in the same order as the
+     * radio buttons in {@code dialog_bisub_style.xml}.
+     */
+    private static final int[] TEXT_COLORS =
+            {0xFFFFFFFF, 0xFFFFFF00, 0xFF00FFFF, 0xFF00FF00};
+
+    private void showStyleDialog() {
+        final Context context = requireContext();
+        final View view = LayoutInflater.from(context)
+                .inflate(R.layout.dialog_bisub_style, null);
+
+        final BisubSubtitleView preview = view.findViewById(R.id.bisub_style_preview);
+        // Lay the preview out at a reference player size and scale the whole
+        // drawing down: font sizes, wrap points and spacing then match
+        // fullscreen playback exactly, instead of wrapping early inside the
+        // narrow dialog box.
+        preview.setReferenceSize(640f, 400f);
+        final SeekBar baseScaleBar = view.findViewById(R.id.bisub_style_base_scale);
+
+        final SeekBar paddingBar = view.findViewById(R.id.bisub_style_padding);
+        final SeekBar cornerRadiusBar = view.findViewById(R.id.bisub_style_corner_radius);
+        final SeekBar maxWidthBar = view.findViewById(R.id.bisub_style_max_width);
+        final SeekBar positionBar = view.findViewById(R.id.bisub_style_position);
+        final RadioGroup textColorGroup = view.findViewById(R.id.bisub_style_text_color_group);
+        final RadioGroup backgroundGroup = view.findViewById(R.id.bisub_style_background_group);
+
+        final BisubPrefs.Style initial = BisubPrefs.loadStyle(context);
+        final BisubPrefs.Style[] current = {initial};
+
+        baseScaleBar.setProgress(Math.round(initial.baseScale * 10));
+
+        paddingBar.setProgress(Math.round(initial.paddingDp));
+        cornerRadiusBar.setProgress(Math.round(initial.cornerRadiusDp));
+        maxWidthBar.setProgress(Math.round(initial.maxWidthPercent * 10));
+        positionBar.setProgress(Math.round(initial.positionPercent * 100));
+        checkColorButton(textColorGroup, initial.textColor);
+        checkBackgroundButton(backgroundGroup, initial.backgroundMode);
+
+        preview.setCues(Collections.singletonList(new Cue.Builder()
+                .setText(getString(R.string.bisub_style_preview_original) + "\n"
+                        + getString(R.string.bisub_style_preview_translation))
+                .build()));
+
+        final Runnable updatePreview = () -> {
+            BisubStyle.applyTo(preview, current[0]);
+        };
+
+        final SeekBar.OnSeekBarChangeListener barListener =
+                new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(final SeekBar seekBar, final int progress,
+                                          final boolean fromUser) {
+                // switch is not possible here: R.id fields are not
+                // compile-time constants in this project
+                final int id = seekBar.getId();
+                if (id == R.id.bisub_style_base_scale) {
+                    current[0] = new BisubPrefs.Style(
+                            // No android:min on the bar (minSdk 23), clamp
+                            Math.max(0.4f, progress / 10.0f),
+                            current[0].textColor, current[0].backgroundMode,
+                            current[0].paddingDp, current[0].cornerRadiusDp,
+                            current[0].maxWidthPercent, current[0].positionPercent);
+                } else if (id == R.id.bisub_style_padding) {
+                    current[0] = new BisubPrefs.Style(current[0].baseScale,
+                            current[0].textColor, current[0].backgroundMode,
+                            progress, current[0].cornerRadiusDp,
+                            current[0].maxWidthPercent, current[0].positionPercent);
+                } else if (id == R.id.bisub_style_corner_radius) {
+                    current[0] = new BisubPrefs.Style(current[0].baseScale,
+                            current[0].textColor, current[0].backgroundMode,
+                            current[0].paddingDp, progress,
+                            current[0].maxWidthPercent, current[0].positionPercent);
+                } else if (id == R.id.bisub_style_max_width) {
+                    current[0] = new BisubPrefs.Style(current[0].baseScale,
+                            current[0].textColor, current[0].backgroundMode,
+                            current[0].paddingDp, current[0].cornerRadiusDp,
+                            // Map the 5..10 slider range to 0.5..1.0, clamped
+                            // (there is no android:min below API 26)
+                            Math.max(0.5f, progress / 10.0f),
+                            current[0].positionPercent);
+                } else if (id == R.id.bisub_style_position) {
+                    current[0] = new BisubPrefs.Style(current[0].baseScale,
+                            current[0].textColor, current[0].backgroundMode,
+                            current[0].paddingDp, current[0].cornerRadiusDp,
+                            current[0].maxWidthPercent, progress / 100.0f);
+                } else {
+                    return;
+                }
+                updatePreview.run();
+            }
+
+            @Override
+            public void onStartTrackingTouch(final SeekBar seekBar) { }
+
+            @Override
+            public void onStopTrackingTouch(final SeekBar seekBar) { }
+        };
+        baseScaleBar.setOnSeekBarChangeListener(barListener);
+
+        paddingBar.setOnSeekBarChangeListener(barListener);
+        cornerRadiusBar.setOnSeekBarChangeListener(barListener);
+        maxWidthBar.setOnSeekBarChangeListener(barListener);
+        positionBar.setOnSeekBarChangeListener(barListener);
+
+        textColorGroup.setOnCheckedChangeListener((final RadioGroup group, final int id) -> {
+            for (int i = 0; i < TEXT_COLORS.length; i++) {
+                if (id == colorButtonId(i)) {
+                    current[0] = new BisubPrefs.Style(current[0].baseScale,
+
+                            TEXT_COLORS[i], current[0].backgroundMode,
+                            current[0].paddingDp, current[0].cornerRadiusDp,
+                            current[0].maxWidthPercent, current[0].positionPercent);
+                    updatePreview.run();
+                    return;
+                }
+            }
+        });
+
+        backgroundGroup.setOnCheckedChangeListener((final RadioGroup group, final int id) -> {
+            final int mode = id == R.id.bisub_bg_opaque ? BisubStyle.BG_OPAQUE
+                    : id == R.id.bisub_bg_none ? BisubStyle.BG_NONE
+                    : BisubStyle.BG_TRANSLUCENT;
+            current[0] = new BisubPrefs.Style(current[0].baseScale,
+
+                    current[0].textColor, mode,
+                    current[0].paddingDp, current[0].cornerRadiusDp,
+                    current[0].maxWidthPercent, current[0].positionPercent);
+            updatePreview.run();
+        });
+
+        updatePreview.run();
+
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.bisub_caption_style_title)
+                .setView(view)
+                .setPositiveButton(android.R.string.ok, (dialog, which) ->
+                        BisubPrefs.saveStyle(context, current[0]))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private int colorButtonId(final int index) {
+        switch (index) {
+            case 1: return R.id.bisub_color_yellow;
+            case 2: return R.id.bisub_color_cyan;
+            case 3: return R.id.bisub_color_green;
+            default: return R.id.bisub_color_white;
+        }
+    }
+
+    private void checkColorButton(final RadioGroup group, final int textColor) {
+        for (int i = 0; i < TEXT_COLORS.length; i++) {
+            if (textColor == TEXT_COLORS[i]) {
+                group.check(colorButtonId(i));
+                return;
+            }
+        }
+        group.check(R.id.bisub_color_white);
+    }
+
+    private void checkBackgroundButton(final RadioGroup group, final int backgroundMode) {
+        if (backgroundMode == BisubStyle.BG_OPAQUE) {
+            group.check(R.id.bisub_bg_opaque);
+        } else if (backgroundMode == BisubStyle.BG_NONE) {
+            group.check(R.id.bisub_bg_none);
+        } else {
+            group.check(R.id.bisub_bg_translucent);
+        }
+    }
+
+    private static boolean isBlank(@Nullable final String value) {
+        return value == null || value.trim().isEmpty();
+    }
+}
