Date: Wed, 21 Oct 2026 10:11:11 +0800
Subject: [PATCH] Include the bisub subtitle cache in data backups

The backup zip carried the database and every SharedPreferences
entry, which already covers all bisub settings and provider
profiles: the export serializes the full preference map with the
original types (ObjectOutputStream), so Float/Int/Boolean style
values and the profile JSON round-trip losslessly.

The translated subtitle cache files, however, cost API quota to
produce and stayed behind on migration, forcing a full retranslation
on a new device. Add the top-level files of files/bisub to the
backup zip as "bisub/<name>" entries and extract them back on
import, unconditionally like the database. Nested entries such as
the debug logs are skipped on both sides, which also defuses path
traversal inside the archive; backups without cache entries import
unchanged.
---
 .../settings/BackupSettingsFragment.java      |  5 ++
 .../settings/ContentSettingsManager.kt        | 67 +++++++++++++++++++
 .../newpipe/settings/NewPipeFileLocator.kt    |  2 +
 3 files changed, 74 insertions(+)

diff --git a/app/src/main/java/org/schabi/newpipe/settings/BackupSettingsFragment.java b/app/src/main/java/org/schabi/newpipe/settings/BackupSettingsFragment.java
index 66bb0c3ec..ae48c25e6 100644
--- a/app/src/main/java/org/schabi/newpipe/settings/BackupSettingsFragment.java
+++ b/app/src/main/java/org/schabi/newpipe/settings/BackupSettingsFragment.java
@@ -228,6 +228,11 @@ public class BackupSettingsFragment extends BasePreferenceFragment {
                 return;
             }
 
+            // The bisub subtitle cache is data like the database, so it is
+            // restored unconditionally; backups without any cache entry
+            // (made before this feature) simply import nothing here.
+            manager.extractBisubCache(file);
+
             // if settings file exist, ask if it should be imported.
             if (manager.extractSettings(file)) {
                 final AlertDialog.Builder alert = new AlertDialog.Builder(requireContext());
diff --git a/app/src/main/java/org/schabi/newpipe/settings/ContentSettingsManager.kt b/app/src/main/java/org/schabi/newpipe/settings/ContentSettingsManager.kt
index 3ac275695..ccd095d68 100644
--- a/app/src/main/java/org/schabi/newpipe/settings/ContentSettingsManager.kt
+++ b/app/src/main/java/org/schabi/newpipe/settings/ContentSettingsManager.kt
@@ -2,20 +2,30 @@ package org.schabi.newpipe.settings
 
 import android.content.SharedPreferences
 import android.util.Log
+import org.schabi.newpipe.streams.io.SharpInputStream
 import org.schabi.newpipe.streams.io.SharpOutputStream
 import org.schabi.newpipe.streams.io.StoredFileHelper
 import org.schabi.newpipe.util.ZipHelper
+import java.io.BufferedInputStream
 import java.io.BufferedOutputStream
+import java.io.File
 import java.io.FileInputStream
 import java.io.FileOutputStream
 import java.io.IOException
 import java.io.ObjectInputStream
 import java.io.ObjectOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
 import java.util.zip.ZipOutputStream
 
 class ContentSettingsManager(private val fileLocator: NewPipeFileLocator) {
     companion object {
         const val TAG = "ContentSetManager"
+
+        /** Zip prefix of the bisub subtitle cache files inside a backup. */
+        const val BISUB_CACHE_PREFIX = "bisub/"
+
+        private const val BUFFER_SIZE = 2048
     }
 
     /**
@@ -39,7 +49,25 @@ class ContentSettingsManager(private val fileLocator: NewPipeFileLocator) {
                 }
 
                 ZipHelper.addFileToZip(outZip, fileLocator.settings.path, "newpipe.settings")
+
+                addBisubCacheToZip(outZip)
+            }
+    }
+
+    /**
+     * Adds every top-level file of the bisub subtitle cache directory to the
+     * backup zip as "bisub/<file name>". Translated subtitles cost API quota
+     * to produce, so they belong in a full data migration; the debug log
+     * subdirectory stays out. A missing or empty cache directory adds
+     * nothing, so backups made before any translation stay valid.
+     */
+    private fun addBisubCacheToZip(outZip: ZipOutputStream) {
+        val files = fileLocator.bisubDir.listFiles() ?: return
+        for (cacheFile in files) {
+            if (cacheFile.isFile) {
+                ZipHelper.addFileToZip(outZip, cacheFile.path, BISUB_CACHE_PREFIX + cacheFile.name)
             }
+        }
     }
 
     fun deleteSettingsFile() {
@@ -70,6 +98,45 @@ class ContentSettingsManager(private val fileLocator: NewPipeFileLocator) {
         return ZipHelper.extractFileFromZip(file, fileLocator.settings.path, "newpipe.settings")
     }
 
+    /**
+     * Extracts the bisub subtitle cache files ("bisub/<file name>" entries)
+     * of a backup zip into the bisub cache directory. Only top-level entries
+     * are accepted, which keeps the debug log subdirectory out and defuses
+     * path traversal inside the archive. A cache directory is created on
+     * demand. Returns whether the archive contained any cache entry, so
+     * backups made before this feature existed import without a hitch.
+     */
+    fun extractBisubCache(file: StoredFileHelper): Boolean {
+        val dir = fileLocator.bisubDir
+        if (!dir.exists() && !dir.mkdir()) {
+            return false
+        }
+        var found = false
+        ZipInputStream(BufferedInputStream(SharpInputStream(file.stream))).use { inZip ->
+            val data = ByteArray(BUFFER_SIZE)
+            while (true) {
+                val entry: ZipEntry = inZip.nextEntry ?: break
+                if (!entry.name.startsWith(BISUB_CACHE_PREFIX)) {
+                    continue
+                }
+                val relative = entry.name.removePrefix(BISUB_CACHE_PREFIX)
+                if (relative.isEmpty() || relative.contains('/') || relative.contains('\\')) {
+                    continue
+                }
+                found = true
+                val output = File(dir, relative)
+                FileOutputStream(output).use { outFile ->
+                    var count = inZip.read(data)
+                    while (count != -1) {
+                        outFile.write(data, 0, count)
+                        count = inZip.read(data)
+                    }
+                }
+            }
+        }
+        return found
+    }
+
     fun loadSharedPreferences(preferences: SharedPreferences) {
         try {
             val preferenceEditor = preferences.edit()
diff --git a/app/src/main/java/org/schabi/newpipe/settings/NewPipeFileLocator.kt b/app/src/main/java/org/schabi/newpipe/settings/NewPipeFileLocator.kt
index c2f93d15f..2dde96933 100644
--- a/app/src/main/java/org/schabi/newpipe/settings/NewPipeFileLocator.kt
+++ b/app/src/main/java/org/schabi/newpipe/settings/NewPipeFileLocator.kt
@@ -18,4 +18,6 @@ class NewPipeFileLocator(private val homeDir: File) {
     val dbWal by lazy { File(homeDir, "/databases/newpipe.db-wal") }
 
     val settings by lazy { File(homeDir, "/databases/newpipe.settings") }
+
+    val bisubDir by lazy { File(homeDir, "/files/bisub") }
 }
