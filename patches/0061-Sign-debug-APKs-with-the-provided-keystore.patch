From 2c2324eaa1e95da01f9b1fac0744f4155632095a Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Wed, 4 Nov 2026 14:38:15 +0800
Subject: [PATCH] 0061: Sign debug APKs with the provided keystore

AGP generates the debug signing key in its per-machine prefs folder
(~/.android on older AGP, ~/.config/.android on AGP 9) and creates a random
key when no keystore is there. On GitHub's ephemeral runners that means every
CI build got a different signature, so an in-app update could never install
over the installed app: Android rejects it with INSTALL_FAILED_UPDATE_INCOMPATIBLE
and the user has to uninstall (losing all data) first.

The build already reads KEY_PATH/KEY_STORE_PASSWORD/KEY_ALIAS/KEY_PASSWORD for
release signing. Configure the debug signing config with the same values, so
CI and local builds (with those env vars set) are all signed by the committed
debug.keystore.
---
 app/build.gradle | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/app/build.gradle b/app/build.gradle
index 4798879..999f2b8 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -53,6 +53,19 @@ android {
                 keyAlias signingKeyAlias
                 keyPassword signingKeyPassword
             }
+            // BISUB: use the provided keystore for debug builds too. AGP's default
+            // debug keystore lives in the per-machine prefs folder (AGP 9 uses
+            // ~/.config/.android, older versions ~/.android) and is randomly
+            // generated when missing, so CI builds got a different signature on
+            // every run and in-app updates could never install over the previous
+            // APK. With KEY_PATH pointing at the committed debug.keystore every
+            // build (CI and local) shares one stable key.
+            debug {
+                storeFile file(keyPath)
+                storePassword keyStorePassword
+                keyAlias signingKeyAlias
+                keyPassword signingKeyPassword
+            }
         }
     }
 
