-                        && "response".equals(parser.getName())) {
+                        && "response".equals(localName(parser.getName()))) {
                     if (href != null && size >= 0) {
                         final String name = fileNameOf(href);
                         if (name.endsWith(".zip")) {
@@ -199,6 +200,25 @@ final class WebDavBackend implements RemoteBackend {
         }
     }
 
+    /**
+     * Strips the namespace prefix of a raw element name. WebDAV servers
+     * prefix the multistatus elements with whatever they like ("d:",
+     * "D:", ...), and with namespace processing disabled XmlPullParser
+     * reports those qualified names verbatim, so the prefix must be
+     * removed before comparing against the plain local names.
+     *
+     * @param raw the raw element name from {@link XmlPullParser#getName()}
+     * @return the local name without namespace prefix
+     */
+    @NonNull
+    private static String localName(@Nullable final String raw) {
+        if (raw == null) {
+            return "";
+        }
+        final int colon = raw.indexOf(':');
+        return colon >= 0 ? raw.substring(colon + 1) : raw;
+    }
