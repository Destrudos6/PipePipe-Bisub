                 if (event == XmlPullParser.START_TAG) {
-                    final String tag = parser.getName();
+                    final String tag = localName(parser.getName());
                     if ("Contents".equals(tag)) {
                         key = null;
                         size = 0L;
@@ -279,7 +280,8 @@ final class S3Backend implements RemoteBackend {
                     } else if ("LastModified".equals(tag)) {
                         modified = parseIsoTime(parser.nextText().trim());
                     }
-                } else if (event == XmlPullParser.END_TAG && "Contents".equals(parser.getName())
+                } else if (event == XmlPullParser.END_TAG
+                        && "Contents".equals(localName(parser.getName()))
                         && key != null && key.length() > prefix.length()) {
                     final String name = key.substring(prefix.length());
                     if (name.endsWith(".zip") && !name.contains("/")) {
@@ -294,6 +296,23 @@ final class S3Backend implements RemoteBackend {
         }
     }
 
+    /**
+     * Strips a namespace prefix from a raw element name before comparing
+     * it against the plain local names, so S3-compatible services that
+     * namespace their ListObjectsV2 responses parse as well.
+     *
+     * @param raw the raw element name from {@link XmlPullParser#getName()}
+     * @return the local name without namespace prefix
+     */
+    @NonNull
+    private static String localName(@Nullable final String raw) {
+        if (raw == null) {
+            return "";
+        }
+        final int colon = raw.indexOf(':');
+        return colon >= 0 ? raw.substring(colon + 1) : raw;
+    }
+
