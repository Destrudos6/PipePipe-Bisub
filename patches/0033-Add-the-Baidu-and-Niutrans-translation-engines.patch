+    /**
+     * Translates the lines with the Baidu general translation API. The
+     * credentials are stored as {@code appid#secret} in the API key
+     * field, and every request is signed with
+     * {@code MD5(appid + q + salt + secret)}. Multiple lines are joined
+     * with newlines into one request (the reply carries one
+     * {@code trans_result} entry per line, which keeps the alignment
+     * exact). The standard (free) tier is limited to one request per
+     * second, so chunks wait 1050&nbsp;ms in between and the default
+     * concurrency of this engine is one; a rate-limit reply (54003) is
+     * retried with a pause instead of failing the translation.
+     *
+     * @param lines the sanitized subtitle lines
+     * @param cfg   the user configuration
+     * @return translations keyed by the position in {@code lines}
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static Map<Integer, String> translateBaidu(@NonNull final List<String> lines,
+                                                       @NonNull final Config cfg)
+            throws IOException, JSONException {
+        final String target = engineTargetCode(cfg.provider, cfg.targetLanguage);
+        final String[] credentials = splitBaiduCredentials(cfg.apiKey);
+        final String appId = credentials[0];
+        final String secret = credentials[1];
+        final Map<Integer, String> result = new HashMap<>();
+        // The q parameter is limited to 6000 UTF-8 bytes; stay below it.
+        final List<int[]> bounds = chunkBoundsBytes(lines, 40, 5800);
+        for (int c = 0; c < bounds.size(); c++) {
+            if (c > 0) {
+                sleepQuietly(1050);
+            }
+            final int[] bound = bounds.get(c);
+            final List<String> chunk = lines.subList(bound[0], bound[1]);
+            BisubLog.i("baidu chunk " + (c + 1) + "/" + bounds.size() + ": "
+                    + chunk.size() + " lines, " + totalLength(chunk) + " chars");
+            final List<String> parsed = baiduTranslateChunk(chunk, target, appId, secret);
+            if (parsed.size() == chunk.size()) {
+                for (int i = 0; i < chunk.size(); i++) {
+                    putIfMeaningful(result, bound[0] + i, parsed.get(i));
+                }
+                continue;
+            }
+            Log.w(TAG, "Baidu reply had " + parsed.size() + " lines for "
+                    + chunk.size() + " inputs, retrying the chunk line by line");
+            BisubLog.w("baidu chunk " + (c + 1) + "/" + bounds.size()
+                    + ": reply had " + parsed.size() + " lines for " + chunk.size()
+                    + " inputs, retrying line by line");
+            for (int i = 0; i < chunk.size(); i++) {
+                if (i > 0) {
+                    sleepQuietly(1050);
+                }
+                final List<String> single = baiduTranslateChunk(
+                        Collections.singletonList(chunk.get(i)),
+                        target, appId, secret);
+                if (!single.isEmpty()) {
+                    putIfMeaningful(result, bound[0] + i, single.get(0));
+                }
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Sends one signed request to the Baidu API and returns the
+     * translated {@code dst} values, one per input line. A rate-limit
+     * reply (error 54003, "access frequency too high") is retried once
+     * after a pause; configuration errors (bad signature, closed
+     * service, exhausted quota) fail fast.
+     *
+     * @param chunk  the lines of this request
+     * @param target the engine target language code
+     * @param appId  the Baidu application id
+     * @param secret the Baidu secret key
+     * @return the translations, possibly fewer than requested
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static List<String> baiduTranslateChunk(@NonNull final List<String> chunk,
+                                                    @NonNull final String target,
+                                                    @NonNull final String appId,
+                                                    @NonNull final String secret)
+            throws IOException, JSONException {
+        final String joined = String.join("\n", chunk);
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            final String salt = String.valueOf(System.currentTimeMillis());
+            final RequestBody form = new FormBody.Builder()
+                    .add("q", joined)
+                    .add("from", "auto")
+                    .add("to", target)
+                    .add("appid", appId)
+                    .add("salt", salt)
+                    .add("sign", md5Hex(appId + joined + salt + secret))
+                    .build();
+            final Request request = new Request.Builder()
+                    .url("https://fanyi-api.baidu.com/api/trans/vip/translate")
+                    .post(form)
+                    .build();
+            final JSONObject reply = new JSONObject(executeRequest(request));
+            final String errorCode = reply.optString("error_code", "");
+            if (errorCode.isEmpty()) {
+                final JSONArray items = reply.optJSONArray("trans_result");
+                final List<String> parsed = new ArrayList<>();
+                if (items != null) {
+                    for (int i = 0; i < items.length(); i++) {
+                        parsed.add(items.getJSONObject(i).optString("dst", ""));
+                    }
+                }
+                return parsed;
+            }
+            final String message = reply.optString("error_msg", errorCode);
+            if ("54003".equals(errorCode) || "52001".equals(errorCode)
+                    || "52002".equals(errorCode)) {
+                // Rate limit / busy: pause and let the next attempt run.
+                BisubLog.w("baidu error " + errorCode + " (" + message
+                        + ") on attempt " + attempt + ", pausing");
+                if (attempt < 3) {
+                    sleepQuietly(1100 * attempt);
+                    continue;
+                }
+                throw new IOException("Baidu API is busy (error " + errorCode + ")");
+            }
+            BisubLog.e("baidu error " + errorCode + ": " + message);
+            throw new TranslationConfigException("Baidu API error " + errorCode
+                    + ": " + message);
+        }
+        throw new IOException("Baidu API request failed");
+    }
+
+    /**
+     * Splits the API key field into the Baidu credentials. The field
+     * holds {@code appid#secret}; the separator may not appear in either
+     * part.
+     *
+     * @param apiKey the raw API key field value
+     * @return {@code [appid, secret]}
+     * @throws TranslationConfigException when the format is wrong
+     */
+    @NonNull
+    private static String[] splitBaiduCredentials(@Nullable final String apiKey)
+            throws TranslationConfigException {
+        final String value = apiKey == null ? "" : apiKey.trim();
+        final int separator = value.indexOf('#');
+        if (separator <= 0 || separator >= value.length() - 1) {
+            throw new TranslationConfigException("The Baidu API key field must hold "
+                    + "\"appid#secret\", as shown in the Baidu console");
+        }
+        return new String[]{value.substring(0, separator).trim(),
+                value.substring(separator + 1).trim()};
+    }
+
+    /**
+     * @param value the string to hash
+     * @return the lowercase hexadecimal MD5 digest, as the Baidu
+     *         signature requires
+     */
+    @NonNull
+    private static String md5Hex(@NonNull final String value) {
+        try {
+            final byte[] digest = java.security.MessageDigest.getInstance("MD5")
+                    .digest(value.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            final StringBuilder builder = new StringBuilder(digest.length * 2);
+            for (final byte b : digest) {
+                builder.append(Character.forDigit((b >> 4) & 0xF, 16));
+                builder.append(Character.forDigit(b & 0xF, 16));
+            }
+            return builder.toString();
+        } catch (final java.security.NoSuchAlgorithmException e) {
+            // MD5 is guaranteed to exist on Android
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /**
+     * Translates the lines with the Niutrans text translation API. One
+     * request carries the newline-joined lines and the reply preserves
+     * the line structure, so the alignment stays exact; a reply with a
+     * different line count falls back to line-by-line requests. The
+     * free tier is rate limited to roughly two requests per second, so
+     * the default concurrency of this engine is two and chunks pause
+     * briefly in between.
+     *
+     * @param lines the sanitized subtitle lines
+     * @param cfg   the user configuration
+     * @return translations keyed by the position in {@code lines}
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static Map<Integer, String> translateNiutrans(@NonNull final List<String> lines,
+                                                          @NonNull final Config cfg)
+            throws IOException, JSONException {
+        final String target = engineTargetCode(cfg.provider, cfg.targetLanguage);
+        final String apiKey = cfg.apiKey == null ? "" : cfg.apiKey.trim();
+        final Map<Integer, String> result = new HashMap<>();
+        // Stay well below the per-request text length limit.
+        final List<int[]> bounds = chunkBounds(lines, 40, 2800, false);
+        for (int c = 0; c < bounds.size(); c++) {
+            if (c > 0) {
+                sleepQuietly(100);
+            }
+            final int[] bound = bounds.get(c);
+            final List<String> chunk = lines.subList(bound[0], bound[1]);
+            BisubLog.i("niutrans chunk " + (c + 1) + "/" + bounds.size() + ": "
+                    + chunk.size() + " lines, " + totalLength(chunk) + " chars");
+            final List<String> parsed = niutransTranslateChunk(chunk, target, apiKey);
+            if (parsed.size() == chunk.size()) {
+                for (int i = 0; i < chunk.size(); i++) {
+                    putIfMeaningful(result, bound[0] + i, parsed.get(i));
+                }
+                continue;
+            }
+            Log.w(TAG, "Niutrans reply had " + parsed.size() + " lines for "
+                    + chunk.size() + " inputs, retrying the chunk line by line");
+            BisubLog.w("niutrans chunk " + (c + 1) + "/" + bounds.size()
+                    + ": reply had " + parsed.size() + " lines for " + chunk.size()
+                    + " inputs, retrying line by line");
+            for (int i = 0; i < chunk.size(); i++) {
+                sleepQuietly(100);
+                final List<String> single = niutransTranslateChunk(
+                        Collections.singletonList(chunk.get(i)),
+                        target, apiKey);
+                if (!single.isEmpty()) {
+                    putIfMeaningful(result, bound[0] + i, single.get(0));
+                }
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Sends one request to the Niutrans translation endpoint and splits
+     * the {@code tgt_text} reply back into lines.
+     *
+     * @param chunk   the lines of this request
+     * @param target  the engine target language code
+     * @param apiKey  the Niutrans API key
+     * @return the translations, possibly fewer than requested
+     * @throws IOException   on network errors, HTTP errors or timeouts
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static List<String> niutransTranslateChunk(@NonNull final List<String> chunk,
+                                                       @NonNull final String target,
+                                                       @NonNull final String apiKey)
+            throws IOException, JSONException {
+        final JSONObject payload = new JSONObject();
+        payload.put("from", "auto");
+        payload.put("to", target);
+        payload.put("apikey", apiKey);
+        payload.put("src_text", String.join("\n", chunk));
+        final Request request = new Request.Builder()
+                .url("https://api.niutrans.com/NiuTransServer/translationX")
+                .post(RequestBody.create(payload.toString(), JSON))
+                .build();
+        final JSONObject reply = new JSONObject(executeRequest(request));
+        final String error = reply.optString("error_msg",
+                reply.optString("error", ""));
+        if (!error.trim().isEmpty() && reply.optString("tgt_text", "").isEmpty()) {
+            final String lower = error.toLowerCase(Locale.ROOT);
+            if (lower.contains("rate") || lower.contains("limit")
+                    || lower.contains("frequency") || lower.contains("频率")
+                    || lower.contains("频繁")) {
+                // Rate limit: drop the chunk, the caller's retry logic
+                // re-sends it later.
+                BisubLog.w("niutrans rate limit: " + error.trim());
+                throw new IOException("Niutrans rate limit: " + error.trim());
+            }
+            BisubLog.e("niutrans error: " + error.trim());
+            throw new TranslationConfigException("Niutrans API error: " + error.trim());
+        }
+        final List<String> parsed = new ArrayList<>();
+        final String translated = reply.optString("tgt_text", "");
+        if (!translated.isEmpty()) {
+            for (final String part : translated.split("\n", -1)) {
+                parsed.add(part);
+            }
+        }
+        return parsed;
+    }
+
     /**
      * Adds a translation to the result unless it is blank, so that blank
      * replies stay absent and are re-sent by the caller's retry logic.
@@ -786,6 +1077,45 @@ public final class SubtitleTranslator {
         return weight;
     }
 
+    /**
+     * Splits the lines into chunks whose UTF-8 encoded size stays below
+     * a byte limit, for engines that cap the request body in bytes (the
+     * Baidu {@code q} parameter accepts at most 6000 bytes). Characters
+     * beyond ASCII are conservatively counted as three bytes, which is
+     * the exact size of most non-Latin scripts and a safe upper bound
+     * for the rest.
+     *
+     * @param lines    the sanitized subtitle lines
+     * @param maxLines maximum number of lines per request
+     * @param maxBytes maximum UTF-8 bytes per request
+     * @return [start, end) bounds into {@code lines}, in order
+     */
+    @NonNull
+    private static List<int[]> chunkBoundsBytes(@NonNull final List<String> lines,
+                                                final int maxLines, final int maxBytes) {
+        final List<int[]> bounds = new ArrayList<>();
+        int start = 0;
+        while (start < lines.size()) {
+            int end = start;
+            int bytes = 0;
+            while (end < lines.size()) {
+                final String line = lines.get(end);
+                int lineBytes = 0;
+                for (int i = 0; i < line.length(); i++) {
+                    lineBytes += line.charAt(i) > 127 ? 3 : 1;
+                }
+                if (end > start && (end - start >= maxLines || bytes + lineBytes > maxBytes)) {
+                    break;
+                }
+                bytes += lineBytes;
+                end++;
+            }
+            bounds.add(new int[]{start, end});
+            start = end;
+        }
+        return bounds;
+    }
+
