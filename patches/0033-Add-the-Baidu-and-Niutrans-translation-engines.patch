+        }
+        if ("niutrans".equals(engine)) {
+            if ("zh-CN".equals(normalized)) {
+                return "zh";
+            }
+            if ("zh-TW".equals(normalized)) {
+                return "cht";
+            }
+            return normalized;
+        }
