From 88c7dc3190d24dff241343f4c2f32e887dbd1155 Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Thu, 22 Oct 2026 17:28:54 +0800
Subject: [PATCH 43/51] Fix the word popup senses never showing: drop the
 nested ScrollView

The debug log proved every layer healthy - HTTP 200, full senses
parsed, 12 rows added with a visible color - yet nothing appeared
below the divider. The pattern in the two provider reports now makes
sense: with Microsoft everything except the headline is inside the
ScrollView (all blank); with Youdao the phonetic and exam labels sit
outside it (exactly those stayed visible). The ScrollView content
itself never showed.

Two structural flaws compounded there, both since the first version
of the popup:

1. The alert dialog already wraps its custom view in a ScrollView;
  nesting our own ScrollView inside it is a known broken measurement
  setup. The nested one is gone - the dialog's own panel scrolls.

2. The dynamic rows used match_parent width. A dialog window is
  wrap_content, and a match_parent child inside an UNSPECIFIED
  measuring chain measures as zero width: the text is there, colored
  correctly, occupying vertical space - and invisible. The rows (and
  the content container and the fixed views) now size by content,
  which can never collapse to zero, and the root layout carries a
  minimum width so the light variant also keeps a stable size.

The popup logs the measured size of the first row one layout pass
after the fill, so any remaining invisibility would now show up as
a zero in the debug log instead of a mystery.
---
 .../bisub/wordlookup/WordDialogHelper.java    | 20 +++++++++++---
 app/src/main/res/layout/dialog_bisub_word.xml | 26 +++++++++----------
 2 files changed, 28 insertions(+), 18 deletions(-)

diff --git a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
index 8f26239c2..6f05b42bd 100644
--- a/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
+++ b/app/src/main/java/org/schabi/newpipe/bisub/wordlookup/WordDialogHelper.java
@@ -296,6 +296,16 @@ public final class WordDialogHelper {
                 + "content children=" + content.getChildCount() + ", color=0x"
                 + Integer.toHexString(primaryColor) + ", phonetic="
                 + entry.phonetic);
+        // Reconnaissance: report the measured size of the first row one
+        // layout pass later, so a still-invisible popup (zero width)
+        // becomes visible in the debug log.
+        content.post(() -> {
+            if (content.getChildCount() > 0) {
+                final View first = content.getChildAt(0);
+                BisubLog.i("word popup '" + word + "': first row measured "
+                        + first.getWidth() + "x" + first.getHeight());
+            }
+        });
     }
 
     /**
@@ -324,11 +334,13 @@ public final class WordDialogHelper {
                                 final boolean secondary, final int primaryColor,
                                 final int secondaryColor) {
         final TextView textView = new TextView(context);
-        // Explicit LinearLayout params: the rows live inside a vertical
-        // LinearLayout (inside the popup's ScrollView), and passing raw
-        // ViewGroup.LayoutParams relies on the conversion addView does.
+        // wrap_content width on purpose: the rows live inside a dialog
+        // whose window is wrap_content, and a match_parent child in an
+        // UNSPECIFIED measuring chain measures as zero width - invisible
+        // text on a perfectly working popup. wrap_content always sizes
+        // to the text, whatever the parent measures with.
         textView.setLayoutParams(new android.widget.LinearLayout.LayoutParams(
-                android.widget.LinearLayout.LayoutParams.MATCH_PARENT,
+                android.widget.LinearLayout.LayoutParams.WRAP_CONTENT,
                 android.widget.LinearLayout.LayoutParams.WRAP_CONTENT));
         final float density = context.getResources().getDisplayMetrics().density;
         final int pad = (int) (secondary ? 2 * density : 4 * density);
diff --git a/app/src/main/res/layout/dialog_bisub_word.xml b/app/src/main/res/layout/dialog_bisub_word.xml
index a8410ea4f..d5632aae3 100644
--- a/app/src/main/res/layout/dialog_bisub_word.xml
+++ b/app/src/main/res/layout/dialog_bisub_word.xml
@@ -2,22 +2,27 @@
 <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
+    android:minWidth="260dp"
     android:orientation="vertical"
     android:paddingStart="16dp"
     android:paddingEnd="16dp"
     android:paddingTop="12dp"
     android:paddingBottom="2dp">
 
+    <!-- No nested ScrollView here on purpose: the alert dialog wraps its
+         custom view in a ScrollView already, and a second one inside it
+         measurably broke on devices (the senses never became visible).
+         The dialog's own panel scrolls everything below when long. -->
     <TextView
         android:id="@+id/bisub_word"
-        android:layout_width="match_parent"
+        android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textColor="?android:attr/textColorPrimary"
         android:textSize="18sp"
         android:textStyle="bold" />
 
     <LinearLayout
-        android:layout_width="match_parent"
+        android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="2dp"
         android:gravity="center_vertical"
@@ -52,19 +57,12 @@
         android:alpha="0.15"
         android:background="?android:attr/textColorPrimary" />
 
-    <ScrollView
-        android:id="@+id/bisub_word_scroll"
-        android:layout_width="match_parent"
+    <LinearLayout
+        android:id="@+id/bisub_word_content"
+        android:layout_width="wrap_content"
         android:layout_height="wrap_content"
-        android:scrollbars="none">
-
-        <LinearLayout
-            android:id="@+id/bisub_word_content"
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:orientation="vertical"
-            android:paddingBottom="4dp" />
-    </ScrollView>
+        android:orientation="vertical"
+        android:paddingBottom="4dp" />
 
     <Button
         android:id="@+id/bisub_word_book_button"
-- 
