diff --git a/app/src/main/java/org/schabi/newpipe/settings/BisubSubtitleReaderFragment.java b/app/src/main/java/org/schabi/newpipe/settings/BisubSubtitleReaderFragment.java
new file mode 100644
index 000000000..c4cea4338
--- /dev/null
+++ b/app/src/main/java/org/schabi/newpipe/settings/BisubSubtitleReaderFragment.java
@@ -0,0 +1,229 @@
+package org.schabi.newpipe.settings;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.RadioGroup;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.schabi.newpipe.R;
+import org.schabi.newpipe.bisub.VttParser;
+import org.schabi.newpipe.util.ThemeHelper;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Third-level reader page that shows one cached bilingual subtitle as a
+ * bilingual transcript.
+ *
+ * <p>The cached VTT stores each cue as two lines (original text, then
+ * translation); this page splits them back into parallel lines so the
+ * subtitle doubles as a learning resource after watching the video. A
+ * mode switcher at the top toggles between the bilingual view, the
+ * original only and the translation only, so the transcript can be read
+ * as a comprehension exercise: cover the translation first, then reveal
+ * it line by line.</p>
+ */
+public final class BisubSubtitleReaderFragment extends Fragment {
+
+    /** Shows both lines of every cue. */
+    public static final int MODE_BILINGUAL = 0;
+    /** Shows only the original-language line of every cue. */
+    public static final int MODE_ORIGINAL = 1;
+    /** Shows only the translated line of every cue. */
+    public static final int MODE_TRANSLATION = 2;
+
+    private static final String ARG_FILE_PATH = "filePath";
+    private static final String ARG_TITLE = "title";
+
+    private RecyclerView recyclerView;
+    private TextView emptyView;
+    private final BisubReaderAdapter adapter = new BisubReaderAdapter();
+    private int displayMode = MODE_BILINGUAL;
+
+    /**
+     * Builds the arguments of a reader page for one cache entry.
+     *
+     * @param filePath the absolute path of the cached VTT file
+     * @param title    the video title shown as the page title
+     * @return a ready-to-use arguments bundle
+     */
+    @NonNull
+    public static Bundle buildArguments(@NonNull final String filePath,
+                                        @Nullable final String title) {
+        final Bundle args = new Bundle();
+        args.putString(ARG_FILE_PATH, filePath);
+        args.putString(ARG_TITLE, title);
+        return args;
+    }
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull final LayoutInflater inflater,
+                             @Nullable final ViewGroup container,
+                             @Nullable final Bundle savedInstanceState) {
+        final View root =
+                inflater.inflate(R.layout.fragment_bisub_reader, container, false);
+        recyclerView = root.findViewById(R.id.bisub_reader_list);
+        emptyView = root.findViewById(R.id.bisub_reader_empty);
+        recyclerView.setLayoutManager(new LinearLayoutManager(requireContext()));
+        recyclerView.setAdapter(adapter);
+
+        final RadioGroup modeGroup = root.findViewById(R.id.bisub_reader_mode_group);
+        modeGroup.setOnCheckedChangeListener((final RadioGroup group, final int id) -> {
+            if (id == R.id.bisub_reader_mode_original) {
+                displayMode = MODE_ORIGINAL;
+            } else if (id == R.id.bisub_reader_mode_translation) {
+                displayMode = MODE_TRANSLATION;
+            } else {
+                displayMode = MODE_BILINGUAL;
+            }
+            adapter.notifyDataSetChanged();
+        });
+        return root;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final Bundle args = getArguments();
+        final String title = args == null ? null : args.getString(ARG_TITLE);
+        ThemeHelper.setTitleToAppCompatActivity(getActivity(),
+                title == null ? getString(R.string.bisub_reader_title) : title);
+        if (adapter.getItemCount() == 0) {
+            load();
+        }
+    }
+
+    /**
+     * Reads the cached file and parses it into parallel lines on a
+     * background thread, then swaps them into the list on the UI thread.
+     */
+    private void load() {
+        final Bundle args = getArguments();
+        final String filePath = args == null ? null : args.getString(ARG_FILE_PATH);
+        if (filePath == null) {
+            showEmpty();
+            return;
+        }
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        new Thread(() -> {
+            final List<String[]> lines = new ArrayList<>();
+            try {
+                final byte[] bytes = Files.readAllBytes(new File(filePath).toPath());
+                final String content = new String(bytes, StandardCharsets.UTF_8);
+                for (final VttParser.Cue cue : VttParser.parse(content)) {
+                    if (cue.lines.isEmpty()) {
+                        continue;
+                    }
+                    final String original = cue.lines.get(0);
+                    final String translation = cue.lines.size() > 1
+                            ? cue.lines.get(1) : null;
+                    if ((original == null || original.isEmpty())
+                            && (translation == null || translation.isEmpty())) {
+                        continue;
+                    }
+                    lines.add(new String[]{
+                            original == null ? "" : original,
+                            translation == null ? "" : translation});
+                }
+            } catch (final IOException e) {
+                lines.clear();
+            }
+            if (getActivity() == null) {
+                return;
+            }
+            final List<String[]> loaded = new ArrayList<>(lines);
+            getActivity().runOnUiThread(() -> {
+                if (getActivity() == null) {
+                    return;
+                }
+                adapter.setLines(loaded);
+                if (loaded.isEmpty()) {
+                    showEmpty();
+                }
+            });
+        }).start();
+    }
+
+    private void showEmpty() {
+        emptyView.setVisibility(View.VISIBLE);
+        recyclerView.setVisibility(View.GONE);
+    }
+
+    private final class BisubReaderAdapter
+            extends RecyclerView.Adapter<BisubReaderHolder> {
+        private final List<String[]> lines = new ArrayList<>();
+
+        void setLines(@NonNull final List<String[]> newLines) {
+            lines.clear();
+            lines.addAll(newLines);
+            notifyDataSetChanged();
+        }
+
+        @NonNull
+        @Override
+        public BisubReaderHolder onCreateViewHolder(@NonNull final ViewGroup parent,
+                                                    final int viewType) {
+            return new BisubReaderHolder(LayoutInflater.from(parent.getContext())
+                    .inflate(R.layout.item_bisub_reader, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull final BisubReaderHolder holder,
+                                     final int position) {
+            holder.bind(lines.get(position));
+        }
+
+        @Override
+        public int getItemCount() {
+            return lines.size();
+        }
+    }
+
+    private final class BisubReaderHolder extends RecyclerView.ViewHolder {
+        private final TextView originalView;
+        private final TextView translationView;
+
+        BisubReaderHolder(@NonNull final View itemView) {
+            super(itemView);
+            originalView = itemView.findViewById(R.id.bisub_reader_original);
+            translationView = itemView.findViewById(R.id.bisub_reader_translation);
+        }
+
+        /**
+         * Fills one cue row and applies the display mode: bilingual shows
+         * both lines, the single modes hide the other one.
+         *
+         * @param line the original and translation of one cue
+         */
+        void bind(@NonNull final String[] line) {
+            final boolean showOriginal =
+                    displayMode == MODE_BILINGUAL || displayMode == MODE_ORIGINAL;
+            final boolean showTranslation =
+                    displayMode == MODE_BILINGUAL || displayMode == MODE_TRANSLATION;
+            originalView.setVisibility(
+                    showOriginal && !line[0].isEmpty() ? View.VISIBLE : View.GONE);
+            originalView.setText(line[0]);
+            translationView.setVisibility(
+                    showTranslation && !line[1].isEmpty() ? View.VISIBLE : View.GONE);
+            translationView.setText(line[1]);
+        }
+    }
+}
