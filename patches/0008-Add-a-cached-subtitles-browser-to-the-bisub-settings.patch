+    /**
+     * One completed bilingual subtitle file in the cache, together with the
+     * metadata recorded when it was generated. Entries without a metadata
+     * sidecar (files written before the sidecar existed) fall back to the
+     * file name and a cue count scanned from the file itself.
+     */
+    public static final class CachedSubtitle {
+        /** The bilingual WebVTT file on disk. */
+        @NonNull public final File file;
+        /** Video title, or {@code null} when unknown. */
+        @Nullable public final String title;
+        /** Video id, or {@code null} when unknown. */
+        @Nullable public final String videoId;
+        /** Language tag of the translated source track, or {@code null}. */
+        @Nullable public final String sourceLanguage;
+        /** Target language of the translation, or {@code null}. */
+        @Nullable public final String targetLanguage;
+        /** Model that translated the file, or {@code null}. */
+        @Nullable public final String model;
+        /** Number of cues in the file. */
+        public final int cueCount;
+        /** When the file was last written, in epoch milliseconds. */
+        public final long timestamp;
+
+        @SuppressWarnings("checkstyle:ParameterNumber")
+        CachedSubtitle(@NonNull final File file, @Nullable final String title,
+                       @Nullable final String videoId, @Nullable final String sourceLanguage,
+                       @Nullable final String targetLanguage, @Nullable final String model,
+                       final int cueCount, final long timestamp) {
+            this.file = file;
+            this.title = title;
+            this.videoId = videoId;
+            this.sourceLanguage = sourceLanguage;
+            this.targetLanguage = targetLanguage;
+            this.model = model;
+            this.cueCount = cueCount;
+            this.timestamp = timestamp;
+        }
+    }
+
+    /**
+     * Lists the completed bilingual subtitle files in the cache, newest
+     * first. Files that are still being translated have no done marker yet
+     * and are skipped. Only reads disk; call from a background thread.
+     *
+     * @return the cache entries, possibly empty, never {@code null}
+     */
+    @NonNull
+    public List<CachedSubtitle> listCachedSubtitles() {
+        final File dir = new File(appContext.getFilesDir(), CACHE_DIR);
+        final File[] files = dir.listFiles();
+        final List<CachedSubtitle> entries = new ArrayList<>();
+        if (files == null) {
+            return entries;
+        }
+        for (final File file : files) {
+            if (file.getName().endsWith(".vtt") && sibling(file, ".done").exists()) {
+                entries.add(describeCachedSubtitle(file));
+            }
+        }
+        Collections.sort(entries, (final CachedSubtitle a, final CachedSubtitle b) ->
+                Long.compare(b.timestamp, a.timestamp));
+        return entries;
+    }
+
+    /**
+     * Reads the full text of a cached bilingual subtitle file. Only reads
+     * disk; call from a background thread.
+     *
+     * @param entry the cache entry to read
+     * @return the file content, or {@code null} when reading fails
+     */
+    @Nullable
+    public String readCachedSubtitle(@NonNull final CachedSubtitle entry) {
+        try {
+            return new String(Files.readAllBytes(entry.file.toPath()),
+                    StandardCharsets.UTF_8);
+        } catch (final IOException e) {
+            Log.w(TAG, "Could not read the cached subtitle " + entry.file.getName(), e);
+            return null;
+        }
+    }
+
+    /**
+     * Deletes a cached bilingual subtitle file together with its done
+     * marker and metadata sidecar, so the video is translated again the
+     * next time it is requested.
+     *
+     * @param entry the cache entry to delete
+     * @return whether the subtitle file is gone
+     */
+    public boolean deleteCachedSubtitle(@NonNull final CachedSubtitle entry) {
+        sibling(entry.file, ".done").delete();
+        sibling(entry.file, ".meta").delete();
+        return entry.file.delete() || !entry.file.exists();
+    }
+
+    /**
+     * Builds the description of one cache entry from its metadata sidecar,
+     * with fallbacks for entries that have none.
+     *
+     * @param vttFile a bilingual subtitle file with a done marker
+     * @return the entry description
+     */
+    @NonNull
+    private static CachedSubtitle describeCachedSubtitle(@NonNull final File vttFile) {
+        String title = null;
+        String videoId = null;
+        String sourceLanguage = null;
+        String targetLanguage = null;
+        String model = null;
+        int cueCount = 0;
+        final File metaFile = sibling(vttFile, ".meta");
+        if (metaFile.exists()) {
+            try {
+                final JSONObject meta = new JSONObject(new String(
+                        Files.readAllBytes(metaFile.toPath()), StandardCharsets.UTF_8));
+                title = optNonEmpty(meta, "title");
+                videoId = optNonEmpty(meta, "videoId");
+                sourceLanguage = optNonEmpty(meta, "sourceLanguage");
+                targetLanguage = optNonEmpty(meta, "targetLanguage");
+                model = optNonEmpty(meta, "model");
+                cueCount = meta.optInt("cues", 0);
+            } catch (final IOException | JSONException e) {
+                Log.w(TAG, "Could not read the metadata of " + vttFile.getName(), e);
+            }
+        }
+        if (cueCount <= 0) {
+            cueCount = countCueTimings(vttFile);
+        }
+        return new CachedSubtitle(vttFile, title, videoId, sourceLanguage,
+                targetLanguage, model, cueCount, vttFile.lastModified());
+    }
+
+    /**
+     * Writes the metadata sidecar of a just-finished translation: video
+     * title and id, languages, model, cue and line counts. The sidecar is
+     * purely informational (the cache list shows it), so a failure here
+     * must never fail the translation itself.
+     *
+     * @param target     the target that was produced
+     * @param translated number of unique lines that were translated
+     * @param cueCount   number of cues in the composed file
+     */
+    private static void writeMetaQuietly(@NonNull final CacheTarget target,
+                                         final int translated, final int cueCount) {
+        try {
+            final JSONObject meta = new JSONObject();
+            meta.put("title", target.videoTitle == null ? "" : target.videoTitle);
+            meta.put("videoId", target.videoId);
+            meta.put("sourceLanguage", target.source.getLanguageTag());
+            meta.put("targetLanguage", target.cfg.targetLanguage);
+            meta.put("model", target.cfg.model);
+            meta.put("autoGenerated", target.source.isAutoGenerated());
+            meta.put("cues", cueCount);
+            meta.put("translated", translated);
+            meta.put("time", System.currentTimeMillis());
+            atomicWriteCache(sibling(target.cacheFile, ".meta"), meta.toString());
+        } catch (final JSONException | IOException e) {
+            Log.w(TAG, "Could not write the subtitle metadata sidecar", e);
+        }
+    }
+
+    @Nullable
+    private static String optNonEmpty(@NonNull final JSONObject meta,
+                                      @NonNull final String name) {
+        final String value = meta.optString(name, null);
+        return value == null || value.trim().isEmpty() ? null : value;
+    }
+
+    /**
+     * Counts the cue timing lines of a WebVTT file without a full parse,
+     * as a fallback line count for entries without a metadata sidecar.
+     *
+     * @param vttFile the subtitle file to scan
+     * @return the number of cue timing separators, or {@code 0} on errors
+     */
+    private static int countCueTimings(@NonNull final File vttFile) {
+        try {
+            final String content = new String(Files.readAllBytes(vttFile.toPath()),
+                    StandardCharsets.UTF_8);
+            int count = 0;
+            int index = 0;
+            while ((index = content.indexOf("-->", index)) >= 0) {
+                count++;
+                index += 3;
+            }
+            return count;
+        } catch (final IOException e) {
+            Log.w(TAG, "Could not scan " + vttFile.getName(), e);
+            return 0;
+        }
+    }
+
+    /**
+     * @param vttFile a bilingual subtitle cache file
+     * @param suffix  the sibling extension, e.g. {@code ".done"}
+     * @return the file with the same base name and the given suffix
+     */
+    @NonNull
+    private static File sibling(@NonNull final File vttFile, @NonNull final String suffix) {
+        final String name = vttFile.getName();
+        final int dot = name.lastIndexOf('.');
+        final String base = dot < 0 ? name : name.substring(0, dot);
+        return new File(vttFile.getParentFile(), base + suffix);
+    }
+
