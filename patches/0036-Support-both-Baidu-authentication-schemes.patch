+            case "59004":
+            case "52001":
+            case "52002":
+                // Rate limit / busy: pause and let the next attempt run.
+                throw new BaiduBusyException("error " + errorCode + ": " + message, 1100L);
+            case "54005":
                 // Long-query flood: the API asks to wait 3 seconds.
-                BisubLog.w("baidu error 54005 (" + message + ") on attempt "
-                        + attempt + ", waiting 3 s");
-                if (attempt < 3) {
-                    sleepQuietly(3100L * attempt);
-                    continue;
+                throw new BaiduBusyException("error 54005: " + message, 3100L);
+            case "54001":
+                if (useBearer) {
+                    throw new BaiduAuthException("invalid token (54001)");
                 }
-                throw new IOException("Baidu API is busy (error 54005)");
-            }
-            BisubLog.e("baidu error " + errorCode + ": " + message);
-            throw new TranslationConfigException("Baidu API error " + errorCode
-                    + ": " + message);
+                BisubLog.e("baidu error 54001: " + message);
+                throw new TranslationConfigException("Baidu authentication failed "
+                        + "(54001): check the App ID and the key. The key field accepts "
+                        + "an API key from the console's 'API Key' page or the classic "
+                        + "secret from the developer information page");
+            default:
+                BisubLog.e("baidu error " + errorCode + ": " + message);
+                throw new TranslationConfigException("Baidu API error " + errorCode
+                        + ": " + message);
         }
-        throw new IOException("Baidu API request failed");
+    }
