+    /** Baidu rejected the authentication of one request. For the Bearer
+     *  scheme this means the key field holds the classic secret, so the
+     *  caller falls back to the sign scheme. */
+    private static final class BaiduAuthException extends IOException {
+        private static final long serialVersionUID = 1L;
+
+        BaiduAuthException(@NonNull final String message) {
+            super(message);
+        }
+    }
+
+    /** Baidu replied busy or rate-limited; the request may be retried
+     *  after {@link #pauseMs} milliseconds. */
+    private static final class BaiduBusyException extends IOException {
+        private static final long serialVersionUID = 1L;
+
+        final long pauseMs;
+
+        BaiduBusyException(@NonNull final String message, final long pauseMs) {
+            super(message);
+            this.pauseMs = pauseMs;
+        }
+    }
