+        final Request request = useBearer
+                ? baiduBearerRequest(joined, target, appId, secret)
+                : baiduSignedRequest(joined, target, appId, secret);
+        final JSONObject reply = new JSONObject(executeRequest(request));
+        final String errorCode = reply.optString("error_code", "");
+        if (errorCode.isEmpty()) {
+            final JSONArray items = reply.optJSONArray("trans_result");
+            final List<String> parsed = new ArrayList<>();
+            if (items != null) {
+                for (int i = 0; i < items.length(); i++) {
+                    parsed.add(items.getJSONObject(i).optString("dst", ""));
                 }
-                return parsed;
             }
-            final String message = reply.optString("error_msg", errorCode);
-            if ("54003".equals(errorCode) || "59004".equals(errorCode)
-                    || "52001".equals(errorCode) || "52002".equals(errorCode)) {
-                // Rate limit / busy: pause and let the next attempt run.
-                BisubLog.w("baidu error " + errorCode + " (" + message
-                        + ") on attempt " + attempt + ", pausing");
-                if (attempt < 3) {
-                    sleepQuietly(1100 * attempt);
-                    continue;
+            // The LLM model tends to merge the joined lines into one
+            // reply entry; split it back so the line alignment holds.
+            if (parsed.size() == 1 && joined.contains("\n")
+                    && parsed.get(0).contains("\n")) {
+                final String merged = parsed.get(0);
+                parsed.clear();
+                for (final String part : merged.split("\n", -1)) {
+                    parsed.add(part);
                 }
-                throw new IOException("Baidu API is busy (error " + errorCode + ")");
             }
-            if ("54005".equals(errorCode)) {
+            return parsed;
