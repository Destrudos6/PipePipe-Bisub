+                        + "), pausing " + e.pauseMs * attempt + " ms");
+                if (attempt < 3) {
+                    sleepQuietly(e.pauseMs * attempt);
                 }
-                // The LLM model tends to merge the joined lines into one
-                // reply entry; split it back so the line alignment holds.
-                if (parsed.size() == 1 && chunk.size() > 1
-                        && parsed.get(0).contains("\n")) {
-                    final String merged = parsed.get(0);
-                    parsed.clear();
-                    for (final String part : merged.split("\n", -1)) {
-                        parsed.add(part);
-                    }
