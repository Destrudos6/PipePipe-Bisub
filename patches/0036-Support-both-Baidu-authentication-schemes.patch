+     * @return the translations, possibly fewer than requested
+     * @throws IOException   on network errors or after exhausting retries
+     * @throws JSONException when a response cannot be parsed
+     */
+    @NonNull
+    private static List<String> baiduSendWithRetries(@NonNull final String joined,
+                                                     @NonNull final String target,
+                                                     @NonNull final String appId,
+                                                     @NonNull final String secret,
+                                                     final boolean useBearer)
+            throws IOException, JSONException {
+        IOException busy = null;
         for (int attempt = 1; attempt <= 3; attempt++) {
