+    /**
+     * Builds a Baidu request with Bearer token authentication and a JSON
+     * body, the scheme the API recommends for API keys.
+     *
+     * @param joined  the newline-joined text of the request
+     * @param target  the engine target language code
+     * @param appId   the Baidu application id
+     * @param apiKey  the Baidu API key
+     * @return the request to send
+     * @throws JSONException when the payload cannot be built
+     */
+    @NonNull
+    private static Request baiduBearerRequest(@NonNull final String joined,
+                                              @NonNull final String target,
+                                              @NonNull final String appId,
+                                              @NonNull final String apiKey)
+            throws JSONException {
+        final JSONObject payload = new JSONObject();
+        payload.put("appid", appId);
+        payload.put("from", "auto");
+        payload.put("to", target);
+        payload.put("q", joined);
+        return new Request.Builder()
+                .url("https://fanyi-api.baidu.com/ait/api/aiTextTranslate")
+                .header("Authorization", "Bearer " + apiKey)
+                .header("Content-Type", "application/json")
+                .post(RequestBody.create(payload.toString(), JSON))
+                .build();
+    }
+
+    /**
+     * Builds a Baidu request with the classic sign authentication
+     * ({@code MD5(appid + q + salt + secret)}) and a form body.
+     *
+     * @param joined the newline-joined text of the request
+     * @param target the engine target language code
+     * @param appId  the Baidu application id
+     * @param secret the Baidu classic secret key
+     * @return the request to send
+     */
+    @NonNull
+    private static Request baiduSignedRequest(@NonNull final String joined,
+                                              @NonNull final String target,
+                                              @NonNull final String appId,
+                                              @NonNull final String secret) {
+        final String salt = String.valueOf(System.currentTimeMillis());
+        final RequestBody form = new FormBody.Builder()
+                .add("q", joined)
+                .add("from", "auto")
+                .add("to", target)
+                .add("appid", appId)
+                .add("salt", salt)
+                .add("sign", md5Hex(appId + joined + salt + secret))
+                .build();
+        return new Request.Builder()
+                .url("https://fanyi-api.baidu.com/ait/api/aiTextTranslate")
+                .post(form)
+                .build();
     }
 
