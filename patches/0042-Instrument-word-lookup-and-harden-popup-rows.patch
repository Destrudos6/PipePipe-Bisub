+        BisubLog.i("ms-dict lookup '" + word + "': HTTP 200, " + body.length()
+                + " chars in " + (System.currentTimeMillis() - start)
+                + " ms; body: " + body.substring(0, Math.min(300, body.length())));
         final WordEntry entry = new WordEntry(word, null, null, true);
         try {
             final JSONArray reply = new JSONArray(body);
@@ -93,9 +101,12 @@ public final class MicrosoftDictionary {
             final String text = first == null ? null : first.optString("text", "");
