@@ -184,6 +223,80 @@ public class YoutubeBulletCommentsExtractor extends BulletCommentsExtractor {
         return null;
     }
 
+    /**
+     * Scans the beginning of the comment section and turns every comment
+     * that quotes a video position into bullet comments at that position.
+     * A comment quoting several positions becomes one bullet comment per
+     * position. Comments without a timestamp are skipped, so the bullet
+     * comment layer stays sparse and meaningful.
+     *
+     * @throws IOException      when the comments cannot be fetched
+     * @throws ExtractionException when the comments cannot be extracted
+     */
+    private void collectTimestampedComments() throws IOException, ExtractionException {
+        final CommentsExtractor commentsExtractor = getService().getCommentsExtractor(getUrl());
+        if (commentsExtractor == null) {
+            return;
+        }
+        String streamUrl;
+        try {
+            streamUrl = getUrl();
+        } catch (final ParsingException e) {
+            return;
+        }
+        commentsExtractor.fetchPage();
+        InfoItemsPage<CommentsInfoItem> page = commentsExtractor.getInitialPage();
+        int pagesScanned = 0;
+        while (page != null && page.getItems() != null && pagesScanned < MAX_COMMENT_PAGES) {
+            for (final CommentsInfoItem comment : page.getItems()) {
+                commitTimestampedItems(comment, streamUrl);
+            }
+            pagesScanned++;
+            if (page.getNextPage() == null) {
+                break;
+            }
+            page = commentsExtractor.getPage(page.getNextPage());
+        }
+        Collections.sort(commentItems);
+    }
+
+    /**
+     * Parses the timestamps quoted in one comment and appends a bullet
+     * comment item for each of them.
+     *
+     * @param comment the comment to parse
+     * @param streamUrl the url of the video, for the item url field
+     */
+    private void commitTimestampedItems(final CommentsInfoItem comment, final String streamUrl) {
+        final String text = comment.getCommentText() == null
+                ? null : comment.getCommentText().getContent();
+        if (text == null || text.isEmpty()) {
+            return;
+        }
+        final Matcher matcher = COMMENT_TIMESTAMP.matcher(text);
+        while (matcher.find()) {
+            final String[] parts = matcher.group(1).split(":");
+            long seconds;
+            try {
+                if (parts.length == 3) {
+                    seconds = Long.parseLong(parts[0]) * 3600L
+                            + Long.parseLong(parts[1]) * 60L + Long.parseLong(parts[2]);
+                } else {
+                    seconds = Long.parseLong(parts[0]) * 60L + Long.parseLong(parts[1]);
+                }
+            } catch (final NumberFormatException e) {
+                continue;
+            }
+            final BulletCommentsInfoItem item = new BulletCommentsInfoItem(
+                    getServiceId(), streamUrl, "Comment");
+            item.setCommentText(text);
+            item.setAuthorName(comment.getUploaderName());
+            item.setDuration(Duration.ofSeconds(seconds));
+            item.setPosition(BulletCommentsInfoItem.Position.REGULAR);
+            commentItems.add(item);
+        }
+    }
+
     @Override
     public InfoItemsPage<BulletCommentsInfoItem> getPage(Page page) throws IOException, ExtractionException {
         return null;
@@ -191,7 +304,10 @@ public class YoutubeBulletCommentsExtractor extends BulletCommentsExtractor {
 
