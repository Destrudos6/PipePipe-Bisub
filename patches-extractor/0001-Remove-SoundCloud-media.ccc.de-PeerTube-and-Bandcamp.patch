-    // alternatives also match inside the host name (e.g. "kolektiva.media/c/foo" would give
-    // "a/foo" instead of "c/foo", because of the "a" of "media").
-    private static final String ID_URL_PATTERN = "/((accounts|a)|(video-channels|c))/([^/?&#]*)";
