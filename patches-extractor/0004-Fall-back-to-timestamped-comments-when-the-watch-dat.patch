From 378b5667749a0ed60bf362b647a92126ca2313ac Mon Sep 17 00:00:00 2001
From: Destrudos6 <3411622425@qq.com>
Date: Thu, 22 Oct 2026 13:14:13 +0800
Subject: [PATCH 4/4] Fall back to timestamped comments when the watch data
 cache misses

The watch data cache is filled while the stream of a video is being
resolved, which races with the bullet comments initialization:
playing a video directly from the queue constructs the bullet
comments extractor before the cache knows that video, and the
constructor used to throw - the player swallowed the exception and
the bullet comments silently stayed empty. Opening the video on its
detail page first always works, because the cache is filled before
playback starts.

A cache miss now falls back to the timestamped comments (which read
none of the cached fields) instead of throwing, so the bullet
comments also work when playing directly from the queue or from
autoplay.
---
 .../extractors/YoutubeBulletCommentsExtractor.java   | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeBulletCommentsExtractor.java b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeBulletCommentsExtractor.java
index 8b525605..c5836a82 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeBulletCommentsExtractor.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeBulletCommentsExtractor.java
@@ -98,7 +98,17 @@ public class YoutubeBulletCommentsExtractor extends BulletCommentsExtractor {
             startTime = watchDataCache.lastStartAt;
             shoudldBeLive = watchDataCache.lastShouldBeLive;
         } else {
-            throw new ExtractionException("WatchDataCache of current url is not initialized");
+            // The watch data cache is filled while the stream of the video
+            // is being resolved, which races with the bullet comments
+            // initialization: playing directly from the queue constructs
+            // this extractor before the cache knows the video. Fall back
+            // to the timestamped comments instead of throwing, so the
+            // bullet comments still work in that case (the fallback reads
+            // none of the cached fields).
+            isLiveStream = false;
+            startTime = 0;
+            shoudldBeLive = false;
+            commentFallback = true;
         }
     }
 
